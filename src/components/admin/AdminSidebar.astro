---
// AdminSidebar.astro
---

<aside class="w-full md:w-64 flex-shrink-0 bg-surface border border-white/5 rounded-3xl p-6 backdrop-blur-xl flex flex-col gap-6 md:sticky md:top-6 min-h-[calc(100vh-3rem)]">
  <div class="flex items-center gap-3">
    <img src="/EthLimalogo.svg" alt="Ethereum Lima Logo" class="h-8" />
    <div>
      <h2 class="text-lg font-extrabold text-white leading-tight">Admin Portal</h2>
      <p class="text-[9px] text-muted font-mono uppercase tracking-widest mt-1">Eth Lima</p>
    </div>
  </div>

  <nav class="flex flex-col gap-2 flex-1 mt-4">
    <button class="nav-btn active flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 text-white text-sm font-bold transition-all text-left border border-white/10" data-target="section-inicio">
      🏠 Inicio
    </button>
    <button class="nav-btn flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-muted hover:text-white text-sm font-bold transition-all text-left" data-target="pending-section">
      <span class="relative">
        📌 Issues
        <span id="sidebar-pending-badge" class="absolute -top-1 -right-3 w-2 h-2 rounded-full bg-yellow-400 animate-pulse hidden"></span>
      </span>
    </button>
    <button class="nav-btn flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-muted hover:text-white text-sm font-bold transition-all text-left" data-target="events-section">
      📅 Eventos
    </button>
    <button class="nav-btn flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-muted hover:text-white text-sm font-bold transition-all text-left" data-target="members-section">
      👥 Miembros
    </button>
  </nav>

  <div class="mt-auto pt-6 border-t border-white/5 flex flex-col gap-3">
    <button
      id="btn-logout"
      class="w-full px-5 py-2.5 bg-danger/10 border border-danger/25 hover:bg-danger/20 text-danger font-mono text-xs font-bold rounded-xl transition-all"
    >
      🚪 CERRAR SESIÓN
    </button>
  </div>
</aside>
