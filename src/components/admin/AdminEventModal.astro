---
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import { CalendarDays, MapPin, Building, Link as LinkIcon, Tag, Image as ImageIcon, Hash, Clock } from 'lucide-astro';
---

<div
  id="crud-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-[#030407]/90 backdrop-blur-md animate-modal-fade"
>
  <div
    class="w-full max-w-2xl bg-surface border border-white/5 rounded-3xl p-6 md:p-8 relative shadow-2xl overflow-y-auto max-h-[90vh] no-scrollbar"
  >
    <h2 id="modal-title" class="text-xl font-extrabold text-content-primary mb-6">
      Editar Evento
    </h2>

    <form id="crud-form" class="space-y-5">
      <input type="hidden" id="event-id" />

      <Input id="form-title" label="Título" required={true} />

      <div class="space-y-1.5">
        <label
          for="form-desc"
          class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
        >
          Descripción <span class="text-danger">*</span>
        </label>
        <textarea
          id="form-desc"
          required
          rows="3"
          class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-content-primary focus:border-accent outline-none min-h-[80px] resize-y transition-all"
        ></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input type="date" id="form-date" label="Fecha Inicio" required={true}>
          <CalendarDays slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
        <Input type="date" id="form-end-date" label="Fecha Fin">
          <CalendarDays slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input type="text" id="form-time" label="Hora" placeholder="Ej: 19:00">
          <Clock slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
        <div class="space-y-1.5">
          <label
            for="form-type"
            class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
          >
            Categoría <span class="text-danger">*</span>
          </label>
          <select
            id="form-type"
            required
            class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-content-primary focus:border-accent outline-none transition-all"
          >
            <option value="meetup">Meetup</option>
            <option value="conference">Conference</option>
            <option value="workshop">Workshop</option>
            <option value="hackathon">Hackathon</option>
            <option value="bootcamp">Bootcamp</option>
            <option value="cohorte">Cohorte</option>
            <option value="buildathon">Buildathon</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input type="text" id="form-location" label="Ubicación" required={true}>
          <MapPin slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
        <Input type="text" id="form-organizer" label="Organizador" required={true}>
          <Building slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input type="url" id="form-link" label="Link de registro">
          <LinkIcon slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
        <Input type="text" id="form-tags" label="Tags" placeholder="ethereum, solidity">
          <Tag slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input type="number" id="form-parent-id" label="Evento Padre ID (Subevento)" placeholder="Ej: 38">
          <Hash slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
        <Input type="url" id="form-image" label="URL Imagen" placeholder="https://...">
          <ImageIcon slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
      </div>

      <div class="flex justify-end gap-3 pt-6 border-t border-white/5">
        <Button id="btn-close-modal" variant="ghost">CANCELAR</Button>
        <Button type="submit" variant="primary">GUARDAR EVENTO</Button>
      </div>
    </form>
  </div>
</div>
