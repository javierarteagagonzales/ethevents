---
// AdminIssues.astro
---

<div
  id="pending-section"
  class="dashboard-section hidden bg-surface border border-yellow-500/20 rounded-3xl p-6 md:p-8 backdrop-blur-xl flex flex-col gap-4"
>
  <div class="flex items-center gap-3">
    <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 animate-pulse"
    ></span>
    <h2
      class="text-base font-extrabold text-white font-mono tracking-tight"
    >
      Issues Pendientes de Aprobación
    </h2>
    <span
      id="pending-count"
      class="ml-auto px-2.5 py-0.5 rounded-full bg-yellow-400/10 border border-yellow-400/25 text-yellow-400 font-mono text-[10px] font-bold"
      >0</span
    >
  </div>
  <p class="text-xs text-muted font-mono">
    // Estos son los issues abiertos en GitHub que aún no han sido
    aprobados o rechazados.
  </p>

  <div
    class="overflow-x-auto rounded-2xl border border-yellow-500/10 bg-black/20"
  >
    <table class="w-full border-collapse text-left text-xs text-muted">
      <thead
        class="bg-surface-2 font-mono text-[10px] tracking-wider uppercase text-muted font-bold border-b border-white/5"
      >
        <tr>
          <th class="p-4">#</th>
          <th class="p-4">Título</th>
          <th class="p-4">Descripción</th>
          <th class="p-4">Fecha Issue</th>
          <th class="p-4 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody id="pending-table-body" class="divide-y divide-white/5">
        <tr
          ><td colspan="5" class="p-8 text-center text-muted font-mono"
            >// Cargando issues pendientes...</td
          >
        </tr>
      </tbody>
    </table>
  </div>
</div>
