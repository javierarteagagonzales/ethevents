---
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import { User, Image as ImageIcon, Twitter, Instagram, Linkedin } from 'lucide-astro';
---

<div
  id="member-crud-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-[#030407]/90 backdrop-blur-md animate-modal-fade"
>
  <div
    class="w-full max-w-2xl bg-surface border border-white/5 rounded-3xl p-6 md:p-8 relative shadow-2xl overflow-y-auto max-h-[90vh] no-scrollbar"
  >
    <h2
      id="member-modal-title"
      class="text-xl font-extrabold text-content-primary mb-6"
    >
      Editar Miembro
    </h2>

    <form id="member-crud-form" class="space-y-5">
      <input type="hidden" id="member-id" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input type="text" id="member-name" label="Nombre" required={true}>
          <User slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
        <Input type="url" id="member-photo" label="Foto (URL)">
          <ImageIcon slot="icon-left" class="w-4 h-4 absolute left-4 top-3.5 text-muted/50" />
        </Input>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label
            class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
          >
            Rol General <span class="text-danger">*</span>
          </label>
          <select
            id="member-role"
            required
            class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-content-primary focus:border-accent outline-none transition-all"
          >
            <option value="Lead General Eth Lima">Lead General Eth Lima</option>
            <option value="Core Team">Core Team</option>
            <option value="Lead de Educación y tecnología">Lead de Educación y tecnología</option>
            <option value="Lead de Logística">Lead de Logística</option>
            <option value="Lead de Alianzas">Lead de Alianzas</option>
            <option value="Lead de Comunicaciones">Lead de Comunicaciones</option>
            <option value="Lead de Área Proyectos">Lead de Área Proyectos</option>
            <option value="Lead del Proyecto">Lead del Proyecto</option>
            <option value="Voluntario">Voluntario</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <label
            class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
          >
            Área <span class="text-danger">*</span>
          </label>
          <select
            id="member-area"
            required
            class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-content-primary focus:border-accent outline-none transition-all"
          >
            <option value="Tecnología">Tecnología</option>
            <option value="Logística">Logística</option>
            <option value="Proyectos">Proyectos</option>
            <option value="Comunicaciones">Comunicaciones</option>
            <option value="General">General</option>
          </select>
        </div>
      </div>

      <div class="space-y-1.5">
        <label
          class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
        >
          Redes Sociales
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="relative">
            <Twitter class="w-4 h-4 absolute left-3 top-3.5 text-muted/50" />
            <input
              type="text"
              id="member-x"
              placeholder="X (Twitter) URL"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 pl-9 text-xs text-content-primary focus:border-accent outline-none transition-all"
            />
          </div>
          <div class="relative">
            <Instagram class="w-4 h-4 absolute left-3 top-3.5 text-muted/50" />
            <input
              type="text"
              id="member-instagram"
              placeholder="Instagram URL"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 pl-9 text-xs text-content-primary focus:border-accent outline-none transition-all"
            />
          </div>
          <div class="relative">
            <Linkedin class="w-4 h-4 absolute left-3 top-3.5 text-muted/50" />
            <input
              type="text"
              id="member-linkedin"
              placeholder="LinkedIn URL"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 pl-9 text-xs text-content-primary focus:border-accent outline-none transition-all"
            />
          </div>
        </div>
      </div>

      <div class="space-y-1.5">
        <label
          class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
        >
          Eventos Asignados y Rol
        </label>
        <div
          id="member-events-container"
          class="flex flex-col gap-2 max-h-48 overflow-y-auto p-3 bg-black/20 border border-white/5 rounded-xl shadow-glass"
        >
          <!-- Checkboxes generados por JS -->
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-6 border-t border-white/5">
        <Button id="btn-close-member-modal" variant="ghost">CANCELAR</Button>
        <Button type="submit" variant="primary">GUARDAR MIEMBRO</Button>
      </div>
    </form>
  </div>
</div>
