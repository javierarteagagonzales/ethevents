---
// src/components/ui/Input.astro
interface Props {
  type?: 'text' | 'email' | 'password' | 'number' | 'url' | 'date' | 'time';
  id: string;
  name?: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  class?: string;
  value?: string;
}

const { 
  type = 'text', 
  id, 
  name = id, 
  label, 
  placeholder, 
  required = false, 
  class: className = '',
  value
} = Astro.props;
---

<div class={`space-y-1.5 ${className}`}>
  <label
    for={id}
    class="block font-mono text-[10px] text-content-secondary tracking-wider uppercase font-bold ml-1"
  >
    {label} {required && <span class="text-danger">*</span>}
  </label>
  <div class="relative">
    <slot name="icon-left" />
    <input
      type={type}
      id={id}
      name={name}
      required={required}
      placeholder={placeholder}
      value={value}
      class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-content-primary placeholder-muted/30 focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all disabled:opacity-50 disabled:cursor-not-allowed"
    />
    <slot name="icon-right" />
  </div>
</div>
