---
interface Props {
  showViewToggle?: boolean;
}

const { showViewToggle = false } = Astro.props;
---

<!-- FLOATING NAV -->
<nav id="main-nav" class="flex items-center justify-between px-5 sm:px-6">

  <!-- Logo -->
  <a class="flex items-center gap-2.5 group relative z-50 shrink-0" href="/">
    <div class="relative">
      <div class="absolute inset-0 blur-lg bg-accent/30 rounded-full scale-150 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      <img src="/EthLimalogo.svg" alt="Ethereum Lima Logo" class="h-7 w-auto block relative z-10 group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
    </div>
    <span class="font-mono text-[10px] font-bold text-muted tracking-[0.2em] group-hover:text-accent transition-colors hidden sm:block">ETH EVENTS</span>
  </a>

  <!-- Desktop Navigation -->
  <ul class="hidden md:flex items-center gap-1 list-none">
    <li>
      <a href="/#events" class="nav-link font-mono text-[11px] text-muted hover:text-white tracking-[0.12em] transition-colors px-3 py-1.5 rounded-lg hover:bg-white/5" data-i18n="nav_events">
        EVENTOS
      </a>
    </li>
    <li>
      <a href="/proyectos" class="nav-link font-mono text-[11px] text-muted hover:text-white tracking-[0.12em] transition-colors px-3 py-1.5 rounded-lg hover:bg-white/5" data-i18n="nav_projects">
        PROYECTOS
      </a>
    </li>
    {showViewToggle && (
      <li id="view-toggle-nav">
        <div class="flex bg-surface border border-border rounded-xl p-1 ml-2">
          <button class="toggle-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-mono text-[10px] text-muted active transition-all active:bg-accent active:text-white" id="btn-list">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
              <rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
            </svg>
            GRID
          </button>
          <button class="toggle-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-mono text-[10px] text-muted transition-all" id="btn-calendar">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            CALENDAR
          </button>
        </div>
      </li>
    )}
  </ul>

  <!-- Desktop Right Actions -->
  <div class="hidden md:flex items-center gap-2">
    <!-- CTA Button with shimmer -->
    <a class="btn-glow btn-magnetic font-mono text-[11px] px-5 py-2 bg-accent/10 border border-accent/30 text-accent hover:bg-accent hover:text-white hover:border-accent rounded-xl transition-all tracking-[0.08em] relative overflow-hidden group" href="/submit" data-i18n="nav_new">
      <span class="relative z-10 flex items-center gap-1.5">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        NUEVO EVENTO
      </span>
    </a>
    <!-- Language Toggle -->
    <div class="flex gap-0.5 p-1 bg-surface border border-border rounded-xl">
      <button class="lang-btn font-mono text-[10px] px-2.5 py-1.5 rounded-lg text-muted font-bold transition-all hover:bg-white/5 active:bg-accent active:text-white" id="lang-es">ES</button>
      <button class="lang-btn font-mono text-[10px] px-2.5 py-1.5 rounded-lg text-muted font-bold transition-all hover:bg-white/5" id="lang-en">EN</button>
    </div>
  </div>

  <!-- Mobile Hamburger -->
  <button id="mobile-menu-btn" class="md:hidden relative z-50 w-9 h-9 flex flex-col items-center justify-center gap-[5px] rounded-xl bg-surface border border-border hover:border-accent/40 transition-all group" aria-label="Menú">
    <span class="hamburger-line w-4.5 h-[1.5px] bg-muted group-hover:bg-accent rounded-full transition-all duration-300 origin-center"></span>
    <span class="hamburger-line w-4.5 h-[1.5px] bg-muted group-hover:bg-accent rounded-full transition-all duration-300 origin-center"></span>
    <span class="hamburger-line w-3 h-[1.5px] bg-muted group-hover:bg-accent rounded-full transition-all duration-300 origin-center self-start ml-[6px]"></span>
  </button>
</nav>

<!-- Mobile Full-Screen Overlay Menu -->
<div id="mobile-menu" class="mobile-menu-overlay fixed inset-0 z-[998] hidden">
  <!-- Animated backdrop -->
  <div class="absolute inset-0 bg-[#020308]/97 backdrop-blur-2xl"></div>
  
  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(98,126,234,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(98,126,234,0.06) 1px, transparent 1px); background-size: 60px 60px;"></div>
  
  <!-- Animated glow orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[500px] h-[400px] bg-accent/8 rounded-full blur-[150px] pointer-events-none animate-pulse-slow"></div>
  <div class="absolute bottom-1/4 right-0 w-[300px] h-[300px] bg-accent-2/6 rounded-full blur-[120px] pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center justify-center h-full px-6">
    <!-- Logo -->
    <div class="absolute top-5 left-4 sm:left-6 flex items-center gap-2">
      <img src="/EthLimalogo.svg" alt="ETH Events" class="h-7 w-auto opacity-40" loading="lazy" decoding="async" />
      <span class="font-mono text-[9px] text-muted/40 tracking-[0.25em]">ETH EVENTS</span>
    </div>

    <!-- Nav links -->
    <ul class="flex flex-col items-center gap-3 list-none w-full max-w-sm">
      <li class="mobile-menu-item w-full opacity-0 translate-y-6">
        <a href="/#events" class="mobile-nav-link group flex items-center gap-4 w-full px-5 py-4 rounded-2xl border border-white/5 hover:border-accent/30 hover:bg-accent/5 transition-all duration-300" data-i18n="nav_events">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 text-accent group-hover:bg-accent group-hover:text-white transition-all duration-300 shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </span>
          <div class="flex-1">
            <span class="block font-mono text-sm font-bold text-white tracking-wider">EVENTOS</span>
            <span class="block font-mono text-[10px] text-muted mt-0.5">// Calendario de actividades</span>
          </div>
          <svg class="w-4 h-4 text-muted/40 group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </li>

      <li class="mobile-menu-item w-full opacity-0 translate-y-6">
        <a href="/proyectos" class="mobile-nav-link group flex items-center gap-4 w-full px-5 py-4 rounded-2xl border border-white/5 hover:border-accent/30 hover:bg-accent/5 transition-all duration-300">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 text-accent group-hover:bg-accent group-hover:text-white transition-all duration-300 shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </span>
          <div class="flex-1">
            <span class="block font-mono text-sm font-bold text-white tracking-wider" data-i18n="nav_projects">PROYECTOS</span>
            <span class="block font-mono text-[10px] text-muted mt-0.5" data-i18n="nav_projects_sub">// Nuestras iniciativas</span>
          </div>
          <svg class="w-4 h-4 text-muted/40 group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </li>

      <!-- Divider -->
      <li class="w-full px-4 my-1">
        <div class="h-px bg-gradient-to-r from-transparent via-white/8 to-transparent"></div>
      </li>

      <!-- CTA: New Event -->
      <li class="mobile-menu-item w-full opacity-0 translate-y-6">
        <a href="/submit" class="mobile-nav-link btn-glow group flex items-center gap-4 w-full px-5 py-4 rounded-2xl bg-accent/8 border border-accent/20 hover:bg-accent/15 hover:border-accent/40 transition-all duration-300" data-i18n="nav_new">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent border border-accent/50 text-white shadow-[0_0_20px_rgba(98,126,234,0.4)] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
          <div class="flex-1">
            <span class="block font-mono text-sm font-bold text-accent-2 tracking-wider">NUEVO EVENTO</span>
            <span class="block font-mono text-[10px] text-muted mt-0.5">// Propón una actividad</span>
          </div>
          <svg class="w-4 h-4 text-accent/40 group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </li>
    </ul>

    <!-- Language Selector -->
    <div class="mobile-menu-item opacity-0 translate-y-6 mt-8 flex items-center gap-3">
      <span class="font-mono text-[9px] text-muted tracking-[0.25em] uppercase">Idioma</span>
      <div class="flex gap-0.5 p-1 bg-surface border border-border rounded-xl">
        <button class="lang-btn-mobile font-mono text-[11px] px-3 py-1.5 rounded-lg text-muted font-bold transition-all hover:bg-white/5" id="lang-es-mobile" data-lang="es">ES</button>
        <button class="lang-btn-mobile font-mono text-[11px] px-3 py-1.5 rounded-lg text-muted font-bold transition-all hover:bg-white/5" id="lang-en-mobile" data-lang="en">EN</button>
      </div>
    </div>

    <!-- Bottom decoration -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2.5 opacity-20">
      <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
      <span class="font-mono text-[9px] text-muted tracking-[0.35em]">ETHEREUM LIMA</span>
      <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" style="animation-delay: 0.5s"></div>
    </div>
  </div>
</div>

<style>
  /* Nav width tweak for h-3 on small spans */
  .w-4\.5 { width: 1.125rem; }

  .toggle-btn.active {
    background-color: var(--accent);
    color: #fff;
  }
  .lang-btn.active,
  .lang-btn-mobile.active {
    background-color: var(--accent);
    color: #fff;
  }

  /* Hamburger animation */
  .menu-open .hamburger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
    background-color: var(--accent) !important;
  }
  .menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-open .hamburger-line:nth-child(3) {
    width: 1.125rem;
    transform: translateY(-6.5px) rotate(-45deg);
    margin-left: 0 !important;
    background-color: var(--accent) !important;
  }

  /* Mobile menu items stagger */
  .mobile-menu-item.animate-in {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-menu-item:nth-child(1) { transition-delay: 0.04s; }
  .mobile-menu-item:nth-child(2) { transition-delay: 0.1s; }
  .mobile-menu-item:nth-child(3) { transition-delay: 0.16s; }
  .mobile-menu-item:nth-child(4) { transition-delay: 0.22s; }
  .mobile-menu-item:nth-child(5) { transition-delay: 0.28s; }
  .mobile-menu-item:nth-child(6) { transition-delay: 0.34s; }

  /* Mobile menu scanline texture */
  .mobile-menu-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(98, 126, 234, 0.012) 3px,
      rgba(98, 126, 234, 0.012) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  @keyframes animate-pulse-slow {
    0%, 100% { opacity: 0.4; transform: translate(-50%, 0) scale(1); }
    50%       { opacity: 0.7; transform: translate(-50%, -20px) scale(1.05); }
  }
  .animate-pulse-slow {
    animation: animate-pulse-slow 6s ease-in-out infinite;
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuItems = document.querySelectorAll('.mobile-menu-item');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  let isMenuOpen = false;

  function openMenu() {
    isMenuOpen = true;
    menuBtn?.classList.add('menu-open');
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      menuItems.forEach(item => item.classList.add('animate-in'));
    });
  }

  function closeMenu() {
    isMenuOpen = false;
    menuBtn?.classList.remove('menu-open');
    menuItems.forEach(item => item.classList.remove('animate-in'));
    setTimeout(() => {
      mobileMenu?.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  menuBtn?.addEventListener('click', () => isMenuOpen ? closeMenu() : openMenu());
  mobileNavLinks.forEach(link => link.addEventListener('click', () => closeMenu()));

  // Sync mobile lang buttons
  const langEsMobile = document.getElementById('lang-es-mobile');
  const langEnMobile = document.getElementById('lang-en-mobile');
  const langEs = document.getElementById('lang-es');
  const langEn = document.getElementById('lang-en');

  langEsMobile?.addEventListener('click', () => {
    langEs?.click();
    langEsMobile.classList.add('active');
    langEnMobile?.classList.remove('active');
  });
  langEnMobile?.addEventListener('click', () => {
    langEn?.click();
    langEnMobile.classList.add('active');
    langEsMobile?.classList.remove('active');
  });

  if (langEs?.classList.contains('active')) langEsMobile?.classList.add('active');
  else if (langEn?.classList.contains('active')) langEnMobile?.classList.add('active');

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) closeMenu();
  });

  // ── Scroll-aware nav shrink ──
  const nav = document.getElementById('main-nav');
  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 40) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
    lastScrollY = y;
  }, { passive: true });

  // ── Magnetic button effect ──
  document.querySelectorAll('.btn-magnetic').forEach(btn => {
    btn.addEventListener('mousemove', (e: Event) => {
      const ev = e as MouseEvent;
      const rect = (btn as HTMLElement).getBoundingClientRect();
      const x = ev.clientX - rect.left - rect.width / 2;
      const y = ev.clientY - rect.top - rect.height / 2;
      (btn as HTMLElement).style.transform = `translate(${x * 0.2}px, ${y * 0.3}px)`;
    });
    btn.addEventListener('mouseleave', () => {
      (btn as HTMLElement).style.transform = '';
    });
  });
</script>
