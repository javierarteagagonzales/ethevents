---
interface Props {
  showViewToggle?: boolean;
}

const { showViewToggle = false } = Astro.props;
---

<nav class="sticky top-0 z-50 flex items-center justify-between px-6 md:px-10 h-16 bg-[#0a0b0f]/85 backdrop-blur-md border-b border-white/10">
  <a class="flex items-center gap-2.5 hover:opacity-90 transition-opacity" href="/">
    <img src="/EthLimalogo.svg" alt="Ethereum Lima Logo" class="h-8 w-auto block" />
  </a>

  <ul class="flex items-center gap-8 list-none">
    <li>
      <a href="/#events" class="font-mono text-xs text-muted hover:text-white tracking-[0.1em] transition-colors" data-i18n="nav_events">
        EVENTOS
      </a>
    </li>
    <li>
      <a href="/#how" class="font-mono text-xs text-muted hover:text-white tracking-[0.1em] transition-colors" data-i18n="nav_how">
        CÓMO FUNCIONA
      </a>
    </li>
    <li>
      <a href="/proyectos" class="font-mono text-xs text-muted hover:text-white tracking-[0.1em] transition-colors">
        PROYECTOS
      </a>
    </li>
    {showViewToggle && (
      <li id="view-toggle-nav" class="hidden md:block">
        <div class="flex bg-surface border border-border rounded-lg p-1">
          <button class="toggle-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md font-mono text-[11px] text-muted active transition-all active:bg-accent active:text-white" id="btn-list">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" />
              <rect x="14" y="3" width="7" height="7" />
              <rect x="14" y="14" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" />
            </svg>
            GRID
          </button>
          <button class="toggle-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md font-mono text-[11px] text-muted transition-all" id="btn-calendar">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            CALENDAR
          </button>
        </div>
      </li>
    )}
  </ul>

  <div class="flex items-center gap-3">
    <a class="hidden sm:inline-block font-mono text-xs px-5 py-2 border border-accent text-accent hover:bg-accent hover:text-white rounded transition-all tracking-[0.08em]" href="/submit" data-i18n="nav_new">
      + NUEVO EVENTO
    </a>
    <div class="flex gap-1 p-1 bg-surface border border-border rounded-md">
      <button class="lang-btn font-mono text-[10px] px-2 py-1 rounded text-muted font-bold transition-all hover:bg-white/5 active:bg-accent active:text-white" id="lang-es">
        ES
      </button>
      <button class="lang-btn font-mono text-[10px] px-2 py-1 rounded text-muted font-bold transition-all hover:bg-white/5" id="lang-en">
        EN
      </button>
    </div>
  </div>
</nav>

<style>
  .toggle-btn.active {
    background-color: var(--accent);
    color: #fff;
  }
  .lang-btn.active {
    background-color: var(--accent);
    color: #fff;
  }
</style>
