---
---

<div
  class="modal-overlay fixed inset-0 bg-black/85 backdrop-blur-md z-[1000] hidden items-center justify-center p-6"
  id="modal-overlay"
>
  <div
    class="modal-content bg-bg border border-white/10 rounded-[24px] max-w-[650px] w-full relative shadow-[0_40px_100px_rgba(0,0,0,0.8),0_0_50px_rgba(98,126,234,0.1)] max-h-[90vh] overflow-y-auto animate-modal-fade"
    id="modal-content"
  >
    <button
      class="modal-close absolute top-6 right-6 w-8 h-8 bg-surface border border-white/5 rounded-full text-muted flex items-center justify-center hover:bg-accent/15 hover:text-white transition-all z-10"
      id="btn-close-modal"
    >
      <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    <div id="modal-data" class="p-10">
      <!-- Dynamic Content Loaded via JavaScript -->
    </div>
  </div>
</div>

<script>
  // Add listeners to close modal
  const overlay = document.getElementById('modal-overlay');
  const closeBtn = document.getElementById('btn-close-modal');
  const content = document.getElementById('modal-content');

  function closeModal() {
    if (overlay) {
      overlay.style.display = 'none';
      document.body.style.overflow = 'auto';
    }
  }

  if (overlay) {
    overlay.addEventListener('click', closeModal);
  }
  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeModal();
    });
  }
  if (content) {
    content.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  }
</script>
