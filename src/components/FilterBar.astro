---
const categories = [
  { id: 'all', label: 'TODOS', i18n: 'filter_all' },
  { id: 'meetup', label: 'MEETUP', i18n: 'type_meetup' },
  { id: 'conference', label: 'CONFERENCE', i18n: 'type_conference' },
  { id: 'workshop', label: 'WORKSHOP', i18n: 'type_workshop' },
  { id: 'hackathon', label: 'HACKATHON', i18n: 'type_hackathon' },
  { id: 'bootcamp', label: 'BOOTCAMP', i18n: 'type_bootcamp' },
  { id: 'buildathon', label: 'BUILDATHON', i18n: 'type_buildathon' },
  { id: 'cohorte', label: 'COHORTE', i18n: 'type_cohorte' },
];
---

<div class="filter-bar flex flex-col xl:flex-row items-start xl:items-center justify-between gap-4 py-4 w-full" id="filter-bar">
  <div class="filter-categories flex gap-2 flex-wrap items-center justify-start flex-1">
    {categories.map((cat, idx) => (
      <button
        class={`filter-btn font-mono text-[11px] px-4 py-2 border border-white/10 rounded-full text-muted tracking-wider hover:border-accent hover:text-accent hover:bg-accent/10 transition-all ${idx === 0 ? 'active border-accent text-accent bg-accent/15' : ''}`}
        data-filter={cat.id}
        data-i18n={cat.i18n}
      >
        {cat.label}
      </button>
    ))}
  </div>
  
  <div class="flex flex-wrap items-center gap-3 w-full xl:w-auto">
    <!-- Presencial/Virtual Toggle -->
    <div class="flex items-center bg-white/5 border border-white/10 rounded-full p-1 shrink-0">
      <button class="modality-btn active font-mono text-[10px] px-3 py-1.5 rounded-full transition-all text-accent bg-accent/20 font-bold" data-modality="all">
        AMBOS
      </button>
      <button class="modality-btn font-mono text-[10px] px-3 py-1.5 rounded-full transition-all text-muted hover:text-white" data-modality="presencial">
        PRESENCIAL
      </button>
      <button class="modality-btn font-mono text-[10px] px-3 py-1.5 rounded-full transition-all text-muted hover:text-white" data-modality="virtual">
        VIRTUAL
      </button>
    </div>

    <!-- Search Input -->
    <div class="relative w-full sm:w-56 shrink-0">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="public-search" 
        placeholder="Buscar eventos..." 
        class="w-full bg-white/5 border border-white/10 rounded-full py-2 pl-9 pr-4 text-xs text-white font-sans focus:outline-none focus:border-accent/50 focus:bg-white/10 transition-all placeholder:text-muted"
      />
    </div>
  </div>
</div>

<style>
  .filter-btn.active {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-glow);
  }
  .modality-btn.active {
    color: var(--accent);
    background-color: rgba(98, 126, 234, 0.2);
    font-weight: bold;
  }
</style>
