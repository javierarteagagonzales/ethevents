---
import type { EventItem } from '../types/event';

interface Props {
  event: EventItem;
  isPast?: boolean;
  isFeatured?: boolean;
  descLimit?: number;
  showImage?: boolean;
  class?: string;
}

const {
  event,
  isPast = false,
  isFeatured = false,
  descLimit = 100,
  showImage = false,
  class: className = ''
} = Astro.props;

const typeClasses: Record<string, string> = {
  conference: 'bg-accent/10 text-accent border border-accent/25 shadow-[0_0_12px_rgba(98,126,234,0.15)]',
  workshop: 'bg-success/10 text-success border border-success/25 shadow-[0_0_12px_rgba(16,185,129,0.15)]',
  hackathon: 'bg-warning/10 text-warning border border-warning/25 shadow-[0_0_12px_rgba(245,158,11,0.15)]',
  meetup: 'bg-purple-500/10 text-purple-400 border border-purple-500/25 shadow-[0_0_12px_rgba(168,85,247,0.15)]',
  bootcamp: 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/25 shadow-[0_0_12px_rgba(99,102,241,0.15)]',
  cohorte: 'bg-pink-500/10 text-pink-400 border border-pink-500/25 shadow-[0_0_12px_rgba(236,72,153,0.15)]',
  buildathon: 'bg-teal-500/10 text-teal-400 border border-teal-500/25 shadow-[0_0_12px_rgba(20,184,166,0.15)]',
  grant: 'bg-yellow-500/10 text-yellow-400 border border-yellow-500/25 shadow-[0_0_12px_rgba(234,179,8,0.15)]',
};

const typeClass = typeClasses[event.type.toLowerCase()] || 'bg-purple-500/10 text-purple-400 border border-purple-500/25';

const isEthLima = event.tags.some(t => t.toLowerCase() === 'ethlima');

// Format description
const description = event.description || '';
const shortDesc = description.length > descLimit
  ? description.substring(0, descLimit) + '...'
  : description;

// Determine tags
const tags = event.tags.slice(0, 3);

// Generative gradient fallback for cards without images
const gradientColors = [
  ['#627eea', '#a78bfa'],
  ['#10b981', '#34d399'],
  ['#f59e0b', '#fbbf24'],
  ['#ec4899', '#f472b6'],
  ['#8b5cf6', '#c084fc'],
  ['#2dd4bf', '#5eead4'],
  ['#6366f1', '#818cf8'],
];
const hashCode = event.title.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
const gradientPair = gradientColors[hashCode % gradientColors.length];
const fallbackGradient = `linear-gradient(135deg, ${gradientPair[0]}22 0%, ${gradientPair[1]}11 100%)`;
const hasImage = showImage && event.image;
---

<div
  class={`event-card group flex flex-col h-full overflow-hidden rounded-[22px] border border-white/6 bg-gradient-to-b from-white/[0.05] to-transparent backdrop-blur-xl transition-all duration-500 hover:-translate-y-2.5 hover:border-accent/35 hover:shadow-[0_30px_70px_rgba(0,0,0,0.65),0_0_50px_rgba(98,126,234,0.12),0_0_0_1px_rgba(98,126,234,0.1)] relative cursor-pointer w-full ${isPast ? 'opacity-45 grayscale border-transparent bg-white/[0.01] hover:opacity-100 hover:grayscale-0 hover:border-white/10' : ''} ${isFeatured ? 'ring-1 ring-accent/20 shadow-[0_0_30px_rgba(98,126,234,0.1)]' : ''} ${isEthLima ? 'border-accent/20' : ''} ${className}`}
  data-event-id={event.id}
  data-event-type={event.type}
  data-event-past={isPast ? 'true' : 'false'}
  data-event-ethlima={isEthLima ? 'true' : 'false'}
  data-event-date={event.date}
  data-event-tags={event.tags.join(',')}
  data-event-title={event.title}
  data-event-description={event.description}
  data-event-end-date={event.endDate}
  data-event-time={event.time}
  data-event-location={event.location}
  data-event-link={event.link}
  data-event-video-link={event.videoLink || ''}
  data-event-organizer={event.organizer}
  data-event-issue-num={event.issueNum}
  data-event-parent-id={event.parentId}
  data-event-subevent={event.parentId ? 'true' : 'false'}
>
  {hasImage ? (
    <div class="relative w-full h-48 sm:h-56 md:h-auto md:aspect-video overflow-hidden bg-surface-2/80">
      <img
        src={event.image}
        alt={event.title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-80" />
      <!-- Shimmer overlay on hover -->
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000" />
    </div>
  ) : showImage && (
    <div class="relative w-full h-48 sm:h-56 md:h-auto md:aspect-video overflow-hidden" style={`background: ${fallbackGradient}`}>
      <!-- Generative gradient pattern -->
      <div class="absolute inset-0 flex items-center justify-center">
        <svg class="w-12 h-12 text-white/10" viewBox="0 0 32 32" fill="none">
          <polygon points="16,2 28,9 28,23 16,30 4,23 4,9" stroke="currentColor" stroke-width="1" fill="none" />
          <circle cx="16" cy="16" r="4" fill="currentColor" />
        </svg>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-90" />
    </div>
  )}

  <div class="p-5 flex-1 flex flex-col">
    <div class="flex items-start sm:items-center justify-between gap-4 mb-4 w-full min-w-0">
      <div class="flex items-center gap-2 flex-wrap min-w-0 flex-1">
        <span class={`font-mono text-[10px] tracking-wider font-bold uppercase px-2.5 py-1 rounded-full transition-all duration-300 ${typeClass}`}>
          {event.type}
        </span>
        {isEthLima && (
          <span class="font-mono text-[10px] tracking-widest font-bold uppercase px-2.5 py-1 rounded-full bg-accent/15 text-accent-2 border border-accent/30 shadow-[0_0_14px_rgba(98,126,234,0.2)] shrink-0">
            ◆ ETH Lima
          </span>
        )}
        {isPast && event.videoLink && (
          <span class="font-mono text-[10px] tracking-widest font-bold uppercase px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 border border-red-500/30 flex items-center gap-1 shrink-0" title="Grabación / Material disponible">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            REC
          </span>
        )}
      </div>
      <span class="font-mono text-[10px] text-muted/50 group-hover:text-muted transition-colors">#{ event.issueNum}</span>
    </div>

    <div class="flex-1 flex flex-col min-w-0">
      <h3 class="font-sans font-bold text-lg text-white/90 mb-2 leading-snug group-hover:text-white transition-colors duration-300 break-words">
        {event.title}
      </h3>
      <p class="font-sans text-sm text-muted/80 leading-relaxed flex-1 mb-4 break-words">
        {shortDesc}
      </p>

      <div class="flex items-center gap-2 text-xs text-muted font-mono mt-auto pt-3.5 border-t border-white/5">
        <svg class="w-3.5 h-3.5 text-accent/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class="event-date-display text-muted/70" data-date={event.date} data-end-date={event.endDate} data-time={event.time}>
          {event.date}
        </span>
      </div>
    </div>
  </div>

  <div class="px-5 pb-5 pt-2 flex items-center justify-between gap-4">
    <div class="flex items-center gap-1 flex-wrap">
      {tags.map(tag => (
        <span class="tag-hover text-[10px] text-muted/60 font-mono bg-white/4 border border-white/5 px-2 py-0.5 rounded-md">
          #{tag}
        </span>
      ))}
    </div>
    <span class="text-[11px] font-mono font-bold text-accent/70 group-hover:text-accent-2 tracking-widest flex items-center gap-1 transition-all duration-300 whitespace-nowrap card-action-text group-hover:gap-2" data-reserve={isFeatured ? 'true' : 'false'}>
      {isFeatured ? 'RESERVAR' : 'VER MÁS'}
      <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </span>
  </div>
</div>
