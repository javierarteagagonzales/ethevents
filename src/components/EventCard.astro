---
import type { EventItem } from '../types/event';

interface Props {
  event: EventItem;
  isPast?: boolean;
  isFeatured?: boolean;
  descLimit?: number;
  showImage?: boolean;
  class?: string;
}

const {
  event,
  isPast = false,
  isFeatured = false,
  descLimit = 100,
  showImage = false,
  class: className = ''
} = Astro.props;

const typeClasses: Record<string, string> = {
  conference: 'bg-accent/10 text-accent border border-accent/25',
  workshop: 'bg-success/10 text-success border border-success/25',
  hackathon: 'bg-warning/10 text-warning border border-warning/25',
  meetup: 'bg-purple-500/10 text-purple-400 border border-purple-500/25',
  bootcamp: 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/25',
  cohorte: 'bg-pink-500/10 text-pink-400 border border-pink-500/25',
  buildathon: 'bg-teal-500/10 text-teal-400 border border-teal-500/25',
};

const typeClass = typeClasses[event.type.toLowerCase()] || 'bg-purple-500/10 text-purple-400 border border-purple-500/25';

const isEthLima = event.tags.some(t => t.toLowerCase() === 'ethlima');

// Format description
const description = event.description || '';
const shortDesc = description.length > descLimit
  ? description.substring(0, descLimit) + '...'
  : description;

// Determine tags
const tags = event.tags.slice(0, 3);
---

<div
  class={`event-card group flex flex-col h-full overflow-hidden rounded-[20px] border border-white/5 bg-gradient-to-b from-white/[0.04] to-white/[0.01] backdrop-blur-md transition-all duration-500 hover:-translate-y-2 hover:border-accent/40 hover:bg-white/[0.06] hover:shadow-[0_40px_80px_rgba(0,0,0,0.6),0_0_40px_rgba(98,126,234,0.15)] relative cursor-pointer ${isPast ? 'opacity-50 grayscale border-transparent bg-white/[0.01] hover:opacity-100 hover:grayscale-0 hover:border-white/10' : ''} ${isFeatured ? 'featured' : ''} ${isEthLima ? 'border-accent/25' : ''} ${className}`}
  data-event-id={event.id}
  data-event-type={event.type}
  data-event-past={isPast ? 'true' : 'false'}
  data-event-ethlima={isEthLima ? 'true' : 'false'}
  data-event-date={event.date}
  data-event-tags={event.tags.join(',')}
  data-event-title={event.title}
  data-event-description={event.description}
  data-event-end-date={event.endDate}
  data-event-time={event.time}
  data-event-location={event.location}
  data-event-link={event.link}
  data-event-organizer={event.organizer}
  data-event-issue-num={event.issueNum}
  data-event-parent-id={event.parentId}
  data-event-subevent={event.parentId ? 'true' : 'false'}
>
  {showImage && event.image && (
    <div class="relative w-full aspect-square overflow-hidden bg-surface-2/80">
      <img
        src={event.image}
        alt={event.title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent opacity-80" />
    </div>
  )}

  <div class="p-5 flex-1 flex flex-col">
    <div class="flex items-center justify-between gap-4 mb-4">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`font-mono text-[10px] tracking-wider font-bold uppercase px-2.5 py-1 rounded-full ${typeClass}`}>
          {event.type}
        </span>
        {isEthLima && (
          <span class="font-mono text-[10px] tracking-widest font-bold uppercase px-2.5 py-1 rounded-full bg-accent/20 text-accent-2 border border-accent/30 shadow-[0_0_10px_rgba(98,126,234,0.1)]">
            ETH Lima
          </span>
        )}
      </div>
      <span class="font-mono text-xs text-muted">#{event.issueNum}</span>
    </div>

    <div class="flex-1 flex flex-col">
      <h3 class="font-sans font-bold text-lg text-white mb-2 leading-tight group-hover:text-accent-2 transition-colors">
        {event.title}
      </h3>
      <p class="font-sans text-sm text-muted leading-relaxed flex-1 mb-4">
        {shortDesc}
      </p>

      <div class="flex items-center gap-2 text-xs text-muted font-mono mt-auto pt-4 border-t border-white/5">
        <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class="event-date-display" data-date={event.date} data-end-date={event.endDate} data-time={event.time}>
          {event.date}
        </span>
      </div>
    </div>
  </div>

  <div class="px-5 pb-5 pt-2 flex items-center justify-between gap-4">
    <div class="flex items-center gap-1.5 flex-wrap">
      {tags.map(tag => (
        <span class="text-xs text-muted font-sans bg-white/5 px-2 py-0.5 rounded">
          #{tag}
        </span>
      ))}
    </div>
    <span class="text-xs font-mono font-bold text-accent group-hover:text-accent-2 tracking-wider flex items-center gap-1 transition-colors whitespace-nowrap card-action-text" data-reserve={isFeatured ? 'true' : 'false'}>
      {isFeatured ? 'RESERVAR →' : 'VER MÁS →'}
    </span>
  </div>
</div>
