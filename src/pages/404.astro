---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="404 - Página no encontrada" description="Lo sentimos, no pudimos encontrar la página que buscas.">
  <Header />
  
  <main class="flex-1 flex flex-col items-center justify-center text-center px-6 py-20 md:py-32 relative z-10 min-h-[70vh]">
    <!-- Background visual effects -->
    <div class="absolute inset-0 z-0 opacity-30 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-accent/20 blur-[120px] rounded-full mix-blend-screen animate-pulse"></div>
    </div>
    
    <div class="relative z-10 flex flex-col items-center max-w-2xl mx-auto">
      <div class="font-mono text-[120px] md:text-[180px] font-extrabold leading-none text-transparent bg-clip-text bg-gradient-to-b from-white to-white/10 select-none mb-6">
        404
      </div>
      
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">
        Llegaste al vacío del espacio Web3.
      </h1>
      
      <p class="text-lg text-content-secondary mb-12 max-w-lg leading-relaxed">
        El bloque que intentas acceder no existe o fue reorganizado en otra cadena. 
      </p>
      
      <a href="/" class="group flex items-center gap-3 px-8 py-4 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-xl shadow-[0_0_20px_rgba(98,126,234,0.3)] hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(98,126,234,0.5)] transition-all duration-300">
        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        VOLVER AL INICIO
      </a>
    </div>
  </main>
</Layout>
