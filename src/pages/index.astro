      type_hackathon: "HACKATHON",
      type_bootcamp: "BOOTCAMP",
      type_buildathon: "BUILDATHON",
      type_cohorte: "COHORTE",
    }
  };

  let currentLang = localStorage.getItem('eth_events_lang') || 'es';
  let currentViewMode = 'list';
  let selectedMonth = new Date().getMonth();
  let selectedYear = new Date().getFullYear();

  // Elements
  const langEs = document.getElementById('lang-es');
  const langEn = document.getElementById('lang-en');
  const btnList = document.getElementById('btn-list');
  const btnCalendar = document.getElementById('btn-calendar');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const monthSelect = document.getElementById('month-select');

  // Arrays of card nodes (excluding subevents from the main grid view lists)
  const allCardNodes = Array.from(document.querySelectorAll('.event-card')) as HTMLElement[];
  const ethLimaCards = allCardNodes.filter(el => el.getAttribute('data-event-subevent') !== 'true' && el.getAttribute('data-event-ethlima') === 'true' && el.getAttribute('data-event-past') === 'false');
  const communityCards = allCardNodes.filter(el => el.getAttribute('data-event-subevent') !== 'true' && el.getAttribute('data-event-ethlima') === 'false' && el.getAttribute('data-event-past') === 'false');
  const pastCards = allCardNodes.filter(el => el.getAttribute('data-event-subevent') !== 'true' && el.getAttribute('data-event-past') === 'true');

  // State
  let activeFilter = 'all';
  let activeModality = 'all';
  let publicSearchQuery = '';
  let limitEthLima = 4;
  let limitCommunity = 16;
  let limitPast = 8;

  // ──────────────────────────────────────────────
  // LOCALIZATION ENGINE
  // ──────────────────────────────────────────────
  function setLanguage(lang: string) {
    currentLang = lang;
    localStorage.setItem('eth_events_lang', lang);

    document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`lang-${lang}`);
    if (activeBtn) activeBtn.classList.add('active');

    document.documentElement.lang = lang;

    // Translate statically tagged elements
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && TRANSLATIONS[lang][key]) {
        el.innerHTML = TRANSLATIONS[lang][key];
      }
    });

    updateAllDates();
    applyVisibility();
    if (currentViewMode === 'calendar') {
      updateCalendarView();
    }
  }

  function updateAllDates() {
    const t = TRANSLATIONS[currentLang];
    const locale = currentLang === 'es' ? 'es' : 'en-US';

    allCardNodes.forEach(card => {
      const dateDisplay = card.querySelector('.event-date-display');
      const actionText = card.querySelector('.card-action-text');
      const isReserve = actionText?.getAttribute('data-reserve') === 'true';

      if (actionText) {
        actionText.textContent = isReserve ? t.card_reserve : t.card_more_info;
      }

      if (dateDisplay) {
        const dateAttr = card.getAttribute('data-event-date');
        const endDateAttr = card.getAttribute('data-event-end-date');
        const timeAttr = card.getAttribute('data-event-time');

        if (!dateAttr) {
          dateDisplay.textContent = t.confirm_date;
          return;
        }

        const dateStr = new Date(dateAttr + 'T00:00').toLocaleDateString(locale, {
          day: 'numeric', month: 'short'
        });

        let fullDate = dateStr;
        if (endDateAttr && dateAttr !== endDateAttr) {
          const endDateStr = new Date(endDateAttr + 'T00:00').toLocaleDateString(locale, {
            day: 'numeric', month: 'short'
          });
          fullDate = `${dateStr} — ${endDateStr}`;
        }

        dateDisplay.textContent = `${fullDate}${timeAttr ? ' · ' + timeAttr : ''}`;
      }
    });
  }

  // ──────────────────────────────────────────────
  // FILTERING AND PAGINATION
  // ──────────────────────────────────────────────
  function applyVisibility() {
    // 1. ETH Lima cards
    ethLimaCards.forEach((card, index) => {
      if (index < limitEthLima) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    const ethLimaMoreCont = document.getElementById('eth-lima-more-container');
    if (ethLimaMoreCont) {
      ethLimaMoreCont.style.display = ethLimaCards.length > limitEthLima ? 'flex' : 'none';
    }

    // 2. Community cards (filtered by activeFilter, modality, and search)
    let visibleCommunityCount = 0;
    const matchesFilter = (card: HTMLElement) => {
      const typeMatch = activeFilter === 'all' || card.getAttribute('data-event-type') === activeFilter;
      
      const loc = (card.getAttribute('data-event-location') || '').toLowerCase();
      const isVirtual = loc.includes('virtual') || loc.includes('online') || loc.includes('zoom') || loc.includes('meet') || loc === '';
      
      let modalityMatch = true;
      if (activeModality === 'presencial') modalityMatch = !isVirtual;
      if (activeModality === 'virtual') modalityMatch = isVirtual;

      let searchMatch = true;
      if (publicSearchQuery) {
        const title = (card.getAttribute('data-event-title') || '').toLowerCase();
        const desc = (card.getAttribute('data-event-description') || '').toLowerCase();
        const org = (card.getAttribute('data-event-organizer') || '').toLowerCase();
        const q = publicSearchQuery.toLowerCase();
        searchMatch = title.includes(q) || desc.includes(q) || org.includes(q) || loc.includes(q);
      }

      return typeMatch && modalityMatch && searchMatch;
    };

    const eligibleCommunity = communityCards.filter(matchesFilter);

    communityCards.forEach(card => {
      if (matchesFilter(card)) {
        if (visibleCommunityCount < limitCommunity) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
        visibleCommunityCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const commMoreCont = document.getElementById('community-more-container');
    if (commMoreCont) {
      commMoreCont.style.display = eligibleCommunity.length > limitCommunity ? 'flex' : 'none';
    }

    // Empty state handling
    const grid = document.getElementById('events-grid');
    if (grid) {
      const existingEmpty = grid.querySelector('.empty-state');
      if (existingEmpty) existingEmpty.remove();

      if (eligibleCommunity.length === 0) {
        const t = TRANSLATIONS[currentLang];
        const emptyDiv = document.createElement('div');
        emptyDiv.className = 'empty-state flex flex-col items-center justify-center p-12 border border-white/5 rounded-2xl bg-white/[0.01] w-full text-center col-span-full';
        emptyDiv.innerHTML = `
          <h3 class="font-sans font-bold text-lg text-white mb-2">${t.empty_filters || 'Sin eventos de este tipo'}</h3>
          <p class="font-mono text-xs text-muted mb-6">${t.empty_try_another || '// Prueba otro filtro'}</p>
          <a class="btn-primary flex items-center gap-2 px-6 py-2.5 bg-accent text-white font-mono text-xs font-bold rounded-lg shadow-md hover:-translate-y-0.5 transition-all" href="/submit">
            ${t.btn_propose}
          </a>`;
        grid.appendChild(emptyDiv);
      }
    }

    // 3. Past cards
    pastCards.forEach((card, index) => {
      if (index < limitPast) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    const pastMoreCont = document.getElementById('past-more-container');
    if (pastMoreCont) {
      pastMoreCont.style.display = pastCards.length > limitPast ? 'flex' : 'none';
    }

    // Always hide subevents in grid list view
    allCardNodes.filter(el => el.getAttribute('data-event-subevent') === 'true').forEach(card => {
      card.style.display = 'none';
    });
  }

  // ──────────────────────────────────────────────
  // MONTH SELECTOR & CALENDAR POPULATION
  // ──────────────────────────────────────────────
  function populateMonthSelector() {
    if (!monthSelect) return;
    monthSelect.innerHTML = '';

    const months = [];
    const now = new Date();
    
    // Collect all event dates to find available months/years
    const eventDates = allCardNodes
      .map(card => card.getAttribute('data-event-date'))
      .filter(Boolean) as string[];

    const years = [...new Set(eventDates.map(d => new Date(d + 'T00:00').getFullYear()))];
    if (years.length === 0) years.push(now.getFullYear());

    // Generate month options
    const locale = currentLang === 'es' ? 'es' : 'en-US';
    const uniqueMonths = new Map<string, { year: number; month: number; label: string }>();

    eventDates.forEach(dateStr => {
      const d = new Date(dateStr + 'T00:00');
      const y = d.getFullYear();
      const m = d.getMonth();
      const key = `${y}-${m}`;
      if (!uniqueMonths.has(key)) {
        const label = d.toLocaleDateString(locale, { month: 'long', year: 'numeric' }).toUpperCase();
        uniqueMonths.set(key, { year: y, month: m, label });
      }
    });

    // Make sure current month is included
    const curKey = `${now.getFullYear()}-${now.getMonth()}`;
    if (!uniqueMonths.has(curKey)) {
      const label = now.toLocaleDateString(locale, { month: 'long', year: 'numeric' }).toUpperCase();
      uniqueMonths.set(curKey, { year: now.getFullYear(), month: now.getMonth(), label });
    }

    const sortedMonths = Array.from(uniqueMonths.values()).sort((a, b) => {
      return a.year !== b.year ? a.year - b.year : a.month - b.month;
    });

    sortedMonths.forEach(opt => {
      const el = document.createElement('option');
      el.value = `${opt.year}-${opt.month}`;
      el.textContent = opt.label;
      if (opt.year === now.getFullYear() && opt.month === now.getMonth()) {
        el.selected = true;
      }
      monthSelect.appendChild(el);
    });

    monthSelect.addEventListener('change', updateCalendarView);
  }

  function updateCalendarView() {
    if (!monthSelect) return;
    const val = monthSelect.value;
    if (!val) return;
    const [y, m] = val.split('-').map(Number);
    renderCalendar(y, m);
  }

  function renderCalendar(year: number, month: number) {
    const grid = document.getElementById('calendar-grid');
    if (!grid) return;

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const prevDaysInMonth = new Date(year, month, 0).getDate();
    
    const dayNames = currentLang === 'es' 
      ? ['DOM', 'LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB']
      : ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];

    let html = dayNames.map(d => `<div class="cal-day-header bg-surface-2 p-2 text-center font-mono text-[9px] text-muted font-bold tracking-wider">${d}</div>`).join('');

    // Previous month days fill
    for (let i = firstDay; i > 0; i--) {
      const d = prevDaysInMonth - i + 1;
      html += `<div class="cal-day other-month opacity-15 bg-black/10 min-h-[70px] p-1 flex flex-col gap-0.5"><div class="cal-date font-mono text-[10px] text-muted mb-1">${d}</div></div>`;
    }

    // Current month days
    const now = new Date();
    
    // Parse events from existing cards dynamically
    const events = allCardNodes.map(card => ({
      id: card.getAttribute('data-event-id') || '',
      title: card.getAttribute('data-event-title') || '',
      date: card.getAttribute('data-event-date') || '',
      type: card.getAttribute('data-event-type') || 'meetup',
      organizer: card.getAttribute('data-event-organizer') || '',
      subevent: card.getAttribute('data-event-subevent') === 'true'
    }));

    for (let d = 1; d <= daysInMonth; d++) {
      const isToday = now.getDate() === d && now.getMonth() === month && now.getFullYear() === year;
      const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      
      const dayEvents = events.filter(e => e.date === dateStr);
      
      const eventItemsHTML = dayEvents.map(e => {
        const borderColors: Record<string, string> = {
          conference: 'border-accent bg-accent/10',
          workshop: 'border-success bg-success/10',
          hackathon: 'border-warning bg-warning/10',
          meetup: 'border-purple-500 bg-purple-500/10',
          bootcamp: 'border-indigo-500 bg-indigo-500/10',
          cohorte: 'border-pink-500 bg-pink-500/10',
          buildathon: 'border-teal-500 bg-teal-500/10',
        };
        const styleClass = borderColors[e.type] || 'border-purple-500 bg-purple-500/10';
        
        const orgText = e.organizer ? e.organizer : 'Comunidad';

        if (e.subevent) {
          return `<div class="cal-event flex flex-col gap-0.5 text-[10px] px-2.5 py-1.5 rounded bg-surface-2/40 border-l-[3px] border-dashed ${styleClass.split(' ')[0]} text-white/70 italic cursor-pointer overflow-hidden hover:bg-white/10 hover:text-white hover:translate-x-0.5 transition-all shadow-sm shrink-0" data-cal-event-id="${e.id}" title="${e.title} - ${orgText}">
            <span class="font-bold truncate leading-tight">↳ ${e.title}</span>
            <span class="text-[9px] opacity-70 truncate leading-tight">${orgText}</span>
          </div>`;
        } else {
          return `<div class="cal-event flex flex-col gap-0.5 text-[10px] px-2.5 py-1.5 rounded ${styleClass} border-l-[3px] text-white cursor-pointer overflow-hidden hover:brightness-125 hover:-translate-y-0.5 transition-all shadow-sm shrink-0" data-cal-event-id="${e.id}" title="${e.title} - ${orgText}">
            <span class="font-bold truncate leading-tight">${e.title}</span>
            <span class="text-[9px] opacity-80 truncate leading-tight">${orgText}</span>
          </div>`;
        }
      }).join('');

      html += `
        <div class="cal-day min-h-[120px] p-2 flex flex-col gap-2 bg-bg border border-white/5 ${isToday ? 'bg-accent/5 calendar-day-active' : ''}">
          <div class="cal-date font-mono text-[10px] text-muted flex justify-between items-center ${isToday ? 'text-accent font-bold' : ''}">${d}</div>
          <div class="flex flex-col gap-1.5">${eventItemsHTML}</div>
        </div>`;
    }

    // Next month fill (to get 42 cells)
    const totalRendered = firstDay + daysInMonth;
    const remaining = 42 - totalRendered;
    for (let i = 1; i <= remaining; i++) {
      html += `<div class="cal-day other-month opacity-15 bg-black/10 min-h-[70px] p-1 flex flex-col gap-0.5"><div class="cal-date font-mono text-[10px] text-muted mb-1">${i}</div></div>`;
    }

    grid.innerHTML = html;

    // Attach listeners to calendar events
    grid.querySelectorAll('.cal-event').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = el.getAttribute('data-cal-event-id');
        if (id) openEventModal(id);
      });
    });
  }

  // ──────────────────────────────────────────────
  // VIEW MODE TOGGLE
  // ──────────────────────────────────────────────
  function setViewMode(mode: string) {
    currentViewMode = mode;
    
    if (btnList) btnList.classList.toggle('active', mode === 'list');
    if (btnCalendar) btnCalendar.classList.toggle('active', mode === 'calendar');

    const listContainer = document.getElementById('events-grid');
    const calendarContainer = document.getElementById('calendar-container');
    const filterBar = document.getElementById('filter-bar');
    const monthSelectWrapper = document.getElementById('month-select-container');
    const communityMore = document.getElementById('community-more-container');
    
    // Additional sections to toggle
    const heroSection = document.getElementById('hero-section');
    const statsBarSection = document.getElementById('stats-bar-section');
    const ethLimaContainer = document.getElementById('eth-lima-container');
    const pastEvents = document.getElementById('past-events');
    const organizersSection = document.getElementById('organizers-section');
    const howSection = document.getElementById('how');

    if (mode === 'calendar') {
      if (listContainer) listContainer.style.display = 'none';
      if (calendarContainer) calendarContainer.style.display = 'block';
      if (filterBar) filterBar.style.display = 'none';
      if (monthSelectWrapper) monthSelectWrapper.style.display = 'flex';
      if (communityMore) communityMore.style.display = 'none';
      
      // Hide sections
      if (heroSection) heroSection.style.display = 'none';
      if (statsBarSection) statsBarSection.style.display = 'none';
      if (ethLimaContainer) ethLimaContainer.style.display = 'none';
      if (pastEvents) pastEvents.style.display = 'none';
      if (organizersSection) organizersSection.style.display = 'none';
      if (howSection) howSection.style.display = 'none';
      
      populateMonthSelector();
      updateCalendarView();
    } else {
      if (listContainer) listContainer.style.display = 'grid';
      if (calendarContainer) calendarContainer.style.display = 'none';
      if (filterBar) filterBar.style.display = 'flex';
      if (monthSelectWrapper) monthSelectWrapper.style.display = 'none';
      
      // Restore sections
      if (heroSection) heroSection.style.display = 'block';
      if (statsBarSection) statsBarSection.style.display = 'block';
      if (ethLimaContainer) ethLimaContainer.style.display = 'block';
      if (pastEvents) pastEvents.style.display = 'block';
      if (organizersSection) organizersSection.style.display = 'block';
      if (howSection) howSection.style.display = 'block';
      
      applyVisibility();
    }
  }

  // ──────────────────────────────────────────────
  // MODAL TRIGGER
  // ──────────────────────────────────────────────
  function openEventModal(id: string, isCondensed = false) {
    const card = allCardNodes.find(el => el.getAttribute('data-event-id') === id);
    if (!card) return;

    const t = TRANSLATIONS[currentLang];
    const modalContent = document.getElementById('modal-content');
    if (modalContent) {
      modalContent.classList.toggle('condensed', isCondensed);
    }

    const type = card.getAttribute('data-event-type') || 'meetup';
    const typeClasses: Record<string, string> = {
      conference: 'bg-accent/10 text-accent border border-accent/25',
      workshop: 'bg-success/10 text-success border border-success/25',
      hackathon: 'bg-warning/10 text-warning border border-warning/25',
      meetup: 'bg-purple-500/10 text-purple-400 border border-purple-500/25',
      bootcamp: 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/25',
      cohorte: 'bg-pink-500/10 text-pink-400 border border-pink-500/25',
      buildathon: 'bg-teal-500/10 text-teal-400 border border-teal-500/25',
    };
    const typeClass = typeClasses[type.toLowerCase()] || 'bg-purple-500/10 text-purple-400 border border-purple-500/25';

    const dateAttr = card.getAttribute('data-event-date');
    const endDateAttr = card.getAttribute('data-event-end-date');
    const timeAttr = card.getAttribute('data-event-time');
    const locationAttr = card.getAttribute('data-event-location') || t.confirm_loc;
    const organizerAttr = card.getAttribute('data-event-organizer') || t.organizer_community;
    const titleAttr = card.getAttribute('data-event-title');
    const descriptionAttr = card.getAttribute('data-event-description');
    const linkAttr = card.getAttribute('data-event-link');
    const issueNumAttr = card.getAttribute('data-event-issue-num');

    const locale = currentLang === 'es' ? 'es' : 'en-US';
    let fullDate = t.confirm_date;
    if (dateAttr) {
      const dateStr = new Date(dateAttr + 'T00:00').toLocaleDateString(locale, {
        day: 'numeric', month: 'long', year: 'numeric'
      });
      fullDate = dateStr;
      if (endDateAttr && dateAttr !== endDateAttr) {
        const endDateStr = new Date(endDateAttr + 'T00:00').toLocaleDateString(locale, {
          day: 'numeric', month: 'long', year: 'numeric'
        });
        fullDate = `${dateStr} — ${endDateStr}`;
      }
    }

    const modalData = document.getElementById('modal-data');
    if (modalData) {
      modalData.innerHTML = `
        <div class="mb-6">
          <span class="font-mono text-[10px] tracking-wider font-bold uppercase px-3 py-1.5 rounded-full ${typeClass} inline-block mb-4">
            ${type.toUpperCase()}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight break-words">${titleAttr}</h2>
        </div>
        <div class="mb-8">
          <p class="text-muted leading-relaxed text-sm sm:text-base mb-6 whitespace-pre-line break-words">${descriptionAttr || '// ' + t.confirm_date}</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 bg-surface border border-white/5 rounded-2xl">
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[9px] text-muted uppercase tracking-wider">${t.modal_date}</span>
              <span class="text-sm text-white font-bold">${fullDate}</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[9px] text-muted uppercase tracking-wider">${t.modal_time}</span>
              <span class="text-sm text-white font-bold">${timeAttr || t.confirm_date}</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[9px] text-muted uppercase tracking-wider">${t.modal_location}</span>
              <span class="text-sm text-white font-bold">${locationAttr}</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[9px] text-muted uppercase tracking-wider">${t.modal_organizer}</span>
              <span class="text-sm text-white font-bold">${organizerAttr}</span>
            </div>
          </div>
        </div>

        <!-- SUB-EVENTS SECTION -->
        ${(() => {
          // Read from the full embedded JSON so sub-events are always available
          const allEventsEl = document.getElementById('all-events-data');
          const allEvents: any[] = allEventsEl ? JSON.parse(allEventsEl.getAttribute('data-events') || '[]') : [];
          const subEvents = allEvents
            .filter((e: any) => String(e.parentId) === id)
            .sort((a: any, b: any) => {
              const dA = new Date((a.date || '2099-12-31') + 'T00:00').getTime();
              const dB = new Date((b.date || '2099-12-31') + 'T00:00').getTime();
              return dA - dB;
            });
          if (subEvents.length === 0) return '';

          const subTitle = currentLang === 'es' ? 'CRONOGRAMA DE SESIONES / SUBEVENTOS' : 'SESSION SCHEDULE / SUB-EVENTS';
          const subRows = subEvents.map((se: any) => {
            const seTitle = se.title || '';
            const seDate  = se.date  || '';
            const seTime  = se.time  || '';
            const seType  = se.type  || 'meetup';
            const seLink  = se.link  || '';
            const seId    = String(se.id || '');

            let formattedSeDate = '';
            if (seDate) {
              formattedSeDate = new Date(seDate + 'T00:00').toLocaleDateString(locale, {
                day: 'numeric', month: 'short'
              });
            }

            const colors: Record<string, string> = {
              conference: 'bg-accent/15 border-accent text-accent',
              workshop: 'bg-success/15 border-success text-success',
              hackathon: 'bg-warning/15 border-warning text-warning',
              meetup: 'bg-purple-500/15 border-purple-500 text-purple-400',
              bootcamp: 'bg-indigo-500/15 border-indigo-500 text-indigo-400',
            };
            const pillColor = colors[seType.toLowerCase()] || 'bg-purple-500/15 border-purple-500 text-purple-400';

            return `
              <div class="flex items-center justify-between gap-4 p-3 bg-surface-2/60 border border-white/5 rounded-xl hover:bg-surface-2 transition-all group/sub" data-sub-id="${seId}">
                <div class="flex items-center gap-3 overflow-hidden">
                  <span class="font-mono text-[9px] px-2 py-0.5 border rounded ${pillColor} shrink-0 uppercase">${seType}</span>
                  <div class="flex flex-col truncate">
                    <span class="text-sm font-bold text-white leading-snug group-hover/sub:text-accent-2 transition-colors truncate">${seTitle}</span>
                    <span class="font-mono text-[10px] text-muted">${formattedSeDate}${seTime ? ' · ' + seTime : ''}</span>
                  </div>
                </div>
                ${seLink ? `
                  <a href="${seLink}" target="_blank" class="shrink-0 flex items-center justify-center w-8 h-8 rounded-lg bg-white/5 hover:bg-accent/20 hover:text-white transition-all text-muted" onclick="event.stopPropagation()">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
                    </svg>
                  </a>
                ` : ''}
              </div>
            `;
          }).join('');

          return `
            <div class="mt-8 border-t border-white/5 pt-6">
              <h3 class="font-mono text-[10px] text-accent-2 tracking-widest font-bold uppercase mb-4 flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M9 2v4M15 2v4M3 10h18" />
                </svg>
                ${subTitle}
              </h3>
              <div class="space-y-2 max-h-[300px] overflow-y-auto no-scrollbar">
                ${subRows}
              </div>
            </div>
          `;
        })()}

        <div class="flex justify-center pt-6 border-t border-white/5">
          <a class="px-8 py-3.5 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-lg shadow-lg hover:-translate-y-0.5 transition-all text-center tracking-wider w-full sm:w-auto" href="${linkAttr || `https://github.com/javierarteagagonzales/ethevents/issues/${issueNumAttr}`}" target="_blank">
            ${t.modal_btn_access}
          </a>
        </div>
      `;
    }

    // Use the accessible openModal from Modal.astro (focus trap + Esc support)
    if ((window as any).__openEventModal) {
      (window as any).__openEventModal();
    } else {
      const overlay = document.getElementById('modal-overlay');
      if (overlay) { overlay.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    }
  }

  // ──────────────────────────────────────────────
  // INITIALIZERS & EVENT LISTENERS
  // ──────────────────────────────────────────────
  langEs?.addEventListener('click', () => setLanguage('es'));
  langEn?.addEventListener('click', () => setLanguage('en'));

  btnList?.addEventListener('click', () => setViewMode('list'));
  btnCalendar?.addEventListener('click', () => setViewMode('calendar'));

  // Attach card clicks → open modal
  allCardNodes.forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-event-id');
      if (id) openEventModal(id);
    });
  });

  // Attach filter buttons clicks
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active', 'border-accent', 'text-accent', 'bg-accent/15'));
      btn.classList.add('active', 'border-accent', 'text-accent', 'bg-accent/15');
      activeFilter = btn.getAttribute('data-filter') || 'all';
      limitCommunity = 16; // Reset page limit on filter change
      applyVisibility();
    });
  });

  // Attach modality buttons
  const modalityBtns = document.querySelectorAll('.modality-btn');
  modalityBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modalityBtns.forEach(b => b.classList.remove('active', 'text-accent', 'bg-accent/20', 'font-bold'));
      modalityBtns.forEach(b => b.classList.add('text-muted'));
      btn.classList.remove('text-muted');
      btn.classList.add('active', 'text-accent', 'bg-accent/20', 'font-bold');
      activeModality = btn.getAttribute('data-modality') || 'all';
      limitCommunity = 16;
      applyVisibility();
    });
  });



  // See More buttons
  document.getElementById('btn-see-all-eth-lima')?.addEventListener('click', () => {
    limitEthLima = ethLimaCards.length;
    applyVisibility();
  });

  document.getElementById('btn-see-all-community')?.addEventListener('click', () => {
    limitCommunity = communityCards.length;
    applyVisibility();
  });

  document.getElementById('btn-see-all-past')?.addEventListener('click', () => {
    limitPast = pastCards.length;
    applyVisibility();
  });

  // Initialize Canvas
  function initHeroCanvas() {
    const canvas = document.getElementById('hero-network-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = canvas.width = canvas.offsetWidth;
    let height = canvas.height = canvas.offsetHeight;

    const resizeObserver = new ResizeObserver(entries => {
      for (let entry of entries) {
        width = canvas.width = entry.contentRect.width;
        height = canvas.height = entry.contentRect.height;
      }
    });
    resizeObserver.observe(canvas);

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
    }

    const particles: Particle[] = [];
    const maxParticles = 50;

    for (let i = 0; i < maxParticles; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        radius: Math.random() * 1.5 + 1
      });
    }

    let mouse = { x: -1000, y: -1000 };
    const heroSection = canvas.parentElement;
    if (heroSection) {
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });
      heroSection.addEventListener('mouseleave', () => {
        mouse.x = -1000;
        mouse.y = -1000;
      });
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Draw connections
      ctx.lineWidth = 0.5;
      for (let i = 0; i < maxParticles; i++) {
        const p1 = particles[i];
        for (let j = i + 1; j < maxParticles; j++) {
          const p2 = particles[j];
          const dist = Math.hypot(p1.x - p2.x, p1.y - p2.y);
          if (dist < 100) {
            const alpha = (1 - dist / 100) * 0.15;
            ctx.strokeStyle = `rgba(98, 126, 234, ${alpha})`;
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }

      // Draw and update particles
      for (let i = 0; i < maxParticles; i++) {
        const p = particles[i];
        
        // Mouse interact
        if (mouse.x > 0) {
          const distToMouse = Math.hypot(p.x - mouse.x, p.y - mouse.y);
          if (distToMouse < 120) {
            const force = (120 - distToMouse) / 120;
            const angle = Math.atan2(p.y - mouse.y, p.x - mouse.x);
            p.x += Math.cos(angle) * force * 1.2;
            p.y += Math.sin(angle) * force * 1.2;
          }
        }

        p.x += p.vx;
        p.y += p.vy;

        // Boundary check
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        ctx.fillStyle = 'rgba(98, 126, 234, 0.4)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  // Initialize
  setLanguage(currentLang);
  applyVisibility();
  initHeroCanvas();
</script>
