---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EventCard from '../components/EventCard.astro';
import StatsBar from '../components/StatsBar.astro';
import FilterBar from '../components/FilterBar.astro';
import Calendar from '../components/Calendar.astro';
import Modal from '../components/Modal.astro';
import eventsRaw from '../../events.json';
import type { EventItem } from '../types/event';

// Cast imported events
const events = eventsRaw as EventItem[];

const now = new Date();
now.setHours(0, 0, 0, 0);

// Pre-process events for SSG build
const processedEvents = events.map(e => {
  const start = e.date ? new Date(e.date + 'T00:00') : new Date('2099-12-31');
  const end = (e.endDate && e.endDate !== '') ? new Date(e.endDate + 'T00:00') : start;
  const isEthLima = (e.organizer || '').toLowerCase().includes('eth lima') || 
                    (e.organizer || '').toLowerCase().includes('ethereum lima') ||
                    (e.tags || []).some(t => t.toLowerCase() === 'ethlima');
  const isPast = end < now;
  return {
    ...e,
    _isEthLima: isEthLima,
    _isPast: isPast,
    _dateObj: start
  };
});

// Segment events
const upcoming = processedEvents.filter(e => !e._isPast).sort((a, b) => a._dateObj.getTime() - b._dateObj.getTime());
const ethLimaUpcoming = upcoming.filter(e => e._isEthLima);
const communityUpcoming = upcoming.filter(e => !e._isEthLima);

const past = processedEvents.filter(e => e._isPast).sort((a, b) => b._dateObj.getTime() - a._dateObj.getTime());

// Compute statistics
const totalCount = processedEvents.length;
const upcomingCount = upcoming.length;
const categoriesCount = new Set(processedEvents.map(e => e.type.toLowerCase())).size;

// Unique organizers list
const organizers = [...new Set(processedEvents.map(e => e.organizer).filter(Boolean))];
const organizerGradients = [
  'linear-gradient(135deg, #627eea 0%, #a78bfa 100%)',
  'linear-gradient(135deg, #10b981 0%, #34d399 100%)',
  'linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%)',
  'linear-gradient(135deg, #ec4899 0%, #f472b6 100%)',
  'linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%)',
  'linear-gradient(135deg, #2dd4bf 0%, #5eead4 100%)'
];
---

<Layout title="ETH Events — Comunidad" description="Plataforma de eventos Web3 descentralizada y abierta. Suma tu evento a través de GitHub.">
  <Header showViewToggle={true} />

  <!-- HERO SECTION WITH INTERACTIVE 3D MESH -->
  <section class="hero text-center py-24 px-6 max-w-4xl mx-auto relative overflow-hidden rounded-[32px] border border-white/5 bg-gradient-to-b from-white/[0.03] to-transparent backdrop-blur-sm z-10 mb-6 group">
    <!-- Interactive Canvas in Hero background -->
    <canvas id="hero-network-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-45 mix-blend-screen transition-opacity duration-500 group-hover:opacity-65"></canvas>
    
    <div class="relative z-10 flex flex-col items-center">
      <!-- Ethereum Lima Badge -->
      <div class="hero-tag inline-flex items-center gap-2.5 font-mono text-[10px] text-accent-2 tracking-[0.2em] bg-accent/10 border border-accent/30 rounded-full px-5 py-2 mb-8 shadow-[0_0_20px_rgba(98,126,234,0.15)] animate-modal-fade select-none">
        <span class="w-2 h-2 rounded-full bg-accent-2 animate-pulse shadow-[0_0_10px_#627eea]"></span>
        ORGANIZACIÓN ETHEREUM LIMA
      </div>
      
      <h1 class="text-4xl md:text-7xl font-extrabold tracking-tight mb-6 leading-none text-white max-w-3xl">
        <span data-i18n="hero_title_main">Súmate a la</span> <span class="bg-gradient-to-r from-accent via-[#a78bfa] to-accent bg-[length:200%_auto] bg-clip-text text-transparent animate-shimmer" data-i18n="hero_title_span">Comunidad</span>
      </h1>
      <p class="text-base md:text-lg text-muted max-w-xl mx-auto mb-10 leading-relaxed font-sans" data-i18n="hero_subtitle">
        La plataforma oficial para descubrir y publicar eventos de la comunidad Web3 en el Perú.
      </p>
      
      <div class="flex justify-center">
        <a href="/submit" class="btn-primary flex items-center gap-2 px-10 py-4 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-xl shadow-[0_0_30px_rgba(98,126,234,0.3)] hover:-translate-y-0.5 hover:shadow-[0_0_50px_rgba(98,126,234,0.5)] transition-all duration-300" data-i18n="btn_propose">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
          PROPONER EVENTO
        </a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <StatsBar total={totalCount} upcoming={upcomingCount} categories={categoriesCount} />

  <!-- MAIN EVENT LAYOUTS -->
  <main class="max-w-[1400px] mx-auto px-6 md:px-10 pb-20 relative z-10" id="events">
    
    <!-- ETH LIMA EVENTS SECTION -->
    {ethLimaUpcoming.length > 0 && (
      <div id="eth-lima-container" class="mb-16">
        <div class="flex items-center justify-between gap-4 mb-8">
          <h2 class="text-2xl md:text-3xl font-extrabold text-white" data-i18n="sec_eth_lima">
            Eventos <span class="text-accent">ETH Lima</span>
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="eth-lima-grid">
          {ethLimaUpcoming.map(event => (
            <EventCard event={event} showImage={true} class="eth-lima-item-card" />
          ))}
        </div>
        
        {ethLimaUpcoming.length > 4 && (
          <div class="flex justify-center mt-10" id="eth-lima-more-container">
            <button class="flex items-center gap-2 px-6 py-3 border border-white/10 hover:border-accent hover:bg-accent/15 text-muted hover:text-white font-mono text-xs font-bold rounded-full transition-all" id="btn-see-all-eth-lima" data-i18n="btn_see_all_eth">
              VER TODOS LOS EVENTOS ETH LIMA
              <svg class="w-4.5 h-4.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
        )}
      </div>
    )}

    <!-- COMMUNITY EVENTS SECTION -->
    <div class="mb-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold text-white" data-i18n="sec_community">
          Eventos de la <span class="text-accent">Comunidad</span>
        </h2>
        <FilterBar />
      </div>

      <!-- List/Grid Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="events-grid">
        {communityUpcoming.map(event => (
          <EventCard event={event} class="community-item-card" />
        ))}
      </div>

      <!-- See More Button -->
      {communityUpcoming.length > 16 && (
        <div class="flex justify-center mt-10" id="community-more-container">
          <button class="flex items-center gap-2 px-6 py-3 border border-white/10 hover:border-accent hover:bg-accent/15 text-muted hover:text-white font-mono text-xs font-bold rounded-full transition-all" id="btn-see-all-community" data-i18n="btn_see_all">
            VER TODOS LOS EVENTOS
            <svg class="w-4.5 h-4.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      )}

      <!-- Calendar View -->
      <Calendar />
    </div>

    <!-- PAST EVENTS SECTION -->
    {past.length > 0 && (
      <div id="past-events" class="mt-20 pt-16 border-t border-white/5">
        <div class="mb-8">
          <h2 class="text-xl md:text-2xl font-extrabold text-muted" data-i18n="sec_past">
            Eventos <span class="text-accent/80">Pasados</span>
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="past-events-grid">
          {past.map(event => (
            <EventCard event={event} isPast={true} class="past-item-card" />
          ))}
        </div>
        
        {past.length > 8 && (
          <div class="flex justify-center mt-10" id="past-more-container">
            <button class="flex items-center gap-2 px-6 py-3 border border-transparent bg-white/[0.03] hover:bg-white/[0.08] text-muted hover:text-white font-mono text-xs font-bold rounded-full transition-all" id="btn-see-all-past" data-i18n="btn_see_more_past">
              MOSTRAR MÁS EVENTOS PASADOS
              <svg class="w-4.5 h-4.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
        )}
      </div>
    )}

    <!-- ORGANIZERS SECTION -->
    {organizers.length > 0 && (
      <div class="mt-20 p-8 bg-white/[0.01] border border-white/5 rounded-3xl backdrop-blur-md" id="organizers-section">
        <div class="font-mono text-[11px] text-muted tracking-[0.2em] mb-8 text-center uppercase">
          ORGANIZADORES
        </div>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12" id="organizers-list">
          {organizers.map((name, i) => {
            const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            const gradient = organizerGradients[i % organizerGradients.length];
            return (
              <div class="flex flex-col items-center gap-2 group cursor-pointer transition-transform duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center font-mono font-bold text-lg text-white border border-white/10 relative overflow-hidden shadow-lg group-hover:scale-105 transition-transform" style={{ background: gradient }}>
                  {initials}
                  <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent" />
                </div>
                <div class="font-mono text-[10px] text-muted text-center max-w-[80px] leading-tight group-hover:text-white transition-colors">
                  {name}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- HOW IT WORKS SECTION -->
    <div class="mt-20 py-16 border-t border-white/5" id="how">
      <h2 class="text-3xl font-extrabold text-center text-white mb-16" data-i18n="how_title">
        ¿Cómo agregar un evento?
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <div class="bg-white/[0.01] border border-white/5 rounded-2xl p-6 flex flex-col items-center text-center relative group hover:border-accent/30 hover:bg-white/[0.02] transition-all duration-300">
          <div class="font-mono text-[10px] text-accent tracking-widest font-bold uppercase mb-4" data-i18n="how_s1_step">PASO 01</div>
          <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          </div>
          <h3 class="font-sans font-bold text-base text-white mb-2" data-i18n="how_s1_title">Click en nuevo evento</h3>
          <p class="font-sans text-xs text-muted leading-relaxed" data-i18n="how_s1_desc">Presiona el botón "+ NUEVO EVENTO" para iniciar el proceso a través de un formulario sencillo.</p>
        </div>

        <div class="bg-white/[0.01] border border-white/5 rounded-2xl p-6 flex flex-col items-center text-center relative group hover:border-accent/30 hover:bg-white/[0.02] transition-all duration-300">
          <div class="font-mono text-[10px] text-accent tracking-widest font-bold uppercase mb-4" data-i18n="how_s2_step">PASO 02</div>
          <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12h6M9 16h6M9 8h6M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-sans font-bold text-base text-white mb-2" data-i18n="how_s2_title">Llena el formulario</h3>
          <p class="font-sans text-xs text-muted leading-relaxed" data-i18n="how_s2_desc">Completa el formulario web con los detalles del evento (nombre, fecha, ubicación, etc.).</p>
        </div>

        <div class="bg-white/[0.01] border border-white/5 rounded-2xl p-6 flex flex-col items-center text-center relative group hover:border-accent/30 hover:bg-white/[0.02] transition-all duration-300">
          <div class="font-mono text-[10px] text-accent tracking-widest font-bold uppercase mb-4" data-i18n="how_s3_step">PASO 03</div>
          <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-sans font-bold text-base text-white mb-2" data-i18n="how_s3_title">Espera la aprobación</h3>
          <p class="font-sans text-xs text-muted leading-relaxed" data-i18n="how_s3_desc">El equipo de Ethereum Lima revisará tu propuesta. Una vez aprobado, se publicará automáticamente.</p>
        </div>

        <div class="bg-white/[0.01] border border-white/5 rounded-2xl p-6 flex flex-col items-center text-center relative group hover:border-accent/30 hover:bg-white/[0.02] transition-all duration-300">
          <div class="font-mono text-[10px] text-accent tracking-widest font-bold uppercase mb-4" data-i18n="how_support_step">SOPORTE</div>
          <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-sans font-bold text-base text-white mb-2" data-i18n="how_support_title">¿Algún problema?</h3>
          <p class="font-sans text-xs text-muted leading-relaxed" data-i18n="how_support_desc">
            Escríbenos a <a href="mailto:hola@ethlima.org" class="text-accent hover:text-accent-2 transition-colors">hola@ethlima.org</a> y te ayudaremos con el proceso.
          </p>
        </div>

      </div>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="mt-auto py-10 px-6 border-t border-white/5 bg-[#030407] relative z-10">
    <div class="max-w-[1400px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2 text-sm text-muted">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 32 32" fill="none">
          <polygon points="16,2 28,9 28,23 16,30 4,23 4,9" stroke="#627eea" stroke-width="1.5" fill="none" />
          <circle cx="16" cy="16" r="3" fill="#627eea" />
        </svg>
        ETH_EVENTS © 2026 — Powered by Ethereum Lima
      </div>
      <div class="flex items-center gap-6 font-mono text-xs text-muted">
        <a href="https://github.com/javierarteagagonzales/ethevents" target="_blank" class="hover:text-white transition-colors">GitHub</a>
        <a href="https://github.com/javierarteagagonzales/ethevents/blob/main/README.md" target="_blank" class="hover:text-white transition-colors">Docs</a>
      </div>
    </div>
  </footer>

  <Modal />
</Layout>

<script>
  // ──────────────────────────────────────────────
  // I18N DICTIONARY
  // ──────────────────────────────────────────────
  const TRANSLATIONS: Record<string, Record<string, string>> = {
    es: {
      nav_events: "EVENTOS",
      nav_how: "CÓMO FUNCIONA",
      nav_projects: "PROYECTOS",
      nav_projects_sub: "// Nuestras iniciativas",
      nav_new: "+ NUEVO EVENTO",
      sec_eth_lima: "Eventos <span>ETH Lima</span>",
      sec_community: "Eventos de la <span>Comunidad</span>",
