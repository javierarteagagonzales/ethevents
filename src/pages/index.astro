---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EventCard from '../components/EventCard.astro';
import StatsBar from '../components/StatsBar.astro';
import FilterBar from '../components/FilterBar.astro';
import Calendar from '../components/Calendar.astro';
import Modal from '../components/Modal.astro';
import eventsRaw from '../../events.json';
import membersRaw from '../../members.json';
import type { EventItem } from '../types/event';
import type { MemberItem } from '../types/member';
import { ROLE_ORDER } from '../types/member';

// Cast imported events
const events = eventsRaw as EventItem[];

const now = new Date();
now.setHours(0, 0, 0, 0);

// Pre-process events for SSG build
const processedEvents = events.map(e => {
  const start = e.date ? new Date(e.date + 'T00:00') : new Date('2099-12-31');
  const end = (e.endDate && e.endDate !== '') ? new Date(e.endDate + 'T00:00') : start;
  const isEthLima = (e.organizer || '').toLowerCase().includes('eth lima') || 
                    (e.organizer || '').toLowerCase().includes('ethereum lima') ||
                    (e.tags || []).some(t => t.toLowerCase() === 'ethlima');
  const isPast = end < now;
  return {
    ...e,
    _isEthLima: isEthLima,
    _isPast: isPast,
    _dateObj: start
  };
});

// Segment events — sub-events (parentId set) are excluded from all main grids
const upcoming = processedEvents.filter(e => !e._isPast && !e.parentId).sort((a, b) => a._dateObj.getTime() - b._dateObj.getTime());
const ethLimaUpcoming = upcoming.filter(e => e._isEthLima);
const communityUpcoming = upcoming.filter(e => !e._isEthLima);

const past = processedEvents.filter(e => e._isPast && !e.parentId).sort((a, b) => b._dateObj.getTime() - a._dateObj.getTime());

// Compute statistics
const totalCount = processedEvents.length;
const upcomingCount = upcoming.length;
const categoriesCount = new Set(processedEvents.map(e => e.type.toLowerCase())).size;

// Unique organizers list
const organizers = [...new Set(processedEvents.map(e => e.organizer).filter(Boolean))];
const organizerGradients = [
  'linear-gradient(135deg, #627eea 0%, #a78bfa 100%)',
  'linear-gradient(135deg, #10b981 0%, #34d399 100%)',
  'linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%)',
  'linear-gradient(135deg, #ec4899 0%, #f472b6 100%)',
  'linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%)',
  'linear-gradient(135deg, #2dd4bf 0%, #5eead4 100%)'
];
// All members for carousel — auto-syncs with members.json (sorted by role priority)
const allMembers = (membersRaw as MemberItem[]).sort((a, b) => {
  const ai = ROLE_ORDER.indexOf(a.role);
  const bi = ROLE_ORDER.indexOf(b.role);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});
---

<Layout title="ETH Events — Comunidad" description="Plataforma de eventos Web3 descentralizada y abierta. Suma tu evento a través de GitHub.">
  <Header showViewToggle={true} />

  <!-- HERO SECTION WITH INTERACTIVE 3D MESH -->
  <section id="hero-section" class="hero text-center py-32 px-6 w-full relative overflow-hidden z-10 mb-10 group border-b border-white/5">
    <!-- Mesh Gradient Background (CSS Only) -->
    <div class="absolute inset-0 z-0 opacity-40">
      <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[70%] bg-accent/30 blur-[100px] rounded-full mix-blend-screen animate-pulse"></div>
      <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[70%] bg-purple-600/30 blur-[120px] rounded-full mix-blend-screen animate-pulse" style="animation-delay: 2s;"></div>
      <div class="absolute top-[20%] right-[10%] w-[40%] h-[50%] bg-blue-500/20 blur-[90px] rounded-full mix-blend-screen animate-pulse" style="animation-delay: 1s;"></div>
    </div>
    
    <div class="absolute inset-0 z-0 bg-background/80 backdrop-blur-[2px]"></div>

    <!-- Interactive Canvas in Hero background -->
    <canvas id="hero-network-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-30 mix-blend-screen transition-opacity duration-500 group-hover:opacity-60 z-0"></canvas>
    
    <div class="relative z-10 flex flex-col items-center">
      <!-- Ethereum Lima Badge -->
      <div class="hero-tag inline-flex items-center gap-3 font-mono text-[11px] text-accent-2 tracking-[0.25em] bg-surface-2 border border-accent/20 rounded-full px-5 py-2.5 mb-10 shadow-neon animate-modal-fade select-none backdrop-blur-md">
        <span class="w-2.5 h-2.5 rounded-full bg-accent-2 animate-pulse shadow-[0_0_10px_#627eea]"></span>
        ORGANIZACIÓN ETHEREUM LIMA
      </div>
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-extrabold tracking-tight mb-8 leading-[1.1] text-content-primary max-w-4xl px-2">
        <span data-i18n="hero_title_main">Súmate a la</span> <span class="bg-gradient-to-r from-accent via-purple-400 to-accent bg-[length:200%_auto] bg-clip-text text-transparent animate-shimmer" data-i18n="hero_title_span">Comunidad</span>
      </h1>
      <p class="text-lg md:text-xl text-content-secondary max-w-2xl mx-auto mb-12 leading-relaxed font-sans" data-i18n="hero_subtitle">
        La plataforma oficial para descubrir y publicar eventos de la comunidad Web3 en el Perú.
      </p>
      
      <div class="flex justify-center">
        <a href="/submit" class="btn-primary group flex items-center gap-2 px-8 py-4 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-2xl shadow-[0_0_30px_rgba(98,126,234,0.3)] hover:-translate-y-1 hover:shadow-[0_0_50px_rgba(98,126,234,0.5)] transition-all duration-500" data-i18n="btn_propose">
          <svg class="w-5 h-5 transition-transform duration-500 group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
          PROPONER EVENTO
        </a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div id="stats-bar-section">
    <StatsBar total={totalCount} upcoming={upcomingCount} categories={categoriesCount} />
  </div>

  <!-- MAIN EVENT LAYOUTS -->
  <main class="max-w-[1400px] mx-auto px-6 md:px-10 pb-20 relative z-10" id="events">
    
    <!-- ETH LIMA EVENTS SECTION -->
    {ethLimaUpcoming.length > 0 && (
      <div id="eth-lima-container" class="mb-16">
        <div class="flex items-center justify-between gap-4 mb-8">
          <h2 class="text-2xl md:text-3xl font-extrabold text-white" data-i18n="sec_eth_lima">
            Eventos <span class="text-accent">ETH Lima</span>
          </h2>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="eth-lima-grid">
          {ethLimaUpcoming.map(event => (
            <EventCard event={event} showImage={true} class="eth-lima-item-card" />
          ))}
        </div>
        
        {ethLimaUpcoming.length > 4 && (
          <div class="flex justify-center mt-10" id="eth-lima-more-container">
            <button class="flex flex-wrap justify-center items-center gap-2 px-4 sm:px-6 py-3 border border-white/10 hover:border-accent hover:bg-accent/15 text-muted hover:text-white font-mono text-[10px] sm:text-xs font-bold text-center rounded-3xl transition-all w-full max-w-sm sm:max-w-none sm:w-auto" id="btn-see-all-eth-lima" data-i18n="btn_see_all_eth">
              VER TODOS LOS EVENTOS ETH LIMA
              <svg class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
        )}
      </div>
    )}

    <!-- COMMUNITY EVENTS SECTION -->
    <div class="mb-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 min-w-0 w-full">
        <h2 class="text-2xl md:text-3xl font-extrabold text-white shrink-0" data-i18n="sec_community">
          Eventos de la <span class="text-accent">Comunidad</span>
        </h2>
        <div class="min-w-0 w-full flex-1">
          <FilterBar />
        </div>
      </div>

      <!-- List/Grid Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="events-grid">
        {communityUpcoming.map(event => (
          <EventCard event={event} class="community-item-card" />
        ))}
      </div>

      <!-- See More Button -->
      {communityUpcoming.length > 16 && (
        <div class="flex justify-center mt-10" id="community-more-container">
          <button class="flex flex-wrap justify-center items-center gap-2 px-4 sm:px-6 py-3 border border-white/10 hover:border-accent hover:bg-accent/15 text-muted hover:text-white font-mono text-[10px] sm:text-xs font-bold text-center rounded-3xl transition-all w-full max-w-sm sm:max-w-none sm:w-auto" id="btn-see-all-community" data-i18n="btn_see_all">
            VER TODOS LOS EVENTOS
            <svg class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>
      )}

      <!-- Calendar View -->
      <Calendar />
    </div>

    <!-- PAST EVENTS SECTION -->
    {past.length > 0 && (
      <div id="past-events" class="mt-20 pt-16 border-t border-white/5">
        <div class="mb-8">
          <h2 class="text-xl md:text-2xl font-extrabold text-muted" data-i18n="sec_past">
            Eventos <span class="text-accent/80">Pasados</span>
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="past-events-grid">
          {past.map(event => (
            <EventCard event={event} isPast={true} class="past-item-card" />
          ))}
        </div>
        
        {past.length > 8 && (
          <div class="flex justify-center mt-10" id="past-more-container">
            <button class="flex items-center gap-2 px-6 py-3 border border-transparent bg-white/[0.03] hover:bg-white/[0.08] text-muted hover:text-white font-mono text-xs font-bold rounded-full transition-all" id="btn-see-all-past" data-i18n="btn_see_more_past">
              MOSTRAR MÁS EVENTOS PASADOS
              <svg class="w-4.5 h-4.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
        )}
      </div>
    )}

    <!-- ORGANIZERS SECTION -->
    {organizers.length > 0 && (
      <div class="mt-20 p-8 bg-white/[0.01] border border-white/5 rounded-3xl backdrop-blur-md" id="organizers-section">
        <div class="font-mono text-[11px] text-muted tracking-[0.2em] mb-8 text-center uppercase">
          ORGANIZADORES
        </div>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12" id="organizers-list">
          {organizers.map((name, i) => {
            const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            const gradient = organizerGradients[i % organizerGradients.length];
            return (
              <div class="flex flex-col items-center gap-2 group cursor-pointer transition-transform duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center font-mono font-bold text-lg text-white border border-white/10 relative overflow-hidden shadow-lg group-hover:scale-105 transition-transform" style={{ background: gradient }}>
                  {initials}
                  <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent" />
                </div>
                <div class="font-mono text-[10px] text-muted text-center max-w-[80px] leading-tight group-hover:text-white transition-colors">
                  {name}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- HOW IT WORKS SECTION -->
    <!-- TEAM MEMBERS CAROUSEL -->
    <div class="mt-20 py-16 border-t border-white/5" id="how">
      <div class="text-center mb-12">
        <p class="font-mono text-[11px] text-accent tracking-widest font-bold uppercase mb-3">COMUNIDAD</p>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white">
          Personas que lo hacen <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-2">posible</span>
        </h2>
      </div>

      <!-- Carousel wrapper -->
      <div class="relative overflow-hidden" id="team-carousel-wrapper">
        <!-- Fade edges -->
        <div class="absolute left-0 top-0 h-full w-16 z-10 pointer-events-none bg-gradient-to-r from-bg to-transparent"></div>
        <div class="absolute right-0 top-0 h-full w-16 z-10 pointer-events-none bg-gradient-to-l from-bg to-transparent"></div>

        <div class="flex gap-6 cursor-grab active:cursor-grabbing select-none" id="team-track" style="width: max-content;">
          {[...allMembers, ...allMembers].map((m, i) => (
            <div class="team-card flex-shrink-0 w-52 group" key={i}>
              <div class="relative overflow-hidden rounded-2xl aspect-[3/4] mb-4 bg-surface border border-white/5 group-hover:border-accent/30 transition-all duration-500">
                {m.photo && m.photo.trim() !== '' ? (
                  <img
                    src={m.photo}
                    alt={m.name}
                    class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-b from-accent/10 to-accent/5">
                    <img src="/EthLimalogo.svg" alt="Ethereum Lima" class="w-20 h-20 opacity-30" />
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-end p-4">
                  {m.social?.x && (
                    <a href={m.social.x} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()"
                      class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all border border-white/10">
                      <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L2.017 2.25H8.08l4.261 5.636 5.903-5.636Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
              <div class="px-1">
                <p class="font-bold text-white text-sm leading-snug">{m.name}</p>
                <p class="font-mono text-[10px] text-muted mt-0.5 uppercase tracking-wider">{m.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-center mt-12 px-4">
        <a href="/proyectos" class="group flex flex-wrap justify-center items-center gap-3 px-6 sm:px-8 py-3 sm:py-4 bg-white/5 hover:bg-accent/10 border border-white/10 hover:border-accent/40 text-white font-mono text-[11px] sm:text-sm font-bold text-center rounded-xl transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(98,126,234,0.2)] w-full max-w-sm sm:max-w-none sm:w-auto">
          <svg class="w-4 sm:w-5 h-4 sm:h-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
          </svg>
          VER PROYECTOS
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>

    <script>
      (() => {
        const track = document.getElementById('team-track');
        if (!track) return;

        let isPaused = false;
        let isDragging = false;
        let startX = 0;
        let scrollStart = 0;
        let pos = 0;
        let speed = 0.6; // px per frame
        let raf: number;

        const halfWidth = track.scrollWidth / 2;

        function animate() {
          if (!isPaused && !isDragging) {
            pos += speed;
            if (pos >= halfWidth) pos -= halfWidth;
            track.style.transform = `translateX(-${pos}px)`;
          }
          raf = requestAnimationFrame(animate);
        }

        animate();

        // Pause on hover
        const wrapper = document.getElementById('team-carousel-wrapper');
        wrapper?.addEventListener('mouseenter', () => isPaused = true);
        wrapper?.addEventListener('mouseleave', () => isPaused = false);

        // Drag to scroll
        track.addEventListener('mousedown', (e) => {
          isDragging = true;
          startX = e.clientX;
          scrollStart = pos;
          track.style.cursor = 'grabbing';
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          const delta = startX - e.clientX;
          pos = scrollStart + delta;
          if (pos < 0) pos = 0;
          if (pos >= halfWidth) pos -= halfWidth;
          track.style.transform = `translateX(-${pos}px)`;
        });

        window.addEventListener('mouseup', () => {
          if (isDragging) {
            isDragging = false;
            track.style.cursor = 'grab';
          }
        });

        // Touch support
        track.addEventListener('touchstart', (e) => {
          isDragging = true;
          startX = e.touches[0].clientX;
          scrollStart = pos;
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          const delta = startX - e.touches[0].clientX;
          pos = scrollStart + delta;
          if (pos < 0) pos = 0;
          if (pos >= halfWidth) pos -= halfWidth;
          track.style.transform = `translateX(-${pos}px)`;
        }, { passive: true });

        window.addEventListener('touchend', () => { isDragging = false; });
      })();
    </script>

  </main>

  <!-- FOOTER -->
  <footer class="mt-auto py-14 px-6 border-t border-white/5 bg-[#030407] relative z-10">
    <div class="max-w-[1400px] mx-auto">
      <!-- Top section -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-10">
        <!-- Logo + tagline -->
        <div class="flex flex-col items-center md:items-start gap-3">
          <div class="flex items-center gap-3">
            <img src="/EthLimalogo.svg" alt="Ethereum Lima Logo" class="h-10 w-auto" loading="lazy" />
          </div>
        </div>

        <!-- Social links -->
        <div class="flex items-center gap-4">
          <a href="https://x.com/EthereumLima" target="_blank" rel="noopener noreferrer" class="group w-10 h-10 rounded-xl bg-white/[0.03] border border-white/5 flex items-center justify-center hover:bg-accent/10 hover:border-accent/30 transition-all duration-300" aria-label="Twitter / X">
            <svg class="w-4 h-4 text-muted group-hover:text-accent-2 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://t.me/ethereumlima" target="_blank" rel="noopener noreferrer" class="group w-10 h-10 rounded-xl bg-white/[0.03] border border-white/5 flex items-center justify-center hover:bg-accent/10 hover:border-accent/30 transition-all duration-300" aria-label="Telegram">
            <svg class="w-4 h-4 text-muted group-hover:text-accent-2 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </a>
          <a href="https://github.com/javierarteagagonzales/ethevents" target="_blank" rel="noopener noreferrer" class="group w-10 h-10 rounded-xl bg-white/[0.03] border border-white/5 flex items-center justify-center hover:bg-accent/10 hover:border-accent/30 transition-all duration-300" aria-label="GitHub">
            <svg class="w-4 h-4 text-muted group-hover:text-accent-2 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href="mailto:hola@ethlima.org" class="group w-10 h-10 rounded-xl bg-white/[0.03] border border-white/5 flex items-center justify-center hover:bg-accent/10 hover:border-accent/30 transition-all duration-300" aria-label="Email">
