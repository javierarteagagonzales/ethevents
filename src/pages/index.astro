<script>
  // ──────────────────────────────────────────────
  // MOTION CHOREOGRAPHY (Intersection Observer)
  // ──────────────────────────────────────────────
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Initialize reveal classes
  document.addEventListener('DOMContentLoaded', () => {
    // Reveal sections
    const sections = document.querySelectorAll('section, main > div');
    sections.forEach((el, index) => {
      el.classList.add('reveal-hidden');
      el.style.transitionDelay = `${index * 100}ms`;
      observer.observe(el);
    });

    // Reveal cards with stagger
    const cards = document.querySelectorAll('.event-card');
    cards.forEach((el, index) => {
      el.classList.add('reveal-hidden');
      // Calculate stagger based on grid position (approximate)
      const staggerDelay = (index % 4) * 150;
      el.style.transitionDelay = `${staggerDelay}ms`;
      observer.observe(el);
    });
  });

  // ──────────────────────────────────────────────
