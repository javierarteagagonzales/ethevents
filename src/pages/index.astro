      how_support_step: "SOPORTE",
      how_support_title: "¿Algún problema?",
      how_support_desc: "Escríbenos a hola@ethlima.org y te ayudaremos con el proceso.",
      filter_all: "TODOS",
      card_more_info: "VER MÁS →",
      card_reserve: "RESERVAR →",
      modal_date: "Fecha",
      modal_time: "Hora",
      modal_location: "Ubicación",
      modal_organizer: "Organiza",
      modal_btn_access: "ACCEDER AL EVENTO",
      confirm_date: "Por confirmar",
      confirm_loc: "Sin definir",
      organizer_community: "Comunidad",
      type_meetup: "MEETUP",
      type_conference: "CONFERENCE",
      type_workshop: "WORKSHOP",
      type_hackathon: "HACKATHON",
      type_bootcamp: "BOOTCAMP",
      type_buildathon: "BUILDATHON",
      type_cohorte: "COHORTE",
    },
    en: {
      nav_events: "EVENTS",
      nav_how: "HOW IT WORKS",
      nav_projects: "PROJECTS",
      nav_projects_sub: "// Our initiatives",
      nav_new: "+ NEW EVENT",
      sec_eth_lima: "<span>ETH Lima</span> Events",
      sec_community: "<span>Community</span> Events",
      sec_past: "<span>Past</span> Events",
      btn_see_all_eth: "SEE ALL ETH LIMA EVENTS",
      btn_see_all: "SEE ALL EVENTS",
      btn_see_more_past: "SHOW MORE PAST EVENTS",
      stat_events: "EVENTS",
      stat_upcoming: "UPCOMING",
      stat_types: "CATEGORIES",
      hero_title_main: "Join the",
      hero_title_span: "Community",
      hero_subtitle: "The official platform to discover and publish Web3 community events in Peru.",
      btn_propose: "PROPOSE EVENT",
      btn_github: "VIEW ON GITHUB",
      how_title: "How to add an event?",
      how_s1_step: "STEP 01",
      how_s1_title: "Click new event",
      how_s1_desc: "Press the '+ NEW EVENT' button to start the process via a simple form.",
      how_s2_step: "STEP 02",
      how_s2_title: "Fill the form",
      how_s2_desc: "Complete the form with event details (name, date, location, etc.).",
      how_s3_step: "STEP 03",
      how_s3_title: "Wait for approval",
      how_s3_desc: "The Ethereum Lima team will review your proposal. Once approved, it will be published automatically.",
      how_support_step: "SUPPORT",
      how_support_title: "Any problems?",
      how_support_desc: "Email us at hola@ethlima.org and we'll help you with the process.",
      filter_all: "ALL",
      card_more_info: "VIEW MORE →",
      card_reserve: "RESERVE →",
      modal_date: "Date",
      modal_time: "Time",
      modal_location: "Location",
