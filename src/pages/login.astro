---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const expectedUser = import.meta.env.ADMIN_USER || 'admin';
const expectedPass = import.meta.env.ADMIN_PASS || '';

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const user = data.get('username');
    const pass = data.get('password');

    if (user === expectedUser && pass === expectedPass) {
      // Set session cookie
      Astro.cookies.set('admin_session', expectedPass, {
        path: '/',
        httpOnly: true,
        secure: import.meta.env.PROD,
        sameSite: 'strict',
        maxAge: 60 * 60 * 24 // 1 day
      });
      return Astro.redirect('/admin-dashboard-secret');
    } else {
      error = 'Credenciales incorrectas.';
    }
  } catch (e) {
    error = 'Error al procesar la solicitud.';
  }
}

// Si ya tiene la cookie, mandarlo al dashboard
if (Astro.cookies.get('admin_session')?.value === expectedPass) {
  return Astro.redirect('/admin-dashboard-secret');
}
---

<Layout title="Admin Login — ETH Events" description="Ingreso exclusivo para organizadores.">
  <div class="relative min-h-screen flex items-center justify-center overflow-hidden w-full">
    
    <!-- Background effects -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent/20 rounded-full blur-[128px] pointer-events-none mix-blend-screen"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[30rem] h-[30rem] bg-accent-2/10 rounded-full blur-[128px] pointer-events-none mix-blend-screen"></div>

    <div class="w-full max-w-md p-8 relative z-10 animate-modal-fade">
      
      <!-- Card -->
      <div class="bg-surface/80 border border-white/10 rounded-3xl p-8 md:p-10 backdrop-blur-xl shadow-2xl relative overflow-hidden">
        
        <!-- Decoration lines -->
        <div class="absolute top-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-accent to-transparent opacity-50"></div>
        <div class="absolute bottom-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-accent-2 to-transparent opacity-50"></div>

        <div class="flex flex-col items-center mb-8">
          <img src="/EthLimalogo.svg" alt="ETH Lima" class="h-14 mb-4 drop-shadow-[0_0_15px_rgba(98,126,234,0.3)]" loading="lazy" decoding="async" />
          <h1 class="text-2xl font-extrabold text-white tracking-tight text-center">Admin Portal</h1>
          <p class="text-muted text-xs font-mono tracking-widest uppercase mt-2">Ethereum Lima</p>
        </div>

        {error && (
          <div class="mb-6 px-4 py-3 bg-danger/10 border border-danger/30 rounded-xl flex items-center gap-3 animate-shake">
            <span class="text-danger text-sm">✕</span>
            <span class="text-danger text-sm font-medium">{error}</span>
          </div>
        )}

        <form method="POST" class="space-y-5">
          <div class="space-y-2">
            <label for="username" class="block font-mono text-[10px] text-muted tracking-wider uppercase font-bold ml-1">Usuario</label>
            <div class="relative">
              <input 
                type="text" 
                id="username" 
                name="username" 
                required 
                placeholder="admin"
                class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 pl-11 text-sm text-white placeholder-muted/30 focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all"
              />
              <div class="absolute left-4 top-3.5 text-muted/50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label for="password" class="block font-mono text-[10px] text-muted tracking-wider uppercase font-bold ml-1">Contraseña</label>
            <div class="relative">
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                placeholder="••••••••"
                class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 pl-11 text-sm text-white placeholder-muted/30 focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all"
              />
              <div class="absolute left-4 top-3.5 text-muted/50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              </div>
            </div>
          </div>

          <button 
            type="submit" 
            class="w-full mt-2 bg-gradient-to-r from-accent to-accent-2 hover:from-accent-2 hover:to-accent text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-[0_0_20px_rgba(98,126,234,0.3)] hover:shadow-[0_0_30px_rgba(98,126,234,0.5)] active:scale-[0.98] flex justify-center items-center gap-2"
          >
            INGRESAR AL PANEL
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>

        <div class="mt-8 pt-6 border-t border-white/10 text-center">
          <a href="/" class="text-xs text-muted hover:text-white font-mono transition-colors">
            ← Volver a la comunidad
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }
    .animate-shake {
      animation: shake 0.3s ease-in-out;
    }
  </style>
</Layout>
