---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import eventsRaw from '../../events.json';
import membersRaw from '../../members.json';
import type { EventItem } from '../types/event';
import type { MemberItem, MemberSocial } from '../types/member';
import { ROLE_ORDER } from '../types/member';

const events = eventsRaw as EventItem[];
const members = membersRaw as MemberItem[];

// Filter only Ethereum Lima events
const ethLimaEvents = events.filter(e => {
  const isEthLima = (e.organizer || '').toLowerCase().includes('eth lima') ||
                    (e.organizer || '').toLowerCase().includes('ethereum lima') ||
                    (e.tags || []).some(t => t.toLowerCase() === 'ethlima');
  const isParent = !('parentId' in e) || (e as any).parentId === null || (e as any).parentId === undefined;
  return isEthLima && isParent;
}).sort((a, b) => {
  const da = a.date ? new Date(a.date + 'T00:00') : new Date('2099-12-31');
  const db = b.date ? new Date(b.date + 'T00:00') : new Date('2099-12-31');
  return db.getTime() - da.getTime();
});

// Build project data with members
const projectsData = ethLimaEvents.map(event => {
  const eventMembers = members
    .filter(m => m.events && m.events.some(e => e.eventId === event.id))
    .map(m => {
      const assignment = m.events.find(e => e.eventId === event.id);
      return { ...m, eventRole: assignment ? assignment.role : m.role };
    })
    .sort((a, b) => {
      const ai = ROLE_ORDER.indexOf(a.eventRole);
      const bi = ROLE_ORDER.indexOf(b.eventRole);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    });
  return { event, members: eventMembers };
});

const projectsJSON = JSON.stringify(projectsData.map(p => ({
  id: p.event.id,
  title: p.event.title,
  date: p.event.date,
  endDate: p.event.endDate || '',
  type: p.event.type,
  location: p.event.location,
  description: p.event.description,
  image: p.event.image || '',
  members: p.members.map(m => ({
    id: m.id,
    name: m.name,
    role: m.role,
    area: m.area || 'General',
    eventRole: m.eventRole,
    photo: m.photo,
    social: m.social
  }))
})));
---

<Layout title="Proyectos — Ethereum Lima" description="Conoce los proyectos y el equipo detrás de cada evento de Ethereum Lima.">
  <Header />

  <main class="max-w-[1400px] mx-auto px-4 md:px-10 py-10 relative z-10">
    <!-- PAGE HEADER -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2.5 font-mono text-[10px] text-accent-2 tracking-[0.2em] bg-accent/10 border border-accent/30 rounded-full px-5 py-2 mb-6 shadow-[0_0_20px_rgba(98,126,234,0.15)]">
        <span class="w-2 h-2 rounded-full bg-accent-2 animate-pulse shadow-[0_0_10px_#627eea]"></span>
        ETHEREUM LIMA
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Nuestros <span class="bg-gradient-to-r from-accent via-[#a78bfa] to-accent bg-[length:200%_auto] bg-clip-text text-transparent animate-shimmer">Proyectos</span>
      </h1>
      <p class="text-sm md:text-base text-muted max-w-xl mx-auto leading-relaxed">
        Explora cada evento organizado por Ethereum Lima y conoce al equipo que lo hace posible.
      </p>
    </div>

    <!-- TWO PANEL LAYOUT -->
    <div class="flex flex-col lg:flex-row gap-6" id="projects-app">

      <!-- LEFT: ACCORDION -->
      <div class="w-full lg:w-[380px] lg:min-w-[380px] flex flex-col gap-2" id="accordion-panel">
        <div class="font-mono text-[10px] text-muted tracking-wider uppercase font-bold mb-2 px-1">// SELECCIONA UN PROYECTO</div>
        <div class="flex flex-col gap-1.5 max-h-[75vh] overflow-y-auto pr-1 no-scrollbar" id="accordion-list">
          <!-- Generated by JS -->
        </div>
      </div>

      <!-- RIGHT: TEAM PANEL -->
      <div class="flex-1 min-h-[400px]" id="team-panel">
        <div id="team-placeholder" class="h-full flex items-center justify-center rounded-3xl border border-white/5 bg-surface backdrop-blur-xl">
          <div class="text-center p-8">
            <div class="text-4xl mb-4">👈</div>
            <p class="font-mono text-xs text-muted tracking-wider uppercase">Selecciona un proyecto para ver su equipo</p>
          </div>
        </div>
        <div id="team-content" class="hidden">
          <!-- Filled by JS -->
        </div>
      </div>
    </div>
  </main>

  <!-- Hidden data -->
  <div id="projects-data" data-projects={projectsJSON} class="hidden"></div>
</Layout>

<style>
  .accordion-item {
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-item:hover {
    border-color: rgba(98, 126, 234, 0.3);
    background: rgba(98, 126, 234, 0.05);
  }
  .accordion-item.active {
    border-color: rgba(98, 126, 234, 0.5);
    background: rgba(98, 126, 234, 0.08);
    box-shadow: 0 0 30px rgba(98, 126, 234, 0.1);
  }
  .accordion-item.active .accordion-arrow {
    transform: rotate(180deg);
  }

  .member-card {
    animation: memberFade 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes memberFade {
    from { opacity: 0; transform: translateY(15px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .member-photo {
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }
</style>

<script>
  const dataEl = document.getElementById('projects-data');
  let projects = JSON.parse(dataEl?.getAttribute('data-projects') || '[]');

  // LOCAL PREVIEW PARA ADMIN:
  // Si hay miembros en localStorage (del dashboard), sobreescribir para visualizar en tiempo real
  const localMembersStr = localStorage.getItem('eth_members_admin_list');
  if (localMembersStr) {
    try {
      const localMembers = JSON.parse(localMembersStr);
      const roleOrder = [
        'Lead de Eth Lima', 'Core Team', 'Coordinador de Tecnología', 
        'Coordinador de Logística', 'Coordinador de Alianzas', 
        'Coordinador de Comunicaciones', 'Lead del Proyecto', 'Voluntario'
      ];
      
      projects.forEach((proj: any) => {
        proj.members = localMembers
          .filter((m: any) => m.events && m.events.some((e: any) => e.eventId === proj.id))
          .map((m: any) => {
            const assignment = m.events.find((e: any) => e.eventId === proj.id);
            return { ...m, eventRole: assignment ? assignment.role : m.role };
          })
          .sort((a: any, b: any) => {
            const ai = roleOrder.indexOf(a.eventRole);
            const bi = roleOrder.indexOf(b.eventRole);
            return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
          });
      });
    } catch(e) {
      console.error("Error parsing local members data", e);
    }
  }

  const accordionList = document.getElementById('accordion-list');
  const teamPlaceholder = document.getElementById('team-placeholder');
  const teamContent = document.getElementById('team-content');

  let activeProjectId: number | null = null;

  const typeColors: Record<string, string> = {
    conference: 'bg-blue-500/10 text-blue-400 border-blue-500/25',
    workshop: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/25',
    hackathon: 'bg-amber-500/10 text-amber-400 border-amber-500/25',
    meetup: 'bg-purple-500/10 text-purple-400 border-purple-500/25',
    bootcamp: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/25',
    cohorte: 'bg-pink-500/10 text-pink-400 border-pink-500/25',
    buildathon: 'bg-teal-500/10 text-teal-400 border-teal-500/25',
  };

  const roleColors: Record<string, string> = {
    'Lead de Eth Lima': 'text-amber-400',
    'Core Team': 'text-accent-2',
    'Coordinador de Tecnología': 'text-emerald-400',
    'Coordinador de Logística': 'text-orange-400',
    'Coordinador de Alianzas': 'text-purple-400',
    'Coordinador de Comunicaciones': 'text-pink-400',
    'Lead del Proyecto': 'text-cyan-400',
    'Voluntario': 'text-muted',
  };

  function socialIcon(type: string): string {
    switch (type) {
      case 'x': return '𝕏';
      case 'instagram': return '📸';
      case 'linkedin': return '💼';
      default: return '🔗';
    }
  }

  function renderAccordion() {
    if (!accordionList) return;
    accordionList.innerHTML = '';

    projects.forEach((proj: any) => {
      const isActive = activeProjectId === proj.id;
      const pillClass = typeColors[proj.type?.toLowerCase()] || typeColors.meetup;
      const dateStr = proj.date
        ? new Date(proj.date + 'T00:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'short', year: 'numeric' })
        : 'TBD';

      const div = document.createElement('div');
      div.className = `accordion-item rounded-2xl border border-white/5 bg-surface backdrop-blur-xl p-4 ${isActive ? 'active' : ''}`;
      div.innerHTML = `
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="font-mono text-[9px] px-2 py-0.5 rounded-full uppercase border ${pillClass}">${proj.type}</span>
              <span class="font-mono text-[9px] text-muted">${dateStr}</span>
            </div>
            <h3 class="font-bold text-white text-sm leading-tight truncate">${proj.title}</h3>
            <p class="font-mono text-[9px] text-muted mt-1 flex items-center gap-1">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              ${proj.location || 'Online'}
            </p>
          </div>
          <div class="flex flex-col items-end gap-1.5">
            <span class="font-mono text-[9px] text-accent font-bold">${proj.members.length} 👤</span>
            <svg class="accordion-arrow w-4 h-4 text-muted transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>
      `;

      div.addEventListener('click', () => {
        if (activeProjectId === proj.id) {
          activeProjectId = null;
          renderAccordion();
          showPlaceholder();
        } else {
          activeProjectId = proj.id;
          renderAccordion();
          renderTeam(proj);
        }
      });

      accordionList.appendChild(div);
    });
  }

  function showPlaceholder() {
    if (teamPlaceholder) teamPlaceholder.classList.remove('hidden');
    if (teamContent) teamContent.classList.add('hidden');
  }

  function renderTeam(proj: any) {
    if (!teamContent) return;
    if (teamPlaceholder) teamPlaceholder.classList.add('hidden');
    teamContent.classList.remove('hidden');

    if (proj.members.length === 0) {
      teamContent.innerHTML = `
        <div class="rounded-3xl border border-white/5 bg-surface backdrop-blur-xl p-8">
          <div class="flex items-center gap-3 mb-6">
            ${proj.image ? `<img src="${proj.image}" alt="" class="w-10 h-10 rounded-xl object-cover"/>` : ''}
            <div>
              <h2 class="text-lg font-extrabold text-white">${proj.title}</h2>
              <p class="font-mono text-[10px] text-muted">${proj.date || 'TBD'}</p>
            </div>
          </div>
          <div class="flex items-center justify-center p-12 rounded-2xl border border-white/5 bg-black/20">
            <p class="font-mono text-xs text-muted">// Equipo aún no asignado para este proyecto.</p>
          </div>
        </div>
      `;
      return;
    }

    const membersHTML = proj.members.map((m: any, i: number) => {
      const roleColor = roleColors[m.eventRole || m.role] || 'text-muted';
      const socialLinks = Object.entries(m.social || {})
        .filter(([_, url]) => url && (url as string).trim() !== '')
        .map(([type, url]) => `<a href="${url}" target="_blank" rel="noopener" class="hover:scale-110 transition-transform text-sm" title="${type}">${socialIcon(type)}</a>`)
        .join('');

      const photoHTML = m.photo
        ? `<img src="${m.photo}" alt="${m.name}" class="member-photo w-full rounded-xl border border-white/10"/>`
        : `<div class="member-photo w-full rounded-xl border border-white/10 bg-surface-2 flex items-center justify-center text-3xl text-muted">${m.name.charAt(0).toUpperCase()}</div>`;

      return `
        <div class="member-card rounded-2xl border border-white/5 bg-surface backdrop-blur-xl p-4 flex flex-col items-center text-center gap-3 hover:border-accent/30 transition-all" style="animation-delay: ${i * 80}ms">
          <div class="w-24 h-24 rounded-xl overflow-hidden relative group">
            ${photoHTML}
            <div class="absolute inset-x-0 bottom-0 bg-black/60 backdrop-blur-sm p-1 text-[8px] font-mono font-bold uppercase tracking-widest text-white/90 translate-y-full group-hover:translate-y-0 transition-transform">
              Área: ${m.area || 'General'}
            </div>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="font-bold text-white text-sm">${m.name}</span>
            <span class="font-mono text-[10px] ${roleColor} font-bold uppercase tracking-wider">${m.eventRole || m.role}</span>
          </div>
          ${socialLinks ? `<div class="flex items-center gap-2.5">${socialLinks}</div>` : ''}
        </div>
      `;
    }).join('');

    teamContent.innerHTML = `
      <div class="rounded-3xl border border-white/5 bg-surface backdrop-blur-xl p-6 md:p-8">
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-white/5">
          ${proj.image ? `<img src="${proj.image}" alt="" class="w-12 h-12 rounded-xl object-cover border border-white/10"/>` : ''}
          <div class="flex-1">
            <h2 class="text-lg font-extrabold text-white">${proj.title}</h2>
            <p class="font-mono text-[10px] text-muted mt-0.5">${proj.location || 'Online'} · ${proj.date || 'TBD'}</p>
          </div>
          <span class="font-mono text-[10px] text-accent-2 font-bold bg-accent/10 border border-accent/25 px-3 py-1 rounded-full">${proj.members.length} miembros</span>
        </div>
        <p class="text-xs text-muted mb-6 leading-relaxed line-clamp-3">${(proj.description || '').substring(0, 200)}</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          ${membersHTML}
        </div>
      </div>
    `;
  }

  // Init
  renderAccordion();
  if (projects.length > 0) {
    activeProjectId = projects[0].id;
    renderAccordion();
    renderTeam(projects[0]);
  }
</script>
