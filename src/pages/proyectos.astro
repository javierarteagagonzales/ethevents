---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import eventsRaw from "../../events.json";
import membersRaw from "../../members.json";
import type { EventItem } from "../types/event";
import type { MemberItem, MemberSocial } from "../types/member";
import { ROLE_ORDER } from "../types/member";

const events = eventsRaw as EventItem[];
const members = membersRaw as MemberItem[];


// Filter only Ethereum Lima events
const ethLimaEvents = events
  .filter((e) => {
    const isEthLima =
      (e.organizer || "").toLowerCase().includes("eth lima") ||
      (e.organizer || "").toLowerCase().includes("ethereum lima") ||
      (e.tags || []).some((t) => t.toLowerCase() === "ethlima");
    const isParent =
      !("parentId" in e) ||
      (e as any).parentId === null ||
      (e as any).parentId === undefined;
    return isEthLima && isParent;
  })
  .sort((a, b) => {
    const da = a.date ? new Date(a.date + "T00:00") : new Date("2099-12-31");
    const db = b.date ? new Date(b.date + "T00:00") : new Date("2099-12-31");
    return db.getTime() - da.getTime();
  });

// Build project data with members
const projectsData = ethLimaEvents.map((event) => {
  const eventMembers = members
    .filter((m) => m.events && m.events.some((e) => e.eventId === event.id))
    .map((m) => {
      const assignment = m.events.find((e) => e.eventId === event.id);
      return { ...m, eventRole: assignment ? assignment.role : m.role };
    })
    .sort((a, b) => {
      const ai = ROLE_ORDER.indexOf(a.eventRole);
      const bi = ROLE_ORDER.indexOf(b.eventRole);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    });
  return { event, members: eventMembers };
});

const projectsJSON = JSON.stringify(
  projectsData.map((p) => ({
    id: p.event.id,
    title: p.event.title,
    date: p.event.date,
    endDate: p.event.endDate || "",
    type: p.event.type,
    location: p.event.location,
    description: p.event.description,
    image: p.event.image || "",
    members: p.members.map((m) => ({
      id: m.id,
      name: m.name,
      role: m.role,
      area: m.area || "General",
      eventRole: m.eventRole,
      photo: m.photo,
      social: m.social,
    })),
  }))
);
---

<Layout
  title="Proyectos — Ethereum Lima"
  description="Conoce los proyectos y el equipo detrás de cada evento de Ethereum Lima."
>
  <Header />

  <main class="max-w-[1400px] mx-auto px-4 md:px-10 py-10 relative z-10">
    <!-- PAGE HEADER -->
    <div class="text-center mb-12">
      <div
        class="inline-flex items-center gap-2.5 font-mono text-[10px] text-accent-2 tracking-[0.2em] bg-accent/10 border border-accent/30 rounded-full px-5 py-2 mb-6 shadow-[0_0_20px_rgba(98,126,234,0.15)]"
      >
        <span
          class="w-2 h-2 rounded-full bg-accent-2 animate-pulse shadow-[0_0_10px_#627eea]"
        ></span>
        ETHEREUM LIMA
      </div>
      <h1
        class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight"
      >
        <span data-i18n="proj_title_main">Nuestros</span> <span
          class="bg-gradient-to-r from-accent via-[#a78bfa] to-accent bg-[length:200%_auto] bg-clip-text text-transparent animate-shimmer"
          data-i18n="proj_title_span">Proyectos</span
        >
      </h1>
      <p
        class="text-sm md:text-base text-muted max-w-xl mx-auto leading-relaxed" data-i18n="proj_desc"
      >
        Explora cada evento organizado por Ethereum Lima y conoce al equipo que lo hace posible.
      </p>
    </div>

    <!-- TWO PANEL LAYOUT -->
    <div class="flex flex-col lg:flex-row gap-6 min-w-0" id="projects-app">
      <!-- LEFT: PROJECT SELECTOR -->
      <div
        class="w-full lg:w-[320px] xl:w-[380px] lg:min-w-[320px] xl:min-w-[380px] flex flex-col gap-2 min-w-0"
        id="project-selector-panel"
      >
        <div
          class="font-mono text-[10px] text-muted tracking-wider uppercase font-bold mb-2 px-1" data-i18n="proj_select"
        >
          // SELECCIONA UN PROYECTO
        </div>
        <div
          class="flex flex-col gap-3 lg:gap-2 overflow-y-auto max-h-[40vh] lg:max-h-[80vh] pb-2 lg:pb-8 pr-2 custom-scrollbar"
          id="project-list"
        >
          <!-- Generated by JS -->
        </div>
      </div>

      <!-- RIGHT: TEAM PANEL -->
      <div class="flex-1 min-h-[400px] min-w-0" id="team-panel">
        <div
          id="team-placeholder"
          class="h-full flex items-center justify-center rounded-3xl border border-accent/20 bg-gradient-to-br from-[#0c1020]/90 to-[#07090e]/90 backdrop-blur-xl"
        >
          <div class="text-center p-8">
            <div class="text-4xl mb-4">👈</div>
            <p class="font-mono text-xs text-muted tracking-wider uppercase" data-i18n="proj_select_team">
              Selecciona un proyecto para ver su equipo
            </p>
          </div>
        </div>
        <div id="team-content" class="hidden">
          <!-- Filled by JS -->
        </div>
      </div>
    </div>
  </main>

  <!-- Hidden data -->
  <div id="projects-data" data-projects={projectsJSON} class="hidden"></div>
</Layout>

<style>
  .project-item {
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-item:hover {
    border-color: rgba(98, 126, 234, 0.3);
    background: rgba(98, 126, 234, 0.05);
    transform: translateY(-2px);
  }
  .project-item.active {
    border-color: rgba(98, 126, 234, 0.5);
    background: rgba(98, 126, 234, 0.1);
    box-shadow: 0 8px 32px rgba(98, 126, 234, 0.15);
  }
  .project-item.active .arrow-icon {
    transform: rotate(90deg);
    background: #627eea;
    color: white;
  }

  .member-card {
    animation: memberFade 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes memberFade {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Custom thin scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .member-photo {
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }
</style>

<script>
  const dataEl = document.getElementById("projects-data");
  let projects = JSON.parse(dataEl?.getAttribute("data-projects") || "[]");

  // LOCAL PREVIEW PARA ADMIN:
  // Si hay miembros en localStorage (del dashboard) Y el administrador está autenticado, sobreescribir para visualizar en tiempo real
  const isAdminLogged = sessionStorage.getItem("eth_admin_logged") === "true";
  const localMembersStr = isAdminLogged
    ? localStorage.getItem("eth_members_admin_list")
    : null;
  if (localMembersStr) {
    try {
      const localMembers = JSON.parse(localMembersStr);
      // Migrate old format if exists for local preview robustness
      localMembers.forEach((m: any) => {
        if (m.eventIds && !m.events) {
          m.events = m.eventIds.map((id: number) => ({
            eventId: id,
            role: m.role || "Voluntario",
          }));
        }
      });

      const roleOrder = [
        "Lead de Eth Lima",
        "Core Team",
        "Coordinador de Tecnología",
        "Coordinador de Logística",
        "Coordinador de Alianzas",
        "Coordinadora de Comunicaciones",
        "Lead del Proyecto",
        "Voluntario",
      ];

      projects.forEach((proj: any) => {
        proj.members = localMembers
          .filter(
            (m: any) =>
              m.events && m.events.some((e: any) => e.eventId === proj.id)
          )
          .map((m: any) => {
            const assignment = m.events.find((e: any) => e.eventId === proj.id);
            return { ...m, eventRole: assignment ? assignment.role : m.role };
          })
          .sort((a: any, b: any) => {
            const ai = roleOrder.indexOf(a.eventRole);
            const bi = roleOrder.indexOf(b.eventRole);
            return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
          });
      });
    } catch (e) {
      console.error("Error parsing local members data", e);
    }
  }

  // I18N DICTIONARY
  const TRANSLATIONS: Record<string, Record<string, string>> = {
    es: {
      proj_title_main: "Nuestros",
      proj_title_span: "Proyectos",
      proj_desc: "Explora cada evento organizado por Ethereum Lima y conoce al equipo que lo hace posible.",
      proj_select: "// SELECCIONA UN PROYECTO",
      proj_select_team: "Selecciona un proyecto para ver su equipo",
      proj_members: "miembros",
      proj_no_team: "// Equipo aún no asignado para este proyecto.",
      proj_area: "Área:",
      nav_events: "EVENTOS",
      nav_how: "CÓMO FUNCIONA",
      nav_projects: "PROYECTOS",
      nav_projects_sub: "// Nuestras iniciativas",
      nav_new: "+ NUEVO EVENTO"
    },
    en: {
      proj_title_main: "Our",
      proj_title_span: "Projects",
      proj_desc: "Explore every event organized by Ethereum Lima and meet the team that makes it possible.",
      proj_select: "// SELECT A PROJECT",
      proj_select_team: "Select a project to see its team",
      proj_members: "members",
      proj_no_team: "// Team not yet assigned for this project.",
      proj_area: "Area:",
      nav_events: "EVENTS",
      nav_how: "HOW IT WORKS",
      nav_projects: "PROJECTS",
      nav_projects_sub: "// Our initiatives",
      nav_new: "+ NEW EVENT"
    }
  };

  let currentLang = localStorage.getItem('eth_events_lang') || 'es';

  function applyI18n() {
    const t = TRANSLATIONS[currentLang];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && t[key]) {
        el.innerHTML = t[key];
      }
    });
  }

  // Escuchar cambios de idioma del header si es posible
  window.addEventListener('storage', (e) => {
    if (e.key === 'eth_events_lang') {
      currentLang = e.newValue || 'es';
      applyI18n();
      renderProjectList();
      if (activeProjectId) {
        const p = projects.find((x:any) => x.id === activeProjectId);
        if (p) renderTeam(p);
      }
    }
  });

  const projectList = document.getElementById("project-list");
  const teamPlaceholder = document.getElementById("team-placeholder");
  const teamContent = document.getElementById("team-content");

  let activeProjectId: number | null = null;

  const typeColors: Record<string, string> = {
    conference: "bg-blue-500/10 text-blue-400 border-blue-500/25",
    workshop: "bg-emerald-500/10 text-emerald-400 border-emerald-500/25",
    hackathon: "bg-amber-500/10 text-amber-400 border-amber-500/25",
    meetup: "bg-purple-500/10 text-purple-400 border-purple-500/25",
    bootcamp: "bg-indigo-500/10 text-indigo-400 border-indigo-500/25",
    cohorte: "bg-pink-500/10 text-pink-400 border-pink-500/25",
    buildathon: "bg-teal-500/10 text-teal-400 border-teal-500/25",
  };

  const roleColors: Record<string, string> = {
    "Lead de Eth Lima": "text-amber-400",
    "Core Team": "text-accent-2",
    "Coordinador de Tecnología": "text-emerald-400",
    "Coordinador de Logística": "text-orange-400",
    "Coordinador de Alianzas": "text-purple-400",
    "Coordinadora de Comunicaciones": "text-pink-400",
    "Lead del Proyecto": "text-cyan-400",
    Voluntario: "text-muted",
  };

  function socialIcon(type: string): string {
    switch (type) {
      case "x":
        return '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>';
      case "instagram":
        return '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>';
      case "linkedin":
        return '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>';
      default:
        return '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
    }
  }

  function renderProjectList() {
    if (!projectList) return;
    projectList.innerHTML = "";

    projects.forEach((proj: any) => {
      const isActive = activeProjectId === proj.id;
      const pillClass =
        typeColors[proj.type?.toLowerCase()] || typeColors.meetup;
      const dateStr = proj.date
        ? new Date(proj.date + "T00:00").toLocaleDateString("es-PE", {
            day: "numeric",
            month: "short",
            year: "numeric",
          })
        : "TBD";

      const div = document.createElement("div");
      div.className = `project-item w-full rounded-2xl border border-white/5 bg-surface backdrop-blur-xl p-4 sm:p-5 ${
        isActive ? "active" : ""
      }`;
      div.innerHTML = `
        <div class="flex flex-col h-full gap-3">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[9px] px-2 py-0.5 rounded-full uppercase border ${pillClass}">${
        proj.type
      }</span>
            <span class="font-mono text-[9px] text-muted bg-white/5 px-2 py-0.5 rounded-full">${dateStr}</span>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-white text-sm md:text-base leading-tight line-clamp-2 mb-1.5">${
              proj.title
            }</h3>
            <p class="font-mono text-[10px] text-muted flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span class="truncate">${proj.location || "Online"}</span>
            </p>
          </div>
          <div class="flex items-center justify-between mt-2 pt-3 border-t border-white/5">
            <span class="font-mono text-[10px] text-muted flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-accent/50"></span> ${
              proj.members.length
            } ${TRANSLATIONS[currentLang].proj_members}</span>
            <div class="arrow-icon w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-muted transition-all duration-300">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </div>
          </div>
        </div>
      `;

      div.addEventListener("click", () => {
        if (activeProjectId !== proj.id) {
          activeProjectId = proj.id;
          renderProjectList();
          renderTeam(proj);
          // Scroll into view on mobile
          if (window.innerWidth < 1024) {
            document
              .getElementById("team-panel")
              ?.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });

      projectList.appendChild(div);
    });
  }

  function showPlaceholder() {
    if (teamPlaceholder) teamPlaceholder.classList.remove("hidden");
    if (teamContent) teamContent.classList.add("hidden");
  }

  function renderTeam(proj: any) {
    if (!teamContent) return;
    if (teamPlaceholder) teamPlaceholder.classList.add("hidden");
    teamContent.classList.remove("hidden");

    if (proj.members.length === 0) {
      teamContent.innerHTML = `
        <div class="rounded-3xl border border-accent/20 bg-gradient-to-br from-[#0c1020]/90 to-[#07090e]/90 backdrop-blur-xl p-6 sm:p-8 shadow-[0_8px_32px_rgba(98,126,234,0.05)] animate-fade-in">
          <div class="flex items-center gap-3 mb-6">
            ${
              proj.image
                ? `<img src="${proj.image}" alt="" class="w-10 h-10 rounded-xl object-cover flex-shrink-0 border border-white/10"/>`
                : ""
            }
            <div class="min-w-0">
              <h2 class="text-base sm:text-lg font-extrabold text-white leading-tight">${
                proj.title
              }</h2>
              <p class="font-mono text-[10px] text-muted mt-1">${
                proj.date || "TBD"
              }</p>
            </div>
          </div>
          <div class="flex items-center justify-center p-12 rounded-2xl border border-white/5 bg-black/20">
            <p class="font-mono text-xs text-muted">${TRANSLATIONS[currentLang].proj_no_team}</p>
          </div>
        </div>
      `;
      return;
    }

    const membersHTML = proj.members
      .map((m: any, i: number) => {
        const roleColor = roleColors[m.eventRole || m.role] || "text-muted";
        const socialLinks = Object.entries(m.social || {})
          .filter(([_, url]) => url && (url as string).trim() !== "")
          .map(
            ([type, url]) =>
              `<a href="${url}" target="_blank" rel="noopener" class="hover:scale-110 transition-transform text-sm" title="${type}">${socialIcon(
                type
              )}</a>`
          )
          .join("");

        const photoHTML = m.photo
          ? `<img src="${m.photo}" alt="${m.name}" class="member-photo w-full rounded-xl border border-white/10"/>`
          : `<div class="member-photo w-full rounded-xl border border-white/10 bg-surface-2 flex items-center justify-center text-3xl text-muted">${m.name
              .charAt(0)
              .toUpperCase()}</div>`;

        return `
        <div class="member-card rounded-2xl border border-white/5 bg-surface backdrop-blur-xl p-3 sm:p-4 flex flex-col items-center text-center gap-2 sm:gap-3 hover:border-accent/30 transition-all" style="animation-delay: ${
          i * 80
        }ms">
          <div class="w-16 h-16 sm:w-24 sm:h-24 rounded-xl overflow-hidden relative group flex-shrink-0">
            ${photoHTML}
            <div class="absolute inset-x-0 bottom-0 bg-black/60 backdrop-blur-sm p-1 text-[8px] font-mono font-bold uppercase tracking-widest text-white/90 translate-y-full group-hover:translate-y-0 transition-transform">
              ${TRANSLATIONS[currentLang].proj_area} ${m.area || "General"}
            </div>
          </div>
          <div class="flex flex-col gap-0.5 min-w-0 w-full">
            <span class="font-bold text-white text-[11px] sm:text-sm">${
              m.name
            }</span>
            <span class="font-mono text-[9px] sm:text-[10px] ${roleColor} font-bold uppercase tracking-wider line-clamp-2">${
          m.eventRole || m.role
        }</span>
          </div>
          ${
            socialLinks
              ? `<div class="flex items-center gap-2">${socialLinks}</div>`
              : ""
          }
        </div>
      `;
      })
      .join("");

    teamContent.innerHTML = `
      <div class="rounded-3xl border border-accent/20 bg-gradient-to-br from-[#0c1020]/90 to-[#07090e]/90 backdrop-blur-xl p-5 sm:p-6 md:p-8 shadow-[0_8px_32px_rgba(98,126,234,0.08)]">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mb-6 pb-4 border-b border-white/5">
          <div class="flex items-center gap-3 flex-1 min-w-0">
            ${
              proj.image
                ? `<img src="${proj.image}" alt="" class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl object-cover border border-white/10 flex-shrink-0"/>`
                : ""
            }
            <div class="min-w-0">
              <h2 class="text-base sm:text-lg font-extrabold text-white leading-tight">${
                proj.title
              }</h2>
              <p class="font-mono text-[9px] sm:text-[10px] text-muted mt-0.5">${
                proj.location || "Online"
              } · ${proj.date || "TBD"}</p>
            </div>
          </div>
          <div class="flex-shrink-0 self-start sm:self-auto">
            <span class="font-mono text-[9px] sm:text-[10px] text-accent-2 font-bold bg-accent/10 border border-accent/25 px-3 py-1.5 rounded-full inline-block">${
              proj.members.length
            } ${TRANSLATIONS[currentLang].proj_members}</span>
          </div>
        </div>
        <p class="text-xs text-muted mb-6 leading-relaxed line-clamp-3">${(
          proj.description || ""
        ).substring(0, 200)}</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4">
          ${membersHTML}
        </div>
      </div>
    `;
  }

  // Init
  applyI18n();
  renderProjectList();
  if (projects.length > 0) {
    activeProjectId = projects[0].id;
    renderProjectList();
    renderTeam(projects[0]);
  }
</script>
