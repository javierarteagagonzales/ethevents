---
import Layout from '../layouts/Layout.astro';
import eventsRaw from '../../events.json';
import type { EventItem } from '../types/event';

const events = eventsRaw as EventItem[];
---

<Layout title="Admin Portal — ETH Events" description="Panel de administración de eventos de Ethereum Lima.">
  <main class="w-full min-h-screen flex flex-col items-center justify-center p-6 relative z-10">
    
    <!-- LOGIN SCREEN -->
    <div id="login-container" class="w-full max-w-md bg-surface border border-white/5 rounded-3xl p-8 backdrop-blur-xl shadow-2xl relative overflow-hidden animate-modal-fade">
      <div class="absolute -top-10 -left-10 w-40 h-40 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-accent-2/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="text-center mb-8 relative z-10">
        <img src="/EthLimalogo.svg" alt="Ethereum Lima Logo" class="h-10 mx-auto mb-4" />
        <h1 class="text-2xl font-extrabold text-white">Panel de Administración</h1>
        <p class="text-xs text-muted mt-2">Ingresa tus credenciales de Ethereum Lima</p>
      </div>

      <form id="login-form" class="space-y-5 relative z-10">
        <div class="space-y-1.5">
          <label for="email" class="block font-mono text-[10px] text-muted tracking-wider uppercase font-bold">Correo Electrónico</label>
          <input
            type="email"
            id="email"
            required
            placeholder="usuario@dominio.com"
            class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-3 text-white placeholder-muted/50 focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all"
          />
        </div>
        <div class="space-y-1.5">
          <label for="password" class="block font-mono text-[10px] text-muted tracking-wider uppercase font-bold">Contraseña</label>
          <input
            type="password"
            id="password"
            required
            placeholder="••••••••"
            class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-3 text-white placeholder-muted/50 focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all"
          />
        </div>
        <div id="login-error" class="hidden text-xs text-danger font-mono bg-danger/10 border border-danger/25 rounded-lg p-3 text-center">
          Credenciales incorrectas
        </div>
        <button
          type="submit"
          class="w-full py-3.5 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-xl shadow-lg transition-all duration-300 flex items-center justify-center gap-2"
        >
          INGRESAR AL PANEL
        </button>
      </form>
    </div>

    <!-- DASHBOARD CONTAINER (HIDDEN BY DEFAULT) -->
    <div id="dashboard-container" class="w-full max-w-7xl hidden flex-col gap-6 animate-modal-fade my-6">
      
      <!-- HEADER -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 bg-surface border border-white/5 rounded-3xl backdrop-blur-xl">
        <div class="flex items-center gap-4">
          <img src="/EthLimalogo.svg" alt="Ethereum Lima Logo" class="h-8" />
          <div class="h-6 w-px bg-white/10 hidden sm:block"></div>
          <div>
            <h1 class="text-xl font-extrabold text-white">Event Manager</h1>
            <p class="text-xs text-muted font-mono">// contacto@ethlima.org</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button
            id="btn-copy-json"
            class="px-5 py-2.5 bg-surface-2 border border-white/5 hover:border-white/15 text-white font-mono text-xs font-bold rounded-xl transition-all flex items-center gap-2"
          >
            📋 COPIAR JSON
          </button>
          <button
            id="btn-download-json"
            class="px-5 py-2.5 bg-accent/25 border border-accent/40 hover:bg-accent/35 text-accent-2 font-mono text-xs font-bold rounded-xl transition-all shadow-[0_0_20px_rgba(98,126,234,0.1)] flex items-center gap-2"
          >
            📥 DESCARGAR EVENTS.JSON
          </button>
          <button
            id="btn-logout"
            class="px-5 py-2.5 bg-danger/10 border border-danger/25 hover:bg-danger/20 text-danger font-mono text-xs font-bold rounded-xl transition-all"
          >
            CERRAR SESIÓN
          </button>
        </div>
      </div>

      <!-- PENDING ISSUES SECTION -->
      <div id="pending-section" class="bg-surface border border-yellow-500/20 rounded-3xl p-6 md:p-8 backdrop-blur-xl flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 animate-pulse"></span>
          <h2 class="text-base font-extrabold text-white font-mono tracking-tight">Issues Pendientes de Aprobación</h2>
          <span id="pending-count" class="ml-auto px-2.5 py-0.5 rounded-full bg-yellow-400/10 border border-yellow-400/25 text-yellow-400 font-mono text-[10px] font-bold">0</span>
        </div>
        <p class="text-xs text-muted font-mono">// Estos son los issues abiertos en GitHub que aún no han sido aprobados o rechazados.</p>

        <div class="overflow-x-auto rounded-2xl border border-yellow-500/10 bg-black/20">
          <table class="w-full border-collapse text-left text-xs text-muted">
            <thead class="bg-surface-2 font-mono text-[10px] tracking-wider uppercase text-muted font-bold border-b border-white/5">
              <tr>
                <th class="p-4">#</th>
                <th class="p-4">Título</th>
                <th class="p-4">Descripción</th>
                <th class="p-4">Fecha Issue</th>
                <th class="p-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="pending-table-body" class="divide-y divide-white/5">
              <tr><td colspan="5" class="p-8 text-center text-muted font-mono">// Cargando issues pendientes...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- MAIN CRUD SECTION -->
      <div class="bg-surface border border-white/5 rounded-3xl p-6 md:p-8 backdrop-blur-xl flex flex-col gap-6">
        
        <!-- TABLE TOP CONTROLS -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div class="w-full sm:max-w-xs relative">
            <input
              type="text"
              id="search-input"
              placeholder="Buscar por título, ubicación..."
              class="w-full bg-surface-2 border border-white/5 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-muted/50 focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all"
            />
            <div class="absolute left-3 top-3 text-muted">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>

          <button
            id="btn-new-event"
            class="w-full sm:w-auto px-6 py-2.5 bg-accent hover:bg-accent-2 text-white font-mono text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-2"
          >
            ➕ AGREGAR EVENTO
          </button>
        </div>

        <!-- TABLE -->
        <div class="overflow-x-auto rounded-2xl border border-white/5 bg-black/20">
          <table class="w-full border-collapse text-left text-xs text-muted">
            <thead class="bg-surface-2 font-mono text-[10px] tracking-wider uppercase text-muted font-bold border-b border-white/5">
              <tr>
                <th class="p-4">ID</th>
                <th class="p-4">Título</th>
                <th class="p-4">Categoría</th>
                <th class="p-4">Fecha</th>
                <th class="p-4">Ubicación</th>
                <th class="p-4">Organiza</th>
                <th class="p-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="events-table-body" class="divide-y divide-white/5">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>

      </div>

    </div>

  </main>

  <!-- EVENT EDIT/ADD DIALOG (MODAL) -->
  <div id="crud-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-[#030407]/90 backdrop-blur-md animate-modal-fade">
    <div class="w-full max-w-2xl bg-surface border border-white/5 rounded-3xl p-6 md:p-8 relative shadow-2xl overflow-y-auto max-h-[90vh] no-scrollbar">
      <h2 id="modal-title" class="text-xl font-extrabold text-white mb-6">Editar Evento</h2>

      <form id="crud-form" class="space-y-4">
        <input type="hidden" id="event-id" />

        <div class="space-y-1">
          <label for="form-title" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Título *</label>
          <input type="text" id="form-title" required class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
        </div>

        <div class="space-y-1">
          <label for="form-desc" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Descripción *</label>
          <textarea id="form-desc" required rows="3" class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none min-h-[80px] resize-y"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-date" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Fecha Inicio *</label>
            <input type="date" id="form-date" required class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
          <div class="space-y-1">
            <label for="form-end-date" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Fecha Fin</label>
            <input type="date" id="form-end-date" class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-time" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Hora</label>
            <input type="text" id="form-time" placeholder="Ej: 19:00" class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
          <div class="space-y-1">
            <label for="form-type" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Categoría *</label>
            <select id="form-type" required class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none">
              <option value="meetup">Meetup</option>
              <option value="conference">Conference</option>
              <option value="workshop">Workshop</option>
              <option value="hackathon">Hackathon</option>
              <option value="bootcamp">Bootcamp</option>
              <option value="cohorte">Cohorte</option>
              <option value="buildathon">Buildathon</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-location" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Ubicación *</label>
            <input type="text" id="form-location" required class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
          <div class="space-y-1">
            <label for="form-organizer" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Organizador *</label>
            <input type="text" id="form-organizer" required class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-link" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Link de registro</label>
            <input type="url" id="form-link" class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
          <div class="space-y-1">
            <label for="form-tags" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Tags</label>
            <input type="text" id="form-tags" placeholder="ethereum, solidity" class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label for="form-parent-id" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">Evento Padre ID (Subevento)</label>
            <input type="number" id="form-parent-id" placeholder="Ej: 38" class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
          <div class="space-y-1">
            <label for="form-image" class="block font-mono text-[9px] text-muted tracking-wider uppercase font-bold">URL Imagen</label>
            <input type="url" id="form-image" placeholder="https://..." class="w-full bg-surface-2 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-white focus:border-accent outline-none" />
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-white/5">
          <button type="button" id="btn-close-modal" class="px-5 py-2.5 bg-surface-2 hover:bg-white/5 border border-white/5 text-muted hover:text-white font-mono text-xs font-bold rounded-xl transition-all">
            CANCELAR
          </button>
          <button type="submit" class="px-6 py-2.5 bg-accent hover:bg-accent-2 text-white font-mono text-xs font-bold rounded-xl transition-all shadow-md">
            GUARDAR EVENTO
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- EMBED INITIAL EVENTS RAW DATA -->
  <div id="raw-events-data" class="hidden" data-events={JSON.stringify(events)}></div>
</Layout>

<script>
  // ──────────────────────────────────────────────
  // STATE MANAGEMENT
  // ──────────────────────────────────────────────
  let eventsList: any[] = [];
  let filteredEvents: any[] = [];
  let searchQuery = '';

  // Web Crypto SHA-256 Hashing helper
  async function sha256(message: string): Promise<string> {
    const msgBuffer = new TextEncoder().encode(message);
    const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  // Target Hashed credentials (never stores plain-text in source control)
  // Email: contacto@ethlima.org
  // Password: 9ZLLJdiV4u!38hKN
  const TARGET_EMAIL_HASH = '1d3dfbb83353b3b2a3a8b8a088188e5fdcc47c1c45dd0fedd5f38658d9a99608';
  const TARGET_PASS_HASH = '580e817bf97a6304c4717c32e2204b81acc2dc62489f03b7b537498b55cc66b6';

  // Elements
  const loginContainer = document.getElementById('login-container');
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error');
  const dashboardContainer = document.getElementById('dashboard-container');
  const eventsTableBody = document.getElementById('events-table-body');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const btnNewEvent = document.getElementById('btn-new-event');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const crudModal = document.getElementById('crud-modal');
  const crudForm = document.getElementById('crud-form') as HTMLFormElement;
  const btnLogout = document.getElementById('btn-logout');
  const btnDownloadJson = document.getElementById('btn-download-json');
  const btnCopyJson = document.getElementById('btn-copy-json');

  // Modal Inputs
  const inputEventId = document.getElementById('event-id') as HTMLInputElement;
  const inputTitle = document.getElementById('form-title') as HTMLInputElement;
  const inputDesc = document.getElementById('form-desc') as HTMLTextAreaElement;
  const inputDate = document.getElementById('form-date') as HTMLInputElement;
  const inputEndDate = document.getElementById('form-end-date') as HTMLInputElement;
  const inputTime = document.getElementById('form-time') as HTMLInputElement;
  const inputType = document.getElementById('form-type') as HTMLSelectElement;
  const inputLocation = document.getElementById('form-location') as HTMLInputElement;
  const inputOrganizer = document.getElementById('form-organizer') as HTMLInputElement;
  const inputLink = document.getElementById('form-link') as HTMLInputElement;
  const inputTags = document.getElementById('form-tags') as HTMLInputElement;
  const inputParentId = document.getElementById('form-parent-id') as HTMLInputElement;
  const inputImage = document.getElementById('form-image') as HTMLInputElement;

  // Check login state on load
  const isLogged = sessionStorage.getItem('eth_admin_logged') === 'true';
  if (isLogged) {
    showDashboard();
  }

  // Handle Login
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim().toLowerCase();
    const pass = (document.getElementById('password') as HTMLInputElement).value;

    const emailHash = await sha256(email);
    const passHash = await sha256(pass);

    if (emailHash === TARGET_EMAIL_HASH && passHash === TARGET_PASS_HASH) {
      sessionStorage.setItem('eth_admin_logged', 'true');
      if (loginError) loginError.classList.add('hidden');
      showDashboard();
    } else {
      if (loginError) loginError.classList.remove('hidden');
    }
  });

  // Handle Logout
  btnLogout?.addEventListener('click', () => {
    sessionStorage.removeItem('eth_admin_logged');
    window.location.reload();
  });

  // Show Dashboard Portal
  async function showDashboard() {
    if (loginContainer) loginContainer.classList.add('hidden');
    if (dashboardContainer) dashboardContainer.classList.remove('hidden');

    // Load local list or build-time data
    const localData = localStorage.getItem('eth_events_admin_list');
    if (localData) {
      eventsList = JSON.parse(localData);
    } else {
      const rawDiv = document.getElementById('raw-events-data');
      if (rawDiv) {
        eventsList = JSON.parse(rawDiv.getAttribute('data-events') || '[]');
      }
    }

    // Events from events.json are considered approved by default
    eventsList.forEach(e => {
      if (!e.status) e.status = 'aprobado';
    });

    renderTable();
    await fetchPendingIssues();
  }

  // Fetch and render pending GitHub issues in the separate table
  const pendingIssuesMap = new Map();

  async function fetchPendingIssues() {
    const pendingBody = document.getElementById('pending-table-body');
    const pendingCount = document.getElementById('pending-count');
    if (!pendingBody) return;

    pendingBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-muted font-mono">// Cargando issues...</td></tr>`;

    try {
      const resp = await fetch('https://api.github.com/repos/javierarteagagonzales/ethevents/issues?state=open&labels=pendiente&per_page=50');
      if (!resp.ok) throw new Error('GitHub API error');
      const issues = await resp.json();

      // Store issue data in Map
      pendingIssuesMap.clear();
      issues.forEach((iss: any) => pendingIssuesMap.set(iss.number, iss));

      if (pendingCount) pendingCount.textContent = String(issues.length);

      if (issues.length === 0) {
        pendingBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-muted font-mono">// No hay issues pendientes. ✅</td></tr>`;
        return;
      }

      pendingBody.innerHTML = '';
      issues.forEach((issue: any) => {
        const createdAt = new Date(issue.created_at).toLocaleDateString('es-PE', { year: 'numeric', month: 'short', day: 'numeric' });
        const descText = (issue.body || '').replace(/\n/g, ' ').replace(/<[^>]*>/g, '').substring(0, 120);

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-yellow-500/5 transition-colors border-b border-white/5';

        const tdNum = document.createElement('td');
        tdNum.className = 'p-4 font-mono font-bold text-yellow-400';
        tdNum.textContent = `#${issue.number}`;

        const tdTitle = document.createElement('td');
        tdTitle.className = 'p-4';
        const titleWrap = document.createElement('div');
        titleWrap.className = 'flex flex-col gap-0.5';
        const titleSpan = document.createElement('span');
        titleSpan.className = 'font-bold text-white text-sm leading-tight';
        titleSpan.textContent = issue.title.replace(/^\[EVENTO\]\s*/i, '');
        const linkA = document.createElement('a');
        linkA.href = issue.html_url;
        linkA.target = '_blank';
        linkA.className = 'text-[9px] text-accent font-mono hover:underline';
        linkA.textContent = 'Ver en GitHub ↗';
        titleWrap.appendChild(titleSpan);
        titleWrap.appendChild(linkA);
        tdTitle.appendChild(titleWrap);

        const tdDesc = document.createElement('td');
        tdDesc.className = 'p-4 text-muted max-w-[200px] truncate';
        tdDesc.textContent = descText || '—';

        const tdDate = document.createElement('td');
        tdDate.className = 'p-4 font-mono text-muted';
        tdDate.textContent = createdAt;

        const tdActions = document.createElement('td');
        tdActions.className = 'p-4 text-right whitespace-nowrap';
        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'flex items-center justify-end gap-2';

        const btnApprove = document.createElement('button');
        btnApprove.className = 'px-3 py-1.5 bg-green-500/10 hover:bg-green-500/25 text-green-400 rounded-lg font-mono text-[10px] font-bold transition-all border border-green-500/20';
        btnApprove.textContent = '✓ APROBAR';
        btnApprove.addEventListener('click', () => approveIssue(issue.number));

        const btnReject = document.createElement('button');
        btnReject.className = 'px-3 py-1.5 bg-red-500/10 hover:bg-red-500/25 text-red-400 rounded-lg font-mono text-[10px] font-bold transition-all border border-red-500/20';
        btnReject.textContent = '✕ RECHAZAR';
        btnReject.addEventListener('click', () => rejectIssue(issue.number));

        actionsDiv.appendChild(btnApprove);
        actionsDiv.appendChild(btnReject);
        tdActions.appendChild(actionsDiv);

        tr.appendChild(tdNum);
        tr.appendChild(tdTitle);
        tr.appendChild(tdDesc);
        tr.appendChild(tdDate);
        tr.appendChild(tdActions);
        pendingBody.appendChild(tr);
      });

    } catch (err) {
      pendingBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-yellow-400/60 font-mono text-xs">// No se pudo conectar con GitHub API. Verifica tu conexión.</td></tr>`;
      console.error(err);
    }
  }

  function parseIssueBody(body: string) {
    const fields: Record<string, string> = {};
    const patterns: Record<string, RegExp> = {
      title: /### 📌 Nombre del Evento\s*\n(.+)/,
      description: /### 📝 Descripción\s*\n([\s\S]*?)(?=\n### )/,
      date: /### 🗓️ Fecha\s*\n(.+)/,
      endDate: /### 🗓️ Fecha de fin[^\n]*\n(.+)/,
      time: /### ⏰ Hora\s*\n(.+)/,
      location: /### 📍 Ubicación\s*\n(.+)/,
      type: /### 🏷️ Tipo de evento\s*\n(.+)/,
      link: /### 🔗 Link de registro[^\n]*\n(.+)/,
      tags: /### 🏷️ Tags\s*\n(.+)/,
      organizer: /### 👤 Organizador[^\n]*\n(.+)/,
      parentId: /### 🔗 Evento Padre ID[^\n]*\n(.+)/,
    };
    for (const [key, regex] of Object.entries(patterns)) {
      const match = body.match(regex);
      if (match && match[1] && !match[1].includes('_No response_')) {
        fields[key] = match[1].trim();
      }
    }
    return fields;
  }

  function approveIssue(num: number) {
    const issue = pendingIssuesMap.get(num);
    if (!issue) return;

    const parsed = parseIssueBody(issue.body || '');
    const cleanTitle = (parsed.title || issue.title).replace(/^\[EVENTO\]\s*/i, '');

    if (!eventsList.find(e => e.id === num)) {
      eventsList.push({
        id: num,
        title: cleanTitle,
        description: parsed.description || '',
        date: parsed.date || '',
        endDate: parsed.endDate || '',
        time: parsed.time || '',
        type: (parsed.type || 'meetup').toLowerCase(),
        location: parsed.location || '',
        organizer: parsed.organizer || '',
        link: parsed.link || '',
        tags: parsed.tags ? parsed.tags.split(',').map(t => t.trim().toLowerCase()).filter(Boolean) : [],
        parentId: parsed.parentId ? parseInt(parsed.parentId) : null,
        image: '',
        status: 'aprobado',
        state: 'open',
        issueNum: num,
        issueUrl: issue.html_url,
        createdAt: issue.created_at
      });
    } else {
      const ev = eventsList.find(e => e.id === num);
      if (ev) ev.status = 'aprobado';
    }
    saveState();
    fetchPendingIssues();
  }

  function rejectIssue(num: number) {
    if (!eventsList.find(e => e.id === num)) {
      eventsList.push({ id: num, title: `Issue #${num}`, status: 'rechazado' } as any);
    } else {
      const ev = eventsList.find(e => e.id === num);
      if (ev) ev.status = 'rechazado';
    }
    saveState();
    fetchPendingIssues();
  }

  // ──────────────────────────────────────────────
  // TABLE RENDERING & FILTERING
  // ──────────────────────────────────────────────
  function renderTable() {
    if (!eventsTableBody) return;
    eventsTableBody.innerHTML = '';

    filteredEvents = eventsList.filter(e => {
      const query = searchQuery.toLowerCase();
      return (
        (e.title || '').toLowerCase().includes(query) ||
        (e.location || '').toLowerCase().includes(query) ||
        (e.organizer || '').toLowerCase().includes(query) ||
        String(e.id).includes(query)
      );
    });

    // Sort descending by id
    filteredEvents.sort((a, b) => b.id - a.id);

    if (filteredEvents.length === 0) {
      eventsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="p-8 text-center text-muted font-mono">
            // No se encontraron eventos.
          </td>
        </tr>`;
      return;
    }

    filteredEvents.forEach(e => {
      const isSub = e.parentId !== undefined && e.parentId !== null;
      
      const typeClasses: Record<string, string> = {
        conference: 'bg-accent/10 text-accent border border-accent/25',
        workshop: 'bg-success/10 text-success border border-success/25',
        hackathon: 'bg-warning/10 text-warning border border-warning/25',
        meetup: 'bg-purple-500/10 text-purple-400 border border-purple-500/25',
        bootcamp: 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/25',
        cohorte: 'bg-pink-500/10 text-pink-400 border border-pink-500/25',
        buildathon: 'bg-teal-500/10 text-teal-400 border border-teal-500/25',
      };
      const pillClass = typeClasses[e.type.toLowerCase()] || 'bg-purple-500/10 text-purple-400 border border-purple-500/25';

      const tr = document.createElement('tr');
      tr.className = 'hover:bg-white/[0.02] transition-colors border-b border-white/5';
      tr.innerHTML = `
        <td class="p-4 font-mono font-bold text-white">${e.id}</td>
        <td class="p-4">
          <div class="flex flex-col gap-0.5">
            <span class="font-bold text-white text-sm leading-tight">${e.title}</span>
            ${isSub ? `<span class="text-[9px] text-accent-2 font-mono uppercase tracking-wider flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-accent-2 animate-pulse"></span>SUBEVENTO DE EVENTO #${e.parentId}</span>` : ''}
          </div>
        </td>
        <td class="p-4">
          <span class="font-mono text-[9px] px-2 py-0.5 rounded-full uppercase ${pillClass}">${e.type}</span>
        </td>
        <td class="p-4 font-mono">${e.date || 'TBD'}</td>
        <td class="p-4 truncate max-w-[120px]">${e.location || 'Online'}</td>
        <td class="p-4 font-bold text-white/80">${e.organizer || 'Comunidad'}</td>
        <td class="p-4 text-right whitespace-nowrap">
          <div class="flex items-center justify-end gap-2">
            <button class="btn-edit px-3 py-1.5 bg-accent/10 hover:bg-accent/20 text-accent-2 rounded-lg font-mono text-[10px] font-bold transition-all" data-id="${e.id}">EDITAR</button>
            <button class="btn-delete px-3 py-1.5 bg-danger/10 hover:bg-danger/20 text-danger rounded-lg font-mono text-[10px] font-bold transition-all" data-id="${e.id}">ELIMINAR</button>
          </div>
        </td>
      `;

      eventsTableBody.appendChild(tr);
    });

    // Attach row events
    eventsTableBody.querySelectorAll('.btn-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.getAttribute('data-id') || '0');
        openEditModal(id);
      });
    });

    eventsTableBody.querySelectorAll('.btn-approve').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.getAttribute('data-id') || '0');
        approveEvent(id);
      });
    });

    eventsTableBody.querySelectorAll('.btn-reject').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.getAttribute('data-id') || '0');
        rejectEvent(id);
      });
    });

    eventsTableBody.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.getAttribute('data-id') || '0');
        if (confirm(`¿Estás seguro de eliminar el evento #${id}?`)) {
          deleteEvent(id);
        }
      });
    });
  }

  // Search filter
  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value;
    renderTable();
  });

  // ──────────────────────────────────────────────
  // CRUD CONTROLS
  // ──────────────────────────────────────────────
  function saveState() {
    localStorage.setItem('eth_events_admin_list', JSON.stringify(eventsList));
    renderTable();
  }

  function approveEvent(id) {
    const ev = eventsList.find(e => e.id === id);
    if (ev) {
      ev.status = 'aprobado';
      saveState();
    }
  }

  function rejectEvent(id) {
    const ev = eventsList.find(e => e.id === id);
    if (ev) {
      ev.status = 'rechazado';
      saveState();
    }
  }


  // Open modal for adding
  btnNewEvent?.addEventListener('click', () => {
    document.getElementById('modal-title')!.textContent = 'Agregar Nuevo Evento';
    crudForm.reset();
    inputEventId.value = '';
    
    if (crudModal) {
      crudModal.classList.remove('hidden');
      crudModal.classList.add('flex');
    }
  });

  // Close modal
  btnCloseModal?.addEventListener('click', closeModal);
  crudModal?.addEventListener('click', (e) => {
    if (e.target === crudModal) closeModal();
  });

  function closeModal() {
    if (crudModal) {
      crudModal.classList.remove('flex');
      crudModal.classList.add('hidden');
    }
  }

  // Open modal for editing
  function openEditModal(id: number) {
    const event = eventsList.find(e => e.id === id);
    if (!event) return;

    document.getElementById('modal-title')!.textContent = `Editar Evento #${id}`;
    
    // Fill values
    inputEventId.value = String(event.id);
    inputTitle.value = event.title || '';
    inputDesc.value = event.description || '';
    inputDate.value = event.date || '';
    inputEndDate.value = event.endDate || '';
    inputTime.value = event.time || '';
    inputType.value = event.type || 'meetup';
    inputLocation.value = event.location || '';
    inputOrganizer.value = event.organizer || '';
    inputLink.value = event.link || '';
    inputTags.value = (event.tags || []).join(', ');
    inputParentId.value = event.parentId ? String(event.parentId) : '';
    inputImage.value = event.image || '';

    if (crudModal) {
      crudModal.classList.remove('hidden');
      crudModal.classList.add('flex');
    }
  }

  // Handle Form Submit (Save / Add)
  crudForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const idStr = inputEventId.value;
    const parentIdVal = inputParentId.value.trim() ? parseInt(inputParentId.value) : null;

    const eventData: any = {
      title: inputTitle.value.trim(),
      description: inputDesc.value.trim(),
      date: inputDate.value,
      endDate: inputEndDate.value || '',
      time: inputTime.value.trim(),
      type: inputType.value,
      location: inputLocation.value.trim(),
      organizer: inputOrganizer.value.trim(),
      link: inputLink.value.trim(),
      tags: inputTags.value.split(',').map(t => t.trim().toLowerCase()).filter(Boolean),
      parentId: parentIdVal,
      image: inputImage.value.trim()
    };

    if (idStr) {
      // Edit
      const id = parseInt(idStr);
      const index = eventsList.findIndex(e => e.id === id);
      if (index !== -1) {
        // Keep original issue state/metadata
        eventsList[index] = {
          ...eventsList[index],
          ...eventData,
          id
        };
      }
    } else {
      // Add new
      const nextId = eventsList.reduce((max, e) => Math.max(max, e.id), 0) + 1;
      const newEvent = {
        ...eventData,
        id: nextId,
        issueNum: nextId,
        state: 'open',
        status: 'pending',
        createdAt: new Date().toISOString()
      };
      eventsList.push(newEvent);
    }

    saveState();
    closeModal();
  });

  // ──────────────────────────────────────────────
  // JSON EXPORT CONTROLS
  // ──────────────────────────────────────────────
  // Download updated events.json
  btnDownloadJson?.addEventListener('click', () => {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(eventsList, null, 2));
    const dlAnchorElem = document.createElement('a');
    dlAnchorElem.setAttribute("href",     dataStr     );
    dlAnchorElem.setAttribute("download", "events.json");
    dlAnchorElem.click();
  });

  // Copy updated JSON to clipboard
  btnCopyJson?.addEventListener('click', () => {
    navigator.clipboard.writeText(JSON.stringify(eventsList, null, 2))
      .then(() => {
        alert('¡JSON de events.json copiado al portapapeles con éxito!');
      })
      .catch(err => {
        alert('Error al copiar el JSON: ' + err);
      });
  });
</script>
