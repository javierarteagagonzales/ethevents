---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import eventsRaw from "../../events.json";
import membersRaw from "../../members.json";
import type { EventItem } from "../types/event";
import type { MemberItem } from "../types/member";

import AdminSidebar from "../components/admin/AdminSidebar.astro";
import AdminWelcome from "../components/admin/AdminWelcome.astro";
import AdminIssues from "../components/admin/AdminIssues.astro";
import AdminEvents from "../components/admin/AdminEvents.astro";
import AdminMembers from "../components/admin/AdminMembers.astro";
import AdminEventModal from "../components/admin/AdminEventModal.astro";
import AdminMemberModal from "../components/admin/AdminMemberModal.astro";

const events = eventsRaw as EventItem[];
const membersData = membersRaw as MemberItem[];
---

<Layout
  title="Admin Portal — ETH Events"
  description="Panel de administración de eventos de Ethereum Lima."
>
  <main
    id="main-layout"
    class="w-full min-h-screen flex flex-col items-center justify-start p-6 relative z-10 transition-all"
  >
    <!-- DASHBOARD CONTAINER (visible — auth handled by middleware) -->
    <div
      id="dashboard-container"
      class="w-full max-w-[1400px] flex flex-col md:flex-row gap-6 animate-modal-fade my-6 items-start"
    >
      <!-- SIDEBAR -->
      <AdminSidebar />

      <!-- CONTENT AREA -->
      <div class="flex-1 w-full flex flex-col gap-6 min-w-0">
        <!-- INICIO SECTION -->
        <AdminWelcome />

        <!-- PENDING ISSUES SECTION -->
        <AdminIssues />

        <!-- MAIN CRUD SECTION: EVENTS -->
        <AdminEvents />

        <!-- MAIN CRUD SECTION: MEMBERS -->
        <AdminMembers />
      </div>
    </div>

    <!-- MODALS -->
    <AdminEventModal />
    <AdminMemberModal />
  <!-- EMBED INITIAL EVENTS RAW DATA -->
  <div id="raw-events-data" class="hidden" data-events={JSON.stringify(events)}>
  </div>
  <div
    id="raw-members-data"
    class="hidden"
    data-members={JSON.stringify(membersData)}
  >
  </div>
</Layout>

<script>
  // ──────────────────────────────────────────────
  // STATE MANAGEMENT
  // ──────────────────────────────────────────────
  let eventsList: any[] = [];
  let membersList: any[] = [];
  let filteredEvents: any[] = [];
  let searchQuery = "";

  // ── I18N ──────────────────────────────────────────
  const ADMIN_T: Record<string, Record<string, string>> = {
    es: {
      nav_home: '🏠 Inicio', nav_issues: '📌 Issues', nav_events: '📅 Eventos', nav_members: '👥 Miembros',
      btn_sync: '🔄 RECUPERAR DE ARCHIVOS', btn_copy: '📋 COPIAR EVENTOS',
      btn_dl_events: '📥 EVENTS.JSON', btn_dl_members: '📥 MEMBERS.JSON',
      btn_logout: '🚪 CERRAR SESIÓN', btn_new_event: '➕ AGREGAR EVENTO', btn_new_member: '➕ AGREGAR MIEMBRO',
      welcome_title: 'Bienvenido al Panel de Administración',
      welcome_desc: 'Desde este portal puedes gestionar la aprobación de eventos propuestos por la comunidad, administrar el catálogo completo de eventos de Ethereum Lima y gestionar al equipo y sus asignaciones.',
      issues_title: 'Issues Pendientes de Aprobación',
      issues_loading: '// Cargando issues...', issues_none: '// No hay issues pendientes. ✅',
      issues_error: '// No se pudo conectar con GitHub API. Verifica tu conexión.',
      col_id: 'ID', col_title: 'Título', col_desc: 'Descripción', col_date: 'Fecha', col_actions: 'Acciones',
      col_cat: 'Categoría', col_location: 'Ubicación', col_org: 'Organiza',
      col_photo: 'Foto', col_name: 'Nombre', col_role: 'Cargo', col_events: 'Eventos',
      btn_approve: '✓ APROBAR', btn_reject: '✕ RECHAZAR', btn_edit: 'EDITAR', btn_delete: 'ELIMINAR',
      no_events: '// No se encontraron eventos.', no_members: '// No se encontraron miembros.',
      modal_edit_event: 'Editar Evento', modal_new_event: 'Agregar Nuevo Evento',
      modal_edit_member: 'Editar Miembro', modal_new_member: 'Agregar Nuevo Miembro',
      btn_save_event: 'GUARDAR EVENTO', btn_cancel: 'CANCELAR', btn_save_member: 'GUARDAR MIEMBRO',
      confirm_sync: '¿Estás seguro de que quieres borrar la caché local y recargar los datos de los archivos JSON? Perderás cualquier cambio que no hayas guardado en el archivo.',
      confirm_del_event: '¿Estás seguro de eliminar el evento', confirm_del_member: '¿Estás seguro de eliminar el miembro',
      copied_ok: '¡JSON de events.json copiado al portapapeles con éxito!', copy_err: 'Error al copiar el JSON: ',
      credentials_error: 'Credenciales incorrectas', login_btn: 'INGRESAR AL PANEL',
      login_email_label: 'Correo Electrónico', login_pass_label: 'Contraseña',
      admin_portal: 'Admin Portal', subevent_of: 'SUBEVENTO DE EVENTO #',
      github_link: 'Ver en GitHub ↗', events_label: 'eventos', members_label: 'miembros',
      no_title: 'Sin Título', community: 'Comunidad'
    },
    en: {
      nav_home: '🏠 Home', nav_issues: '📌 Issues', nav_events: '📅 Events', nav_members: '👥 Members',
      btn_sync: '🔄 RESTORE FROM FILES', btn_copy: '📋 COPY EVENTS',
      btn_dl_events: '📥 EVENTS.JSON', btn_dl_members: '📥 MEMBERS.JSON',
      btn_logout: '🚪 LOG OUT', btn_new_event: '➕ ADD EVENT', btn_new_member: '➕ ADD MEMBER',
      welcome_title: 'Welcome to the Admin Panel',
      welcome_desc: 'From this portal you can manage community-proposed event approvals, administer the full Ethereum Lima event catalog, and manage the team and their assignments.',
      issues_title: 'Pending Issues for Approval',
      issues_loading: '// Loading issues...', issues_none: '// No pending issues. ✅',
      issues_error: '// Could not connect to GitHub API. Check your connection.',
      col_id: 'ID', col_title: 'Title', col_desc: 'Description', col_date: 'Date', col_actions: 'Actions',
      col_cat: 'Category', col_location: 'Location', col_org: 'Organizer',
      col_photo: 'Photo', col_name: 'Name', col_role: 'Role', col_events: 'Events',
      btn_approve: '✓ APPROVE', btn_reject: '✕ REJECT', btn_edit: 'EDIT', btn_delete: 'DELETE',
      no_events: '// No events found.', no_members: '// No members found.',
      modal_edit_event: 'Edit Event', modal_new_event: 'Add New Event',
      modal_edit_member: 'Edit Member', modal_new_member: 'Add New Member',
      btn_save_event: 'SAVE EVENT', btn_cancel: 'CANCEL', btn_save_member: 'SAVE MEMBER',
      confirm_sync: 'Are you sure you want to clear the local cache and reload data from JSON files? You will lose any unsaved changes.',
      confirm_del_event: 'Are you sure you want to delete event', confirm_del_member: 'Are you sure you want to delete member',
      copied_ok: 'events.json copied to clipboard successfully!', copy_err: 'Error copying JSON: ',
      credentials_error: 'Invalid credentials', login_btn: 'ENTER PANEL',
      login_email_label: 'Email Address', login_pass_label: 'Password',
      admin_portal: 'Admin Portal', subevent_of: 'SUBEVENT OF EVENT #',
      github_link: 'View on GitHub ↗', events_label: 'events', members_label: 'members',
      no_title: 'No Title', community: 'Community'
    }
  };
  let adminLang = localStorage.getItem('eth_events_lang') || 'es';
  const t = () => ADMIN_T[adminLang];
  window.addEventListener('storage', (e) => { if (e.key === 'eth_events_lang') { adminLang = e.newValue || 'es'; } });

  // Elements
  const dashboardContainer = document.getElementById("dashboard-container");
  const eventsTableBody = document.getElementById("events-table-body");
  const searchInput = document.getElementById(
    "search-input"
  ) as HTMLInputElement;

  // Event Elements
  const btnNewEvent = document.getElementById("btn-new-event");
  const btnCloseModal = document.getElementById("btn-close-modal");
  const crudModal = document.getElementById("crud-modal");
  const crudForm = document.getElementById("crud-form") as HTMLFormElement;

  // Member Elements
  const membersTableBody = document.getElementById("members-table-body");
  const btnNewMember = document.getElementById("btn-new-member");
  const btnCloseMemberModal = document.getElementById("btn-close-member-modal");
  const memberCrudModal = document.getElementById("member-crud-modal");
  const memberCrudForm = document.getElementById(
    "member-crud-form"
  ) as HTMLFormElement;
  const memberEventsContainer = document.getElementById(
    "member-events-container"
  );

  // Global Elements
  const btnLogout = document.getElementById("btn-logout");
  const btnDownloadJson = document.getElementById("btn-download-json");
  const btnCopyJson = document.getElementById("btn-copy-json");

  // Modal Inputs
  const inputEventId = document.getElementById("event-id") as HTMLInputElement;
  const inputTitle = document.getElementById("form-title") as HTMLInputElement;
  const inputDesc = document.getElementById("form-desc") as HTMLTextAreaElement;
  const inputDate = document.getElementById("form-date") as HTMLInputElement;
  const inputEndDate = document.getElementById(
    "form-end-date"
  ) as HTMLInputElement;
  const inputTime = document.getElementById("form-time") as HTMLInputElement;
  const inputType = document.getElementById("form-type") as HTMLSelectElement;
  const inputLocation = document.getElementById(
    "form-location"
  ) as HTMLInputElement;
  const inputOrganizer = document.getElementById(
    "form-organizer"
  ) as HTMLInputElement;
  const inputLink = document.getElementById("form-link") as HTMLInputElement;
  const inputVideoLink = document.getElementById("form-video-link") as HTMLInputElement;
  const inputTags = document.getElementById("form-tags") as HTMLInputElement;
  const inputParentId = document.getElementById(
    "form-parent-id"
  ) as HTMLInputElement;
  const inputImage = document.getElementById("form-image") as HTMLInputElement;

  // Auth is now handled by server middleware (HTTP Basic Auth)
  // Dashboard loads directly on page load
  showDashboard();

  // Handle Sync Files
  const btnSyncFiles = document.getElementById("btn-sync-files");
  btnSyncFiles?.addEventListener("click", () => {
    if (confirm(t().confirm_sync)) {
      localStorage.removeItem("eth_events_admin_list");
      localStorage.removeItem("eth_members_admin_list");
      window.location.reload();
    }
  });

  // Handle Logout — clears session cookie and redirects to login
  btnLogout?.addEventListener("click", () => {
    document.cookie = "admin_session=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
    window.location.href = '/login';
  });

  // Sidebar Navigation
  document.querySelectorAll(".nav-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      // Remove active from all
      document.querySelectorAll(".nav-btn").forEach((b) => {
        b.classList.remove("bg-white/5", "text-white", "border", "border-white/10");
        b.classList.add("text-muted");
      });
      // Add active to clicked
      btn.classList.add("bg-white/5", "text-white", "border", "border-white/10");
      btn.classList.remove("text-muted");

      // Hide all sections
      document.querySelectorAll(".dashboard-section").forEach((sec) => {
        sec.classList.add("hidden");
        sec.classList.remove("flex");
      });

      // Show target
      const targetId = btn.getAttribute("data-target");
      if (targetId) {
        const targetSec = document.getElementById(targetId);
        if (targetSec) {
          targetSec.classList.remove("hidden");
          targetSec.classList.add("flex");
        }
      }
    });
  });

  // Show Dashboard Portal
  async function showDashboard() {
    // Dashboard is already visible (auth handled by server middleware)

    const isLocalhost =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1";

    // Load local list or build-time data for events
    const localData = isLocalhost
      ? null
      : localStorage.getItem("eth_events_admin_list");
    if (localData) {
      eventsList = JSON.parse(localData);
    } else {
      const rawDiv = document.getElementById("raw-events-data");
      if (rawDiv) {
        eventsList = JSON.parse(rawDiv.getAttribute("data-events") || "[]");
      }
    }

    // Events from events.json are considered approved by default
    eventsList.forEach((e) => {
      if (!e.status) e.status = "aprobado";
    });

    // Load local list or build-time data for members
    const localMembersData = isLocalhost
      ? null
      : localStorage.getItem("eth_members_admin_list");
    if (localMembersData) {
      membersList = JSON.parse(localMembersData);
    } else {
      const rawMembersDiv = document.getElementById("raw-members-data");
      if (rawMembersDiv) {
        membersList = JSON.parse(
          rawMembersDiv.getAttribute("data-members") || "[]"
        );
      }
    }

    // Migrate old format if exists (convert eventIds array to events object array)
    let migrated = false;
    membersList.forEach((m: any) => {
      if (
        m.eventIds &&
        m.eventIds.length > 0 &&
        (!m.events || m.events.length === 0)
      ) {
        m.events = m.eventIds.map((id: number) => ({
          eventId: id,
          role: m.role || "Voluntario",
        }));
        migrated = true;
      }
    });

    if (migrated) {
      localStorage.setItem(
        "eth_members_admin_list",
        JSON.stringify(membersList)
      );
      saveToFile("members.json", membersList);
    }

    renderTable();
    renderMembersTable();
    await fetchPendingIssues();
  }

  // Fetch and render pending GitHub issues in the separate table
  const pendingIssuesMap = new Map();

  async function fetchPendingIssues() {
    const pendingBody = document.getElementById("pending-table-body");
    const pendingCount = document.getElementById("pending-count");
    if (!pendingBody) return;

    pendingBody.innerHTML = `
      ${[1,2,3].map(() => `<tr class="border-b border-white/5">
        <td class="p-4"><div class="h-4 w-10 bg-white/5 rounded-lg animate-pulse"></div></td>
        <td class="p-4"><div class="flex flex-col gap-2"><div class="h-4 w-40 bg-white/5 rounded-lg animate-pulse"></div><div class="h-3 w-24 bg-white/5 rounded-lg animate-pulse"></div></div></td>
        <td class="p-4"><div class="h-3 w-32 bg-white/5 rounded-lg animate-pulse"></div></td>
        <td class="p-4"><div class="h-3 w-20 bg-white/5 rounded-lg animate-pulse"></div></td>
        <td class="p-4"><div class="flex gap-2 justify-end"><div class="h-7 w-20 bg-white/5 rounded-lg animate-pulse"></div><div class="h-7 w-20 bg-white/5 rounded-lg animate-pulse"></div></div></td>
      </tr>`).join('')}
    `;

    try {
      let issues = [];
      const cacheKey = 'github_issues_cache';
      const cacheTimeKey = 'github_issues_cache_time';
      const cached = sessionStorage.getItem(cacheKey);
      const cacheTime = sessionStorage.getItem(cacheTimeKey);
      const now = new Date().getTime();
      
      // Cache valid for 5 minutes
      if (cached && cacheTime && (now - parseInt(cacheTime)) < 300000) {
        issues = JSON.parse(cached);
      } else {
        const resp = await fetch(
          "https://api.github.com/repos/javierarteagagonzales/ethevents/issues?state=open&labels=pendiente&per_page=50"
        );
        if (!resp.ok) throw new Error("GitHub API error");
        issues = await resp.json();
        sessionStorage.setItem(cacheKey, JSON.stringify(issues));
        sessionStorage.setItem(cacheTimeKey, now.toString());
      }

      // Store issue data in Map
      pendingIssuesMap.clear();
      issues.forEach((iss: any) => pendingIssuesMap.set(iss.number, iss));

      if (pendingCount) pendingCount.textContent = String(issues.length);
      const sidebarBadge = document.getElementById("sidebar-pending-badge");
      if (sidebarBadge) {
        if (issues.length > 0) sidebarBadge.classList.remove("hidden");
        else sidebarBadge.classList.add("hidden");
      }

      if (issues.length === 0) {
        pendingBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-muted font-mono">${t().issues_none}</td></tr>`;
        return;
      }

      pendingBody.innerHTML = "";
      issues.forEach((issue: any) => {
        const createdAt = new Date(issue.created_at).toLocaleDateString(
          "es-PE",
          { year: "numeric", month: "short", day: "numeric" }
        );
        const descText = (issue.body || "")
          .replace(/\n/g, " ")
          .replace(/<[^>]*>/g, "")
          .substring(0, 120);

        const tr = document.createElement("tr");
        tr.className =
          "hover:bg-yellow-500/5 transition-colors border-b border-white/5";

        const tdNum = document.createElement("td");
        tdNum.className = "p-4 font-mono font-bold text-yellow-400";
        tdNum.textContent = `#${issue.number}`;

        const tdTitle = document.createElement("td");
        tdTitle.className = "p-4";
        const titleWrap = document.createElement("div");
        titleWrap.className = "flex flex-col gap-0.5";
        const titleSpan = document.createElement("span");
        titleSpan.className = "font-bold text-white text-sm leading-tight";
        titleSpan.textContent = issue.title.replace(/^\[EVENTO\]\s*/i, "");
        const linkA = document.createElement("a");
        linkA.href = issue.html_url;
        linkA.target = "_blank";
        linkA.className = "text-[9px] text-accent font-mono hover:underline";
        linkA.textContent = t().github_link;
        titleWrap.appendChild(titleSpan);
        titleWrap.appendChild(linkA);
        tdTitle.appendChild(titleWrap);

        const tdDesc = document.createElement("td");
        tdDesc.className = "p-4 text-muted max-w-[200px] truncate";
        tdDesc.textContent = descText || "—";

        const tdDate = document.createElement("td");
        tdDate.className = "p-4 font-mono text-muted";
        tdDate.textContent = createdAt;

        const tdActions = document.createElement("td");
        tdActions.className = "p-4 text-right whitespace-nowrap";
        const actionsDiv = document.createElement("div");
        actionsDiv.className = "flex items-center justify-end gap-2";

        const btnApprove = document.createElement("button");
        btnApprove.className =
          "px-3 py-1.5 bg-green-500/10 hover:bg-green-500/25 text-green-400 rounded-lg font-mono text-[10px] font-bold transition-all border border-green-500/20";
        btnApprove.textContent = t().btn_approve;
        btnApprove.addEventListener("click", () => approveIssue(issue.number));

        const btnReject = document.createElement("button");
        btnReject.className =
          "px-3 py-1.5 bg-red-500/10 hover:bg-red-500/25 text-red-400 rounded-lg font-mono text-[10px] font-bold transition-all border border-red-500/20";
        btnReject.textContent = t().btn_reject;
        btnReject.addEventListener("click", () => rejectIssue(issue.number));

        actionsDiv.appendChild(btnApprove);
        actionsDiv.appendChild(btnReject);
        tdActions.appendChild(actionsDiv);

        tr.appendChild(tdNum);
        tr.appendChild(tdTitle);
        tr.appendChild(tdDesc);
        tr.appendChild(tdDate);
        tr.appendChild(tdActions);
        pendingBody.appendChild(tr);
      });
    } catch (err) {
      pendingBody.innerHTML = `<tr>
        <td colspan="5" class="p-12 text-center">
          <div class="flex flex-col items-center justify-center gap-3">
            <svg class="w-10 h-10 text-danger/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <span class="text-content-secondary font-mono text-xs">${t().issues_error}</span>
          </div>
        </td>
      </tr>`;
      console.error(err);
    }
  }

  function parseIssueBody(body: string) {
    const fields: Record<string, string> = {};
    const patterns: Record<string, RegExp> = {
      title: /### 📌 Nombre del Evento\s*\n(.+)/,
      description: /### 📝 Descripción\s*\n([\s\S]*?)(?=\n### )/,
      date: /### 🗓️ Fecha\s*\n(.+)/,
      endDate: /### 🗓️ Fecha de fin[^\n]*\n(.+)/,
      time: /### ⏰ Hora\s*\n(.+)/,
      location: /### 📍 Ubicación\s*\n(.+)/,
      type: /### 🏷️ Tipo de evento\s*\n(.+)/,
      link: /### 🔗 Link de registro[^\n]*\n(.+)/,
      videoLink: /### 🎥 Grabación[^\n]*\n(.+)/,
      tags: /### 🏷️ Tags\s*\n(.+)/,
      organizer: /### 👤 Organizador[^\n]*\n(.+)/,
      parentId: /### 🔗 Evento Padre ID[^\n]*\n(.+)/,
    };
    for (const [key, regex] of Object.entries(patterns)) {
      const match = body.match(regex);
      if (match && match[1] && !match[1].includes("_No response_")) {
        fields[key] = match[1].trim();
      }
    }
    return fields;
  }

  function approveIssue(num: number) {
    const issue = pendingIssuesMap.get(num);
    if (!issue) return;

    const parsed = parseIssueBody(issue.body || "");
    const cleanTitle = (parsed.title || issue.title).replace(
      /^\[EVENTO\]\s*/i,
      ""
    );

    if (!eventsList.find((e) => e.id === num)) {
      eventsList.push({
        id: num,
        title: cleanTitle,
        description: parsed.description || "",
        date: parsed.date || "",
        endDate: parsed.endDate || "",
        time: parsed.time || "",
        type: (parsed.type || "meetup").toLowerCase(),
        location: parsed.location || "",
        organizer: parsed.organizer || "",
        link: parsed.link || "",
        videoLink: parsed.videoLink || "",
        tags: parsed.tags
          ? parsed.tags
              .split(",")
              .map((t) => t.trim().toLowerCase())
              .filter(Boolean)
          : [],
        parentId: parsed.parentId ? parseInt(parsed.parentId) : null,
        image: "",
        status: "aprobado",
        state: "open",
        issueNum: num,
        issueUrl: issue.html_url,
        createdAt: issue.created_at,
      });
    } else {
      const ev = eventsList.find((e) => e.id === num);
      if (ev) ev.status = "aprobado";
    }
    saveState();
    sessionStorage.removeItem('github_issues_cache');
    sessionStorage.removeItem('github_issues_cache_time');
    fetchPendingIssues();
  }

  function rejectIssue(num: number) {
    if (!eventsList.find((e) => e.id === num)) {
      eventsList.push({
        id: num,
        title: `Issue #${num}`,
        status: "rechazado",
      } as any);
    } else {
      const ev = eventsList.find((e) => e.id === num);
      if (ev) ev.status = "rechazado";
    }
    saveState();
    sessionStorage.removeItem('github_issues_cache');
    sessionStorage.removeItem('github_issues_cache_time');
    fetchPendingIssues();
  }

  // ──────────────────────────────────────────────
  // TABLE RENDERING & FILTERING
  // ──────────────────────────────────────────────
  function renderTable() {
    if (!eventsTableBody) return;
    eventsTableBody.innerHTML = "";

    filteredEvents = eventsList.filter((e) => {
      const isSub = e.parentId !== undefined && e.parentId !== null && e.parentId !== "";
      if (isSub) return false;

      const org = String(e.organizer || "").toLowerCase();
      const isLima = org.includes("eth lima") || org.includes("ethereum lima");
      const tagsArray = Array.isArray(e.tags) ? e.tags : (typeof e.tags === 'string' ? e.tags.split(',') : []);
      const hasTag = tagsArray.some((t: any) => String(t).trim().toLowerCase() === "ethlima");
      
      if (!isLima && !hasTag) return false;

      const query = searchQuery.toLowerCase();
      return (
        (e.title || "").toLowerCase().includes(query) ||
        (e.location || "").toLowerCase().includes(query) ||
        (e.organizer || "").toLowerCase().includes(query) ||
        String(e.id).includes(query)
      );
    });

    // Sort descending by id
    filteredEvents.sort((a, b) => b.id - a.id);

    if (filteredEvents.length === 0) {
      eventsTableBody.innerHTML = `
        <tr>
          <td colspan="7" class="p-12 text-center">
            <div class="flex flex-col items-center justify-center gap-3">
              <svg class="w-10 h-10 text-muted/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
              <span class="text-content-secondary font-mono text-xs">${t().no_events}</span>
            </div>
          </td>
        </tr>`;
      return;
    }

    filteredEvents.forEach((e) => {
      const isSub = e.parentId !== undefined && e.parentId !== null;

      const typeClasses: Record<string, string> = {
        conference: "bg-accent/10 text-accent border border-accent/25",
        workshop: "bg-success/10 text-success border border-success/25",
        hackathon: "bg-warning/10 text-warning border border-warning/25",
        meetup: "bg-purple-500/10 text-purple-400 border border-purple-500/25",
        bootcamp:
          "bg-indigo-500/10 text-indigo-400 border border-indigo-500/25",
        cohorte: "bg-pink-500/10 text-pink-400 border border-pink-500/25",
        buildathon: "bg-teal-500/10 text-teal-400 border border-teal-500/25",
        grant: "bg-yellow-500/10 text-yellow-400 border border-yellow-500/25",
      };
      const pillClass =
        typeClasses[e.type.toLowerCase()] ||
        "bg-purple-500/10 text-purple-400 border border-purple-500/25";

      const tr = document.createElement("tr");
      tr.className =
        "group hover:bg-white/[0.03] transition-all duration-300 border-b border-white/5 hover:shadow-glass";
      tr.innerHTML = `
        <td class="p-4 font-mono font-bold text-white transition-colors group-hover:text-accent-2">${e.id}</td>
        <td class="p-4">
          <div class="flex flex-col gap-0.5">
            <span class="font-bold text-content-primary text-sm leading-tight">${
              e.title
            }</span>
            ${
              isSub
                ? `<span class="text-[9px] text-accent-2 font-mono uppercase tracking-wider flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-accent-2 animate-pulse shadow-[0_0_8px_rgba(138,159,245,0.8)]"></span>${t().subevent_of}${e.parentId}</span>`
                : ""
            }
          </div>
        </td>
        <td class="p-4">
          <span class="font-mono text-[10px] px-2.5 py-0.5 rounded-full uppercase font-bold tracking-wide ${pillClass}">${
        e.type
      }</span>
        </td>
        <td class="p-4 font-mono text-content-secondary">${e.date || "TBD"}</td>
        <td class="p-4 truncate max-w-[120px] text-content-secondary">${e.location || "Online"}</td>
        <td class="p-4 font-bold text-content-primary">${
          e.organizer || "Comunidad"
        }</td>
        <td class="p-4 text-right whitespace-nowrap">
          <div class="flex items-center justify-end gap-2 opacity-70 group-hover:opacity-100 transition-opacity duration-300">
            <button class="btn-edit px-3 py-1.5 bg-surface-2 border border-white/5 hover:bg-white/10 text-content-primary rounded-lg font-mono text-[10px] font-bold transition-all shadow-sm" data-id="${
              e.id
            }">${t().btn_edit}</button>
            <button class="btn-delete px-3 py-1.5 bg-danger/10 border border-danger/25 hover:bg-danger/20 text-danger rounded-lg font-mono text-[10px] font-bold transition-all shadow-sm" data-id="${
              e.id
            }">${t().btn_delete}</button>
          </div>
        </td>
      `;

      eventsTableBody.appendChild(tr);
    });

    // Attach row events
    eventsTableBody.querySelectorAll(".btn-edit").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = parseInt(btn.getAttribute("data-id") || "0");
        openEditModal(id);
      });
    });

    eventsTableBody.querySelectorAll(".btn-approve").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = parseInt(btn.getAttribute("data-id") || "0");
        approveEvent(id);
      });
    });

    eventsTableBody.querySelectorAll(".btn-reject").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = parseInt(btn.getAttribute("data-id") || "0");
        rejectEvent(id);
      });
    });

    eventsTableBody.querySelectorAll(".btn-delete").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = parseInt(btn.getAttribute("data-id") || "0");
        if (confirm(`${t().confirm_del_event} #${id}?`)) {
          deleteEvent(id);
        }
      });
    });
  }

  // Search filter
  searchInput?.addEventListener("input", () => {
    searchQuery = searchInput.value;
    renderTable();
  });

  // ──────────────────────────────────────────────
  // CRUD CONTROLS
  // ──────────────────────────────────────────────
  // Guarda en Local Storage y también en el archivo JSON local (solo en modo dev)
  function saveToFile(filename: string, content: any) {
    fetch("/api/save-json", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ filename, content }),
    }).catch(() => {
      /* silently ignore in production */
    });
  }

  function saveState() {
    localStorage.setItem("eth_events_admin_list", JSON.stringify(eventsList));
    saveToFile("events.json", eventsList);
    renderTable();
  }

  function approveEvent(id) {
    const ev = eventsList.find((e) => e.id === id);
    if (ev) {
      ev.status = "aprobado";
      saveState();
    }
  }

  function rejectEvent(id) {
    const ev = eventsList.find((e) => e.id === id);
    if (ev) {
      ev.status = "rechazado";
      saveState();
    }
  }

  // Open modal for adding
  btnNewEvent?.addEventListener("click", () => {
    document.getElementById("modal-title")!.textContent = t().modal_new_event;
    crudForm.reset();
    inputEventId.value = "";

    if (crudModal) {
      crudModal.classList.remove("hidden");
      crudModal.classList.add("flex");
    }
  });

  // Close modal
  let _lastFocusedAdmin: HTMLElement | null = null;
  btnCloseModal?.addEventListener("click", closeModal);
  crudModal?.addEventListener("click", (e) => {
    if (e.target === crudModal) closeModal();
  });

  function closeModal() {
    if (crudModal) {
      crudModal.classList.remove("flex");
      crudModal.classList.add("hidden");
    }
    if (_lastFocusedAdmin) _lastFocusedAdmin.focus();
  }

  function openCrudModal() {
    _lastFocusedAdmin = document.activeElement as HTMLElement;
    if (crudModal) { crudModal.classList.remove("hidden"); crudModal.classList.add("flex"); }
    setTimeout(() => btnCloseModal?.focus(), 50);
  }

  // Esc closes any open admin modal
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeModal();
      closeMemberModal();
    }
  });

  // Open modal for editing
  function openEditModal(id: number) {
    const event = eventsList.find((e) => e.id === id);
    if (!event) return;

    document.getElementById("modal-title")!.textContent = `${t().modal_edit_event} #${id}`;

    // Fill values
    inputEventId.value = String(event.id);
    inputTitle.value = event.title || "";
    inputDesc.value = event.description || "";
    inputDate.value = event.date || "";
    inputEndDate.value = event.endDate || "";
    inputTime.value = event.time || "";
    inputType.value = event.type || "meetup";
    inputLocation.value = event.location || "";
    inputOrganizer.value = event.organizer || "";
    inputLink.value = event.link || "";
    if (inputVideoLink) inputVideoLink.value = event.videoLink || "";
    inputTags.value = (event.tags || []).join(", ");
    inputParentId.value = event.parentId ? String(event.parentId) : "";
    inputImage.value = event.image || "";

    if (crudModal) {
      crudModal.classList.remove("hidden");
      crudModal.classList.add("flex");
    }
  }

  // Handle Form Submit (Save / Add)
  crudForm?.addEventListener("submit", (e) => {
    e.preventDefault();

    const idStr = inputEventId.value;
    const parentIdVal = inputParentId.value.trim()
      ? parseInt(inputParentId.value)
      : null;

    const eventData: any = {
      title: inputTitle.value.trim(),
      description: inputDesc.value.trim(),
      date: inputDate.value,
      endDate: inputEndDate.value || "",
      time: inputTime.value.trim(),
      type: inputType.value,
      location: inputLocation.value.trim(),
      organizer: inputOrganizer.value.trim(),
      link: inputLink.value.trim(),
      videoLink: inputVideoLink ? inputVideoLink.value.trim() : "",
      tags: inputTags.value
        .split(",")
        .map((t) => t.trim().toLowerCase())
        .filter(Boolean),
      parentId: parentIdVal,
      image: inputImage.value.trim(),
    };

    if (idStr) {
      // Edit
      const id = parseInt(idStr);
      const index = eventsList.findIndex((e) => e.id === id);
      if (index !== -1) {
        // Keep original issue state/metadata
        eventsList[index] = {
          ...eventsList[index],
          ...eventData,
          id,
        };
      }
    } else {
      // Add new
      const nextId = eventsList.reduce((max, e) => Math.max(max, e.id), 0) + 1;
      const newEvent = {
        ...eventData,
        id: nextId,
        issueNum: nextId,
        state: "open",
        status: "pending",
        createdAt: new Date().toISOString(),
      };
      eventsList.push(newEvent);
    }

    saveState();
    closeModal();
  });

  // ──────────────────────────────────────────────
  // JSON EXPORT CONTROLS
  // ──────────────────────────────────────────────
  // Download updated events.json
  btnDownloadJson?.addEventListener("click", () => {
    const dataStr =
      "data:text/json;charset=utf-8," +
      encodeURIComponent(JSON.stringify(eventsList, null, 2));
    const dlAnchorElem = document.createElement("a");
    dlAnchorElem.setAttribute("href", dataStr);
    dlAnchorElem.setAttribute("download", "events.json");
    dlAnchorElem.click();
  });

  // Copy updated JSON to clipboard
  btnCopyJson?.addEventListener("click", () => {
    navigator.clipboard
      .writeText(JSON.stringify(eventsList, null, 2))
      .then(() => {
        alert(t().copied_ok);
      })
      .catch((err) => {
        alert(t().copy_err + err);
      });
  });

  // ──────────────────────────────────────────────
  // MEMBERS CRUD LOGIC
  // ──────────────────────────────────────────────

  function renderMembersTable() {
    if (!membersTableBody) return;
    membersTableBody.innerHTML = "";

    if (membersList.length === 0) {
      membersTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="p-8 text-center text-muted font-mono">
            ${t().no_members}
          </td>
        </tr>`;
      return;
    }

    membersList.forEach((m) => {
      const tr = document.createElement("tr");
      tr.className =
        "hover:bg-white/[0.02] transition-colors border-b border-white/5";

      const photoHtml = m.photo
        ? `<img src="${m.photo}" class="w-8 h-8 rounded-full object-cover" loading="lazy" decoding="async" />`
        : `<div class="w-8 h-8 rounded-full bg-surface-2 flex items-center justify-center text-xs font-bold text-muted">${m.name.charAt(
            0
          )}</div>`;

      const socialCount = Object.values(m.social || {}).filter((v) => v).length;

      tr.innerHTML = `
        <td class="p-4 font-mono font-bold text-white">${m.id}</td>
        <td class="p-4">${photoHtml}</td>
        <td class="p-4 font-bold text-white text-sm">
          ${m.name}
          <div class="font-mono text-[9px] text-muted mt-0.5 uppercase tracking-wider">${
            m.area || "General"
          }</div>
        </td>
        <td class="p-4"><span class="font-mono text-[9px] px-2 py-0.5 rounded-full uppercase bg-accent/10 text-accent-2 border border-accent/25">${
          m.role
        }</span></td>
        <td class="p-4 font-mono text-muted text-xs">${
          (m.events || []).length
        } ${t().events_label}</td>
        <td class="p-4 text-right whitespace-nowrap">
          <div class="flex items-center justify-end gap-2">
            <button class="btn-edit-member px-3 py-1.5 bg-accent/10 hover:bg-accent/20 text-accent-2 rounded-lg font-mono text-[10px] font-bold transition-all" data-id="${
              m.id
            }">${t().btn_edit}</button>
            <button class="btn-delete-member px-3 py-1.5 bg-danger/10 hover:bg-danger/20 text-danger rounded-lg font-mono text-[10px] font-bold transition-all" data-id="${
              m.id
            }">${t().btn_delete}</button>
          </div>
        </td>
      `;
      membersTableBody.appendChild(tr);
    });

    // Attach row events
    membersTableBody.querySelectorAll(".btn-edit-member").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = parseInt(btn.getAttribute("data-id") || "0");
        openMemberModal(id);
      });
    });

    membersTableBody.querySelectorAll(".btn-delete-member").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = parseInt(btn.getAttribute("data-id") || "0");
        if (confirm(`${t().confirm_del_member} #${id}?`)) {
          deleteMember(id);
        }
      });
    });
  }

  function saveMembersState() {
    localStorage.setItem("eth_members_admin_list", JSON.stringify(membersList));
    saveToFile("members.json", membersList);
    renderMembersTable();
  }

  function deleteMember(id: number) {
    membersList = membersList.filter((m) => m.id !== id);
    saveMembersState();
  }

  // Populate events checkboxes with roles
  function populateMemberEvents(
    memberEvents: { eventId: number; role: string }[] = []
  ) {
    if (!memberEventsContainer) return;
    memberEventsContainer.innerHTML = "";

    // Only Eth Lima parent events
    const ethLimaEvents = eventsList.filter((e) => {
      const isSub = e.parentId !== undefined && e.parentId !== null && e.parentId !== "";
      if (isSub) return false;

      const org = String(e.organizer || "").toLowerCase();
      const isLima = org.includes("eth lima") || org.includes("ethereum lima");
      const tagsArray = Array.isArray(e.tags) ? e.tags : (typeof e.tags === 'string' ? e.tags.split(',') : []);
      const hasTag = tagsArray.some((t: any) => String(t).trim().toLowerCase() === "ethlima");
      
      return isLima || hasTag;
    });

    ethLimaEvents.forEach((e) => {
      const assignment = memberEvents.find((me) => me.eventId === e.id);
      const isChecked = !!assignment;
      const currentRole = assignment ? assignment.role : "";

      const div = document.createElement("div");
      div.className =
        "flex items-center gap-3 p-2 hover:bg-white/5 rounded-lg transition-colors";
      div.innerHTML = `
        <label class="flex items-center gap-2 flex-1 cursor-pointer min-w-0">
          <input type="checkbox" name="member-event-${e.id}" value="${e.id}" ${
        isChecked ? "checked" : ""
      } class="event-checkbox mt-0.5 accent-accent flex-shrink-0" />
          <span class="text-xs text-white leading-tight truncate">
            <span class="font-mono text-muted text-[10px] mr-1">#${e.id}</span>
            ${e.title || t().no_title}
          </span>
        </label>
        <select class="event-role-select bg-black/40 border border-white/5 rounded-lg px-2 py-1 text-[10px] text-white focus:border-accent outline-none w-32 flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" ${
          isChecked ? "" : "disabled"
        }>
          <option value="Lead del Proyecto" ${
            currentRole === "Lead del Proyecto" ? "selected" : ""
          }>Lead del Proyecto</option>
          <option value="Core Team" ${
            currentRole === "Core Team" ? "selected" : ""
          }>Core Team</option>
          <option value="Coordinador de Tecnología" ${
            currentRole === "Coordinador de Tecnología" ? "selected" : ""
          }>Coord. Tecnología</option>
          <option value="Coordinador de Logística" ${
            currentRole === "Coordinador de Logística" ? "selected" : ""
          }>Coord. Logística</option>
          <option value="Coordinador de Alianzas" ${
            currentRole === "Coordinador de Alianzas" ? "selected" : ""
          }>Coord. Alianzas</option>
          <option value="Coordinadora de Comunicaciones" ${
            currentRole === "Coordinadora de Comunicaciones" ? "selected" : ""
          }>Coord. Comunicaciones</option>
          <option value="Voluntario" ${
            currentRole === "Voluntario" || !currentRole ? "selected" : ""
          }>Voluntario</option>
        </select>
      `;

      const checkbox = div.querySelector(".event-checkbox") as HTMLInputElement;
      const select = div.querySelector(
        ".event-role-select"
      ) as HTMLSelectElement;

      checkbox.addEventListener("change", () => {
        select.disabled = !checkbox.checked;
      });

      memberEventsContainer.appendChild(div);
    });
  }

  // Open modal for adding/editing member
  btnNewMember?.addEventListener("click", () => {
    document.getElementById("member-modal-title")!.textContent = t().modal_new_member;
    memberCrudForm.reset();
    (document.getElementById("member-id") as HTMLInputElement).value = "";
    populateMemberEvents([]);

    if (memberCrudModal) {
      memberCrudModal.classList.remove("hidden");
      memberCrudModal.classList.add("flex");
    }
  });

  function closeMemberModal() {
    if (memberCrudModal) {
      memberCrudModal.classList.remove("flex");
      memberCrudModal.classList.add("hidden");
    }
  }

  btnCloseMemberModal?.addEventListener("click", closeMemberModal);
  memberCrudModal?.addEventListener("click", (e) => {
    if (e.target === memberCrudModal) closeMemberModal();
  });

  function openMemberModal(id: number) {
    const member = membersList.find((m) => m.id === id);
    if (!member) return;

    document.getElementById("member-modal-title")!.textContent = `${t().modal_edit_member} #${id}`;

    (document.getElementById("member-id") as HTMLInputElement).value = String(
      member.id
    );
    (document.getElementById("member-name") as HTMLInputElement).value =
      member.name || "";
    (document.getElementById("member-role") as HTMLSelectElement).value =
      member.role || "Voluntario";
    (document.getElementById("member-area") as HTMLSelectElement).value =
      member.area || "General";
    (document.getElementById("member-photo") as HTMLInputElement).value =
      member.photo || "";
    (document.getElementById("member-x") as HTMLInputElement).value =
      member.social?.x || "";
    (document.getElementById("member-instagram") as HTMLInputElement).value =
      member.social?.instagram || "";
    (document.getElementById("member-linkedin") as HTMLInputElement).value =
      member.social?.linkedin || "";

    populateMemberEvents(member.events || []);

    if (memberCrudModal) {
      memberCrudModal.classList.remove("hidden");
      memberCrudModal.classList.add("flex");
    }
  }

  memberCrudForm?.addEventListener("submit", (e) => {
    e.preventDefault();

    const idStr = (document.getElementById("member-id") as HTMLInputElement)
      .value;

    // Get checked events and their assigned roles
    const eventRows = memberEventsContainer?.querySelectorAll(
      "div.flex.items-center.gap-3"
    );
    const events: { eventId: number; role: string }[] = [];

    eventRows?.forEach((row) => {
      const cb = row.querySelector(".event-checkbox") as HTMLInputElement;
      const sel = row.querySelector(".event-role-select") as HTMLSelectElement;
      if (cb && cb.checked) {
        events.push({
          eventId: parseInt(cb.value),
          role: sel.value,
        });
      }
    });

    const memberData = {
      name: (
        document.getElementById("member-name") as HTMLInputElement
      ).value.trim(),
      role: (document.getElementById("member-role") as HTMLSelectElement).value,
      area: (document.getElementById("member-area") as HTMLSelectElement).value,
      photo: (
        document.getElementById("member-photo") as HTMLInputElement
      ).value.trim(),
      social: {
        x: (
          document.getElementById("member-x") as HTMLInputElement
        ).value.trim(),
        instagram: (
          document.getElementById("member-instagram") as HTMLInputElement
        ).value.trim(),
        linkedin: (
          document.getElementById("member-linkedin") as HTMLInputElement
        ).value.trim(),
      },
      events,
    };

    if (idStr) {
      const id = parseInt(idStr);
      const index = membersList.findIndex((m) => m.id === id);
      if (index !== -1) {
        membersList[index] = { ...membersList[index], ...memberData };
      }
    } else {
      const nextId =
        membersList.length > 0
          ? Math.max(...membersList.map((m) => m.id)) + 1
          : 1;
      membersList.push({ id: nextId, ...memberData });
    }

    saveMembersState();
    closeMemberModal();
  });

  // Download members.json
  document
    .getElementById("btn-download-members-json")
    ?.addEventListener("click", () => {
      const dataStr =
        "data:text/json;charset=utf-8," +
        encodeURIComponent(JSON.stringify(membersList, null, 2));
      const dlAnchorElem = document.createElement("a");
      dlAnchorElem.setAttribute("href", dataStr);
      dlAnchorElem.setAttribute("download", "members.json");
      dlAnchorElem.click();
    });
</script>
