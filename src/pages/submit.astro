---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Toast from '../components/ui/Toast.astro';
---

<Layout title="Proponer Evento — ETH Events" description="Comparte tu evento Web3 / Ethereum con la comunidad. Completa el formulario para enviarlo a revisión de los maintainers.">
  <Header />

  <style>
    .select-dark option {
      background-color: #0f1117;
      color: #fff;
    }
    .select-dark option:disabled {
      color: #6b7280;
    }
  </style>
  <main class="w-full max-w-4xl mx-auto px-6 py-12 flex-1 flex flex-col items-center justify-center relative z-10">
    
    <div class="w-full max-w-2xl bg-surface border border-white/5 rounded-3xl p-6 md:p-12 backdrop-blur-xl shadow-2xl relative overflow-hidden my-6">
      
      <!-- PREVIEW OVERLAY -->
      <div class="absolute inset-0 bg-[#030407]/95 hidden flex-col items-center justify-center p-6 z-[60] animate-modal-fade backdrop-blur-xl" id="preview-overlay">
        <div class="w-full h-full overflow-y-auto px-2 py-4 pb-12" style="scrollbar-width: none;">
          <h2 class="text-2xl font-extrabold text-white mb-6 text-center" data-i18n="sub_preview_title">Vista Previa de tu Evento</h2>
          
          <div class="bg-surface-2 border border-white/10 rounded-2xl p-6 mb-8 text-left shadow-2xl">
            <h3 class="text-xl font-bold text-white mb-3" id="preview-nombre">Nombre del Evento</h3>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-accent/20 text-accent border border-accent/30 rounded-md text-xs font-mono uppercase" id="preview-tipo">tipo</span>
              <span class="px-2 py-1 bg-white/5 text-muted rounded-md text-xs font-mono" id="preview-fecha">fecha</span>
              <span class="px-2 py-1 bg-white/5 text-muted rounded-md text-xs font-mono" id="preview-hora">hora</span>
            </div>
            <p class="text-white/80 text-sm mb-6 whitespace-pre-wrap leading-relaxed" id="preview-descripcion">Descripción</p>
            
            <div class="space-y-3 text-sm text-muted bg-black/20 p-4 rounded-xl border border-white/5">
              <div class="flex items-start gap-3">
                <span class="text-white shrink-0 w-24">📍 Ubicación:</span>
                <span id="preview-ubicacion" class="text-white/70">Ubicación</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-white shrink-0 w-24">👤 Org:</span>
                <span id="preview-organizador" class="text-white/70">Organizador</span>
              </div>
              <div class="flex items-start gap-3" id="preview-link-container">
                <span class="text-white shrink-0 w-24">🔗 Link:</span>
                <a id="preview-link" href="#" target="_blank" class="text-accent hover:text-accent-2 hover:underline break-all transition-colors">Link</a>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-white shrink-0 w-24">🏷️ Tags:</span>
                <span id="preview-tags" class="text-white/70">Tags</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button type="button" id="btn-cancel-preview" class="px-8 py-3 bg-surface border border-white/10 hover:bg-surface-2 hover:border-white/20 text-white font-mono text-sm font-bold rounded-xl transition-all" data-i18n="sub_preview_edit">
              EDITAR DATOS
            </button>
            <button type="button" id="btn-confirm-submit" class="px-8 py-3 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-xl shadow-[0_10px_30px_rgba(98,126,234,0.3)] hover:shadow-[0_15px_40px_rgba(98,126,234,0.4)] hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
              <span data-i18n="sub_preview_confirm">CONFIRMAR Y ENVIAR</span>
            </button>
          </div>
        </div>
      </div>

      <!-- SUCCESS OVERLAY -->
      <div class="absolute inset-0 bg-[#030407] hidden flex-col items-center justify-center text-center p-8 z-50 animate-modal-fade" id="success-overlay">
        <div class="w-20 h-20 bg-success/10 border border-success rounded-full flex items-center justify-center text-success mb-6 shadow-[0_0_30px_rgba(16,185,129,0.2)]">
          <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h2 class="text-3xl font-extrabold text-white mb-3" data-i18n="sub_success_title">¡Propuesta Recibida!</h2>
        <p class="text-muted text-sm leading-relaxed max-w-md mb-8" id="success-description">
          Tu evento ha sido enviado correctamente. Un maintainer lo revisará pronto para su publicación.
        </p>
        <a href="/" class="px-8 py-3 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-xl shadow-lg transition-all text-center" data-i18n="sub_back_home">
          VOLVER AL INICIO
        </a>
      </div>

      <!-- FORM CONTENT -->
      <div id="form-content" class="transition-opacity duration-300">
        <div class="text-center mb-10">
          <h1 class="text-3xl font-extrabold text-white mb-3" data-i18n="sub_title">Propón tu Evento</h1>
          <p class="text-muted text-sm leading-relaxed max-w-lg mx-auto" data-i18n="sub_desc">
            Completa los detalles para que la comunidad pueda descubrir tu evento. Será revisado por los maintainers.
          </p>
        </div>

        <form id="event-form" class="space-y-6">
          
          <!-- INFO BÁSICA -->
          <div class="relative group">
            <input
              type="text"
              id="nombre"
              name="nombre"
              placeholder=" "
              required
              class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
            />
            <label for="nombre" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_name">
              📌 Nombre del Evento *
            </label>
            <div class="validation-icon absolute right-4 top-4 hidden text-success">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
          </div>

          <div class="relative group">
            <textarea
              id="descripcion"
              name="descripcion"
              placeholder=" "
              required
              class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none min-h-[100px] resize-y transition-all peer"
            ></textarea>
            <label for="descripcion" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_desc">
              📝 Descripción *
            </label>
            <div class="validation-icon absolute right-4 top-4 hidden text-success">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
          </div>

          <!-- FECHAS -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative group">
              <input
                type="date"
                id="fecha"
                name="fecha"
                placeholder=" "
                required
                class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
              />
              <label for="fecha" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_date">
                🗓️ Fecha de Inicio *
              </label>
            </div>
            <div class="relative group">
              <input
                type="date"
                id="fecha-fin"
                name="fecha-fin"
                placeholder=" "
                class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
              />
              <label for="fecha-fin" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_end">
                🗓️ Fecha de Fin (opcional)
              </label>
            </div>
          </div>

          <!-- TIME AND TYPE -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative group">
              <input
                type="text"
                id="hora"
                name="hora"
                placeholder=" "
                class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
              />
              <label for="hora" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_time">
                ⏰ Hora
              </label>
            </div>
            <div class="relative group">
              <select
                id="tipo"
                name="tipo"
                required
                class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer appearance-none select-dark"
              >
                <option value="" disabled selected></option>
                <option value="meetup">Meetup</option>
                <option value="conference">Conference</option>
                <option value="workshop">Workshop</option>
                <option value="hackathon">Hackathon</option>
                <option value="bootcamp">Bootcamp</option>
                <option value="buildathon">Buildathon</option>
                <option value="cohorte">Cohorte</option>
                <option value="grant">Grant</option>
              </select>
              <label for="tipo" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_type">
                🏷️ Tipo de evento *
              </label>
              <div class="absolute right-3 bottom-3.5 pointer-events-none text-muted">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </div>
            </div>
          </div>

          <!-- UBICACIÓN Y LINK -->
          <div class="relative group">
            <input
              type="text"
              id="ubicacion"
              name="ubicacion"
              placeholder=" "
              required
              class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
            />
            <label for="ubicacion" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_location">
              📍 Ubicación *
            </label>
            <div class="validation-icon absolute right-4 top-4 hidden text-success">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
          </div>

          <div class="relative group">
            <input
              type="url"
              id="link"
              name="link"
              placeholder=" "
              class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
            />
            <label for="link" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_link">
              🔗 Link de registro / más info
            </label>
          </div>

          <!-- METADATA -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative group">
              <input
                type="text"
                id="organizador"
                name="organizador"
                placeholder=" "
                class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
              />
              <label for="organizador" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_org">
                👤 Organizador
              </label>
            </div>
            <div class="relative group">
              <input
                type="text"
                id="tags"
                name="tags"
                placeholder=" "
                class="block w-full bg-surface-2 border border-white/10 rounded-xl px-4 pb-2.5 pt-6 text-white focus:border-accent focus:bg-accent/5 focus:ring-1 focus:ring-accent outline-none transition-all peer"
              />
              <label for="tags" class="absolute text-muted duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-accent" data-i18n="sub_label_tags">
                🏷️ Tags (ethereum, solidity)
              </label>
            </div>
          </div>

          <!-- CONFIRMACIONES -->
          <div class="pt-6 border-t border-white/5 space-y-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="confirm-real" required class="w-4 h-4 rounded border-white/10 bg-surface-2 text-accent focus:ring-accent accent-accent mt-0.5" />
              <span class="text-xs text-muted leading-relaxed select-none" data-i18n="sub_conf1">El evento es real y tiene fecha confirmada.</span>
            </label>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="confirm-web3" required class="w-4 h-4 rounded border-white/10 bg-surface-2 text-accent focus:ring-accent accent-accent mt-0.5" />
              <span class="text-xs text-muted leading-relaxed select-none" data-i18n="sub_conf2">El evento está relacionado con Web3 / Ethereum / Blockchain.</span>
            </label>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="confirm-edit" required class="w-4 h-4 rounded border-white/10 bg-surface-2 text-accent focus:ring-accent accent-accent mt-0.5" />
              <span class="text-xs text-muted leading-relaxed select-none" data-i18n="sub_conf3">Acepto que los maintainers pueden editar o rechazar el evento.</span>
            </label>
          </div>

          <!-- SUBMIT BUTTON -->
          <button
            type="submit"
            class="btn-submit w-full py-4 bg-accent hover:bg-accent-2 text-white font-mono text-sm font-bold rounded-xl shadow-[0_10px_30px_rgba(98,126,234,0.3)] hover:shadow-[0_15px_40px_rgba(98,126,234,0.4)] hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
            <span data-i18n="sub_submit">ENVIAR PROPUESTA</span>
          </button>
        </form>
      </div>

    </div>

  </main>
  <Toast />
</Layout>

<script>
  const form = document.getElementById('event-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('.btn-submit') as HTMLButtonElement;
  const btnText = submitBtn?.innerHTML || '';

  // Realtime validation visual feedback
  const inputs = form?.querySelectorAll('input[required], textarea[required]');
  inputs?.forEach(input => {
    input.addEventListener('input', () => {
      const icon = input.parentElement?.querySelector('.validation-icon') as HTMLElement;
      if (icon) {
        if ((input as HTMLInputElement).checkValidity()) {
          icon.classList.remove('hidden');
        } else {
          icon.classList.add('hidden');
        }
      }
    });
  });

  let currentFormData: FormData | null = null;
  const previewOverlay = document.getElementById('preview-overlay');
  const btnCancelPreview = document.getElementById('btn-cancel-preview');
  const btnConfirmSubmit = document.getElementById('btn-confirm-submit');
  const btnConfirmText = btnConfirmSubmit?.innerHTML || '';

  form?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    currentFormData = new FormData(form);
    
    // Populate preview
    const val = (name: string) => currentFormData?.get(name)?.toString() || '-';
    
    document.getElementById('preview-nombre')!.textContent = val('nombre');
    document.getElementById('preview-tipo')!.textContent = val('tipo');
    
    let dates = val('fecha');
    if (currentFormData?.get('fecha-fin')) {
      dates += ` al ${val('fecha-fin')}`;
    }
    document.getElementById('preview-fecha')!.textContent = dates;
    
    document.getElementById('preview-hora')!.textContent = val('hora') || 'TBD';
    document.getElementById('preview-descripcion')!.textContent = val('descripcion');
    document.getElementById('preview-ubicacion')!.textContent = val('ubicacion');
    document.getElementById('preview-organizador')!.textContent = val('organizador') || 'N/A';
    document.getElementById('preview-tags')!.textContent = val('tags') || 'N/A';
    
    const linkEl = document.getElementById('preview-link') as HTMLAnchorElement;
    const linkVal = val('link');
    if (linkVal && linkVal !== '-') {
      linkEl.href = linkVal;
      linkEl.textContent = linkVal;
      document.getElementById('preview-link-container')!.style.display = 'flex';
    } else {
      document.getElementById('preview-link-container')!.style.display = 'none';
    }

    if (previewOverlay) {
      previewOverlay.style.display = 'flex';
    }
  });

  btnCancelPreview?.addEventListener('click', () => {
    if (previewOverlay) {
      previewOverlay.style.display = 'none';
    }
  });

  btnConfirmSubmit?.addEventListener('click', async () => {
    if (!currentFormData) return;

    // Loading state
    if (btnConfirmSubmit) {
      (btnConfirmSubmit as HTMLButtonElement).disabled = true;
      btnConfirmSubmit.innerHTML = `<svg class="w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span data-i18n="sub_submitting">${TRANSLATIONS[currentLang]?.sub_submitting || 'ENVIANDO...'}</span>`;
    }
    
    const data = Object.fromEntries(currentFormData.entries());

    try {
      const response = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok) {
        if (previewOverlay) {
          previewOverlay.style.display = 'none';
        }

        // Success Overlay
        const overlay = document.getElementById('success-overlay');
        const content = document.getElementById('form-content');
        const desc = document.getElementById('success-description');

        if (content) {
          content.style.opacity = '0';
          content.style.pointerEvents = 'none';
        }
        if (overlay) {
          overlay.style.display = 'flex';
        }
        if (desc) {
          desc.innerHTML = `Tu evento ha sido enviado correctamente. Un maintainer lo revisará pronto para su publicación.<br><br><a href="${result.url}" target="_blank" class="text-accent hover:text-accent-2 transition-colors font-mono text-xs font-bold underline">Ver seguimiento en GitHub #${result.number}</a>`;
        }
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        throw new Error(result.error || 'Error al enviar');
      }
    } catch (error: any) {
      if ((window as any).showToast) {
        (window as any).showToast('Error: ' + error.message, 'error', 6000);
      }
      if (btnConfirmSubmit) {
        (btnConfirmSubmit as HTMLButtonElement).disabled = false;
        btnConfirmSubmit.innerHTML = btnConfirmText;
      }
    }
  });
  // I18N DICTIONARY
  const TRANSLATIONS: Record<string, Record<string, string>> = {
    es: {
      sub_success_title: "¡Propuesta Recibida!",
      sub_back_home: "VOLVER AL INICIO",
      sub_title: "Propón tu Evento",
      sub_desc: "Completa los detalles para que la comunidad pueda descubrir tu evento. Será revisado por los maintainers.",
      sub_label_name: "📌 Nombre del Evento *",
      sub_label_desc: "📝 Descripción *",
      sub_label_date: "🗓️ Fecha de Inicio *",
      sub_label_end: "🗓️ Fecha de Fin (opcional)",
      sub_label_time: "⏰ Hora",
      sub_label_type: "🏷️ Tipo de evento *",
      sub_label_location: "📍 Ubicación *",
      sub_label_link: "🔗 Link de registro / más info",
      sub_label_org: "👤 Organizador",
      sub_label_tags: "🏷️ Tags",
      sub_conf1: "El evento es real y tiene fecha confirmada.",
      sub_conf2: "El evento está relacionado con Web3 / Ethereum / Blockchain.",
      sub_conf3: "Acepto que los maintainers pueden editar o rechazar el evento.",
      sub_submit: "ENVIAR PROPUESTA",
      sub_submitting: "ENVIANDO...",
      sub_preview_title: "Vista Previa de tu Evento",
      sub_preview_edit: "EDITAR DATOS",
      sub_preview_confirm: "CONFIRMAR Y ENVIAR"
    },
    en: {
      sub_success_title: "Proposal Received!",
      sub_back_home: "BACK TO HOME",
      sub_title: "Propose your Event",
      sub_desc: "Fill in the details so the community can discover your event. It will be reviewed by the maintainers.",
      sub_label_name: "📌 Event Name *",
      sub_label_desc: "📝 Description *",
      sub_label_date: "🗓️ Start Date *",
      sub_label_end: "🗓️ End Date (optional)",
      sub_label_time: "⏰ Time",
      sub_label_type: "🏷️ Event Type *",
      sub_label_location: "📍 Location *",
      sub_label_link: "🔗 Registration Link / More Info",
      sub_label_org: "👤 Organizer",
      sub_label_tags: "🏷️ Tags",
      sub_conf1: "The event is real and the date is confirmed.",
      sub_conf2: "The event is related to Web3 / Ethereum / Blockchain.",
      sub_conf3: "I agree that maintainers can edit or reject the event.",
      sub_submit: "SUBMIT PROPOSAL",
      sub_submitting: "SUBMITTING...",
      sub_preview_title: "Event Preview",
      sub_preview_edit: "EDIT DETAILS",
      sub_preview_confirm: "CONFIRM AND SUBMIT"
    }
  };

  let currentLang = localStorage.getItem('eth_events_lang') || 'es';

  function applyI18n() {
    const t = TRANSLATIONS[currentLang];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && t[key]) {
        el.innerHTML = t[key];
      }
    });
  }

  // Escuchar cambios de idioma del header
  window.addEventListener('storage', (e) => {
    if (e.key === 'eth_events_lang') {
      currentLang = e.newValue || 'es';
      applyI18n();
    }
  });

  applyI18n();
</script>
