# ─────────────────────────────────────────────────────────────
# ETH Lima — Variables de Entorno (copia este archivo a .env)
# ─────────────────────────────────────────────────────────────

# Admin Dashboard: credenciales para HTTP Basic Auth (server-side)
# Estas variables NUNCA se exponen al navegador del usuario.
ADMIN_USER=admin
ADMIN_PASS=tu_contraseña_segura

# GitHub Personal Access Token (para la API de issues en dev y para /api/submit en producción)
# Permisos mínimos necesarios: repo → public_repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
